# The USB audio gadget: the device the host sees. A oneshot that builds the
# configfs gadget and binds it to the USB device controller, and takes it
# down again at stop. Restarting it makes the device disappear and reappear
# on the host.
#
# For the from-scratch installer. The development unit's own
# usb-16x16.service (99c87e86, read off it on 2026-11-13 and kept as
# history/installers/gadget/usb-16x16.service) names the protected 48 kHz
# script and is redirected to this one by the drop-in
# usb-16x16.service.d/10-usb-aoip.conf. This unit is that one with the script
# named directly, so it needs no drop-in: the same type, ordering and install
# target.
[Unit]
Description=USB-AoIP USB audio gadget (UAC2, 16 in / 16 out)
After=local-fs.target systemd-modules-load.service sys-kernel-config.mount

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/setup-usb-aoip start
ExecStop=/usr/local/sbin/setup-usb-aoip stop

[Install]
WantedBy=multi-user.target
