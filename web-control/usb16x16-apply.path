[Unit]
# See usb16x16-apply.service: no burst limit for the request stream.
StartLimitIntervalSec=0
Description=USB 16x16 web Apply request watcher
Documentation=file:///home/bdimaio/usb-16x16-work/web-control/README.md

[Path]
# The web service renames <id>.request into the inbox, a root-owned directory
# it can create files in and cannot list. PathChanged on the directory fires
# on that rename; the applier takes every request it finds there.
PathChanged=/var/spool/usb-aoip/inbox
Unit=usb16x16-apply.service
MakeDirectory=no

[Install]
WantedBy=multi-user.target
