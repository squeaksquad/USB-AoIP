AUTH_PAGE = """<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>USB-AoIP: {title}</title>
<style>body{{font:16px/1.5 system-ui,sans-serif;max-width:34em;margin:3em auto;padding:0 16px;color:#1d2424;background:#f6f7f6}}
h1{{font-size:1.3em}}code{{background:#e4e8e6;padding:1px 4px;border-radius:3px}}
@media (prefers-color-scheme: dark){{body{{color:#e4ece9;background:#141a1a}}code{{background:#26302f}}}}</style>
</head><body><h1>{title}</h1><p>{what}</p>
<p>Logins are created on the device itself: <code>sudo install/install.sh set-password NAME</code>
in the USB-AoIP checkout, which adds a login or changes its password.</p></body></html>
"""


class Handler(BaseHTTPRequestHandler):
    server_version = f"usb16x16-web/{VERSION}"
    protocol_version = "HTTP/1.1"
    # StreamRequestHandler applies this to the connection socket: a client
    # that sends nothing for this long is closed rather than holding a thread.
    timeout = HANDLER_TIMEOUT_SECONDS

    collector: Collector
    presets: PresetStore
    auth: Authenticator | None = None
    tls: bool = False

    # ---- plumbing

    def setup(self) -> None:
        """With TLS the listening socket does not handshake on accept (a
        stalled client would block every other one there); the handshake
        happens here, in this connection's own thread, under the timeout.
        A failed handshake is a closed connection, not a traceback."""
        self.handshake_failed = False
        if isinstance(self.request, ssl.SSLSocket):
            try:
                self.request.settimeout(self.timeout)
                self.request.do_handshake()
            except (ssl.SSLError, OSError):
                self.handshake_failed = True
        super().setup()

    def handle(self) -> None:
        if self.handshake_failed:
            self.close_connection = True
            return
        super().handle()

    def finish(self) -> None:
        try:
            super().finish()
        except OSError:
            pass

    def end_headers(self) -> None:
        for name, value in SECURITY_HEADERS:
            self.send_header(name, value)
        if self.tls:
            self.send_header("Strict-Transport-Security", HSTS)
        super().end_headers()

    def log_message(self, fmt: str, *args) -> None:  # quieter journal
        if self.command != "GET" or not self.path.startswith("/api/health"):
            sys.stderr.write("%s - %s\n" % (self.address_string(), fmt % args))

    def send_json(self, payload, status: int = 200) -> None:
        body = json.dumps(payload).encode("utf-8")
        self.send_response(status)
        self.send_header("Content-Type", "application/json; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        if self.command != "HEAD":
            self.wfile.write(body)

    def send_error_json(self, status: int, message: str) -> None:
        self.send_json({"ok": False, "error": message}, status)

    def discard_body(self) -> None:
        """Drain an unread request body before rejecting the request.

        Under HTTP/1.1 keep-alive, answering a PUT without reading its body
        leaves that body in the connection, and the server then parses it as the
        next request line. A rejected write would poison the following request
        on the same connection. Anything larger than the preset cap is not worth
        draining, so close instead.
        """
        try:
            length = int(self.headers.get("Content-Length") or 0)
        except ValueError:
            self.close_connection = True
            return
        if length <= 0:
            return
        if length > (1 << 20):
            self.close_connection = True
            return
        try:
            self.rfile.read(length)
        except OSError:
            self.close_connection = True

    def wants_html(self) -> bool:
        """A person in a browser (a navigation asks for text/html), not the
        page's own fetches, which ask for JSON."""
        return "text/html" in (self.headers.get("Accept") or "").lower()

    def auth_body(self, message: str, title: str, what: str) -> tuple[bytes, str]:
        if self.wants_html():
            return (AUTH_PAGE.format(title=title, what=what).encode("utf-8"), "text/html; charset=utf-8")
        return json.dumps({"ok": False, "error": message}).encode(), "application/json; charset=utf-8"

    def send_auth_challenge(self, message: str = "Authentication required") -> None:
        self.discard_body()
        if message == "Authentication required":
            title, what = ("Sign-in needed",
                           "This page needs a user name and password. Reload the page to be asked for them.")
        else:
            title, what = ("Wrong user name or password",
                           "The user name or password was not accepted. Reload the page to try again.")
        body, kind = self.auth_body(message, title, what)
        self.send_response(HTTPStatus.UNAUTHORIZED)
        self.send_header("WWW-Authenticate", f'Basic realm="{REALM}", charset="UTF-8"')
        self.send_header("Content-Type", kind)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        if self.command != "HEAD":
            self.wfile.write(body)

    def authorize(self) -> bool:
        """Gate every route. Returns False having already answered the client.

        Order matters. A request with no Authorization header is the Basic auth
        handshake, not a failed sign-in: every browser makes one per session, so
        counting it would let normal use throttle itself. And the free cache is
        consulted before the limiter, so someone flooding wrong passwords from
        an address cannot lock out a user already signed in from it.
        """
        if self.auth is None:
            return True
        header = self.headers.get("Authorization")
        if not header or not header.startswith("Basic "):
            self.send_auth_challenge()
            return False
        if self.auth.cached(header):
            return True
        client = self.client_address[0] if self.client_address else "?"
        if self.auth.throttled(client):
            self.discard_body()
            body, kind = self.auth_body("Too many failed sign-ins from this address; wait a minute",
                                        "Too many attempts",
                                        "Too many wrong passwords came from this computer. "
                                        "Wait a minute, then reload the page to try again.")
            self.send_response(HTTPStatus.TOO_MANY_REQUESTS)
            self.send_header("Content-Type", kind)
            self.send_header("Retry-After", str(int(FAIL_WINDOW_SECONDS)))
            self.send_header("Content-Length", str(len(body)))
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            if self.command != "HEAD":
                self.wfile.write(body)
            return False
        if self.auth.verify(header):
            self.auth.clear_failures(client)
            return True
        self.auth.note_failure(client)
        sys.stderr.write(f"{client} - authentication failed for {self.command} {self.path}\n")
        self.send_auth_challenge("Wrong user name or password")
        return False

    def cross_site_refusal(self) -> str | None:
        """Why a state-changing request may have come from another site, or
        None. A cross-site page can make a signed-in browser send a POST, but
        it cannot add a custom header or a JSON content type without a CORS
        preflight, which this service never grants, and a browser that sends
        Origin cannot forge it. Non-browser clients send no Origin."""
        if (self.headers.get(CSRF_HEADER) or "").strip() != "1":
            return f"missing the {CSRF_HEADER}: 1 header that state-changing requests must carry"
        try:
            length = int(self.headers.get("Content-Length") or 0)
        except ValueError:
            length = 1
        if length > 0 or self.headers.get("Transfer-Encoding"):
            kind = (self.headers.get("Content-Type") or "").strip().lower()
            if not kind.startswith("application/json"):
                return "a request body must be sent as Content-Type: application/json"
        origin = self.headers.get("Origin")
        if origin is not None:
            origin_host = urlparse(origin.strip()).netloc.lower() if "://" in origin else ""
            host = (self.headers.get("Host") or "").strip().lower()
            if not origin_host or origin_host != host:
                return "the request's Origin does not match the address it was sent to"
        return None

    def gate_change(self) -> bool:
        """Auth, then the cross-site checks, for every state-changing method.
        Returns False having already answered the client."""
        if not self.authorize():
            return False
        refusal = self.cross_site_refusal()
        if refusal:
            self.discard_body()
            self.send_error_json(HTTPStatus.FORBIDDEN, f"Refused: {refusal}")
            return False
        return True

    def read_body(self, limit: int = 1 << 20):
        try:
            length = int(self.headers.get("Content-Length") or 0)
        except ValueError:
            return None
        if length <= 0 or length > limit:
            return None
        try:
            return json.loads(self.rfile.read(length).decode("utf-8"))
        except (ValueError, OSError):
            return None

    # ---- routes

    def do_GET(self) -> None:
        if not self.authorize():
            return
        parsed = urlparse(self.path)
        route = unquote(parsed.path)
        query = parse_qs(parsed.query)
        if route == "/api/health":
            self.send_json(self.collector.snapshot())
        elif route == "/api/meters":
            # Fresh on every request, parsed once per file version: the page
            # polls this at up to 10 Hz and the file is two kilobytes on tmpfs.
            self.send_json(read_meters())
        elif route == "/api/apply/status":
            # Read fresh rather than from the 1 Hz snapshot: the page polls
            # this while an operation runs and it is one small file.
            self.send_json({"ok": True, **apply_state()})
        elif route == "/api/logs":
            self.api_logs(query)
        elif route == "/api/presets":
            self.send_json({"ok": True, "store": "pi", "presets": self.presets.list()})
        elif route.startswith("/api/presets/"):
            name = route[len("/api/presets/"):]
            document = self.presets.read(name)
            if document is None:
                self.send_error_json(HTTPStatus.NOT_FOUND, "No such preset")
            else:
                self.send_json({"ok": True, "preset": document})
        elif route.startswith("/api/"):
            self.send_error_json(HTTPStatus.NOT_FOUND, "No such endpoint")
        else:
            self.serve_static(route)

    do_HEAD = do_GET

    def do_OPTIONS(self) -> None:
        """No CORS: a preflight gets a refusal and no Access-Control-* headers,
        so no other origin is ever allowed the header or content type the
        state-changing methods require."""
        self.discard_body()
        self.send_response(HTTPStatus.METHOD_NOT_ALLOWED)
        self.send_header("Allow", "GET, HEAD, POST, PUT, DELETE")
        self.send_header("Content-Length", "0")
        self.send_header("Cache-Control", "no-store")
        self.end_headers()

    def do_PUT(self) -> None:
        if not self.gate_change():
            return
        route = unquote(urlparse(self.path).path)
        if not route.startswith("/api/presets/"):
            self.unsupported(route)
            return
        name = route[len("/api/presets/"):]
        document = self.read_body()
        if not isinstance(document, dict):
            # read_body returns None without consuming an oversized or unparsable
            # body, so the connection cannot be trusted for a further request.
            self.close_connection = True
            self.send_error_json(HTTPStatus.BAD_REQUEST, "Send the preset as a JSON object")
            return
        try:
            self.presets.write(name, document)
        except (ValueError, OSError) as error:
            self.send_error_json(HTTPStatus.BAD_REQUEST, str(error))
            return
        self.send_json({"ok": True, "name": name, "store": "pi"})

    def do_DELETE(self) -> None:
        if not self.gate_change():
            return
        route = unquote(urlparse(self.path).path)
        if route.startswith("/api/apply/preset/"):
            self.discard_body()
            self.api_remove_preset(route[len("/api/apply/preset/"):])
            return
        if not route.startswith("/api/presets/"):
            self.unsupported(route)
            return
        name = route[len("/api/presets/"):]
        if not self.presets.delete(name):
            self.send_error_json(HTTPStatus.NOT_FOUND, "No such preset")
            return
        self.send_json({"ok": True, "name": name})

    def do_POST(self) -> None:
        if not self.gate_change():
            return
        route = unquote(urlparse(self.path).path)
        if route == "/api/apply/profile":
            self.api_apply_profile()
        elif route == "/api/apply/preset":
            self.api_apply_preset()
        elif route == "/api/apply/live":
            self.api_apply_live()
        elif route == "/api/apply/commit":
            self.api_apply_commit()
        elif route == "/api/apply/shutdown":
            self.api_apply_shutdown()
        else:
            self.unsupported(route)

    def apply_gate(self, expected):
        """The checks every Apply request shares. Returns (snapshot, live) or
        None after answering."""
        snapshot = self.collector.snapshot()
        control = (snapshot.get("control") or {}).get("apply") or {}
        if not control.get("available"):
            self.send_error_json(HTTPStatus.SERVICE_UNAVAILABLE,
                                 control.get("reason") or "Apply is not available on this Pi")
            return None
        live = (snapshot.get("profile") or {}).get("selected")
        if expected is not None and expected != live:
            self.send_error_json(HTTPStatus.CONFLICT,
                                 f"This page expected {expected} to be live but {live} is; reload and retry")
            return None
        current = apply_state()
        if current["pending"] or current["inFlight"]:
            self.send_error_json(HTTPStatus.CONFLICT, "An Apply operation is already in progress")
            return None
        return snapshot, live

    def api_apply_preset(self) -> None:
        """Queue a browser-compiled preset for installation and a switch to it.

        The body carries the preset's name, the artifact text the page
        compiled, and its SHA-256. This process checks shape and size and the
        user-preset cap from its snapshot; the applier recomputes the hash,
        parses the artifact with the loader's bounds, loads it through the
        bridge's own code and writes the block. Nothing here is trusted by it.
        """
        body = self.read_body(limit=(1 + len(OTHER_RATES)) * PRESET_ARTIFACT_MAX + 65536)
        if not isinstance(body, dict):
            self.send_error_json(HTTPStatus.BAD_REQUEST, "Expected a JSON object")
            return
        rate_artifacts = rate_artifacts_from(body, OTHER_RATES)
        if isinstance(rate_artifacts, str):
            self.send_error_json(HTTPStatus.BAD_REQUEST, rate_artifacts)
            return
        name = body.get("name")
        artifact = body.get("artifact")
        digest = body.get("artifactSha256")
        expected = body.get("expectedProfile")
        if not isinstance(name, str) or not re.match(r"^[A-Za-z0-9][A-Za-z0-9 ._·-]{0,63}$", name):
            self.send_error_json(HTTPStatus.BAD_REQUEST, "name must be 1-64 letters, digits, spaces, dots or dashes")
            return
        if not isinstance(artifact, str) or not artifact.startswith("usb16x16-dsp 1\n") or not artifact.endswith("end\n"):
            self.send_error_json(HTTPStatus.BAD_REQUEST, "artifact must be the compiler's bridge artifact text")
            return
        data = artifact.encode("utf-8")
        if len(data) > PRESET_ARTIFACT_MAX:
            self.send_error_json(HTTPStatus.BAD_REQUEST, f"artifact is larger than {PRESET_ARTIFACT_MAX} bytes")
            return
        computed = hashlib.sha256(data).hexdigest()
        if digest is not None and digest != computed:
            self.send_error_json(HTTPStatus.BAD_REQUEST, "artifactSha256 does not match the artifact")
            return
        if expected is not None and not isinstance(expected, str):
            self.send_error_json(HTTPStatus.BAD_REQUEST, "expectedProfile must be a string or null")
            return
        slug = preset_slug(name)
        if not slug:
            self.send_error_json(HTTPStatus.BAD_REQUEST, "the name leaves no letters or digits for a slug")
            return
        gate = self.apply_gate(expected)
        if gate is None:
            return
        snapshot, _ = gate
        users = [row["name"] for row in (snapshot.get("profile") or {}).get("profiles", []) if row.get("user")]
        target = preset_prefix() + slug
        if target not in users and len(users) >= USER_PRESET_CAP:
            self.send_error_json(HTTPStatus.CONFLICT, f"{USER_PRESET_CAP} user presets are installed; remove one first")
            return
        try:
            ident = write_apply_request(target, expected, self.current_user(),
                                        extra={"kind": "preset", "name": name, "slug": slug, "artifactSha256": computed},
                                        artifact=data, rate_artifacts=rate_artifacts)
        except OSError as error:
            self.send_error_json(HTTPStatus.SERVICE_UNAVAILABLE, f"Could not queue the request: {error}")
            return
        self.send_json({"ok": True, "id": ident, "profile": target, "slug": slug, "artifactSha256": computed,
                        "replacing": target in users,
                        "note": f"Queued. The applier checks the artifact, installs it, and restarts the "
                                f"{words()['service']} on it; {words()['outage']}."}, HTTPStatus.ACCEPTED)

    def live_gate(self, expected, expected_sha):
        """The live and commit kinds share the preset gate plus: the live
        profile must be a user preset whose block passes the bridge a live
        file, and the page must agree on what the bridge last applied."""
        if expected is not None and not isinstance(expected, str):
            self.send_error_json(HTTPStatus.BAD_REQUEST, "expectedProfile must be a string or null")
            return None
        if expected_sha is not None and (not isinstance(expected_sha, str) or not re.match(r"^[0-9a-f]{64}$", expected_sha)):
            self.send_error_json(HTTPStatus.BAD_REQUEST, "expectedLiveSha256 must be 64 hex characters or null")
            return None
        gate = self.apply_gate(expected)
        if gate is None:
            return None
        snapshot, live = gate
        table = {row["name"]: row for row in (snapshot.get("profile") or {}).get("profiles", [])}
        row = table.get(live or "")
        if row is None or not row.get("user"):
            self.send_error_json(HTTPStatus.CONFLICT,
                                 f"{live or 'no profile'} is live; live updates need one of your presets running"
                                 if stack() == "dante" else
                                 f"{live or 'no profile'} is live; live updates apply only to a user preset, "
                                 "never to an accepted profile")
            return None
        if not row.get("dspLive"):
            self.send_error_json(HTTPStatus.CONFLICT,
                                 f"{live} was installed before live updates existed; Compile & apply it again")
            return None
        status = read_live_status()
        if expected_sha is not None and expected_sha != (status.get("sha256") or ""):
            self.send_error_json(HTTPStatus.CONFLICT,
                                 f"This page expected live coefficients {expected_sha[:12]} but the {words()['engine']} "
                                 f"reports {(status.get('sha256') or 'none')[:12]}; reload and retry")
            return None
        return snapshot, live, status

    def api_apply_live(self) -> None:
        """Queue a same-shape coefficient update for the running user preset.

        No restart: the applier checks the artifact the way it checks a
        preset, requires its shape key to match the installed file, writes it
        to the bridge's live file and waits for the bridge's answer. It is
        not installed; a restart returns to the installed preset unless the
        page commits it.
        """
        body = self.read_body(limit=PRESET_ARTIFACT_MAX + 65536)
        if not isinstance(body, dict):
            self.send_error_json(HTTPStatus.BAD_REQUEST, "Expected a JSON object")
            return
        if body.get("revert") is True:
            # Discard the preview: the applier pushes the installed file back.
            gate = self.live_gate(body.get("expectedProfile"), body.get("expectedLiveSha256"))
            if gate is None:
                return
            _, live, _ = gate
            try:
                ident = write_apply_request(live, body.get("expectedProfile"), self.current_user(),
                                            extra={"kind": "live", "revert": True,
                                                   "expectedLiveSha256": body.get("expectedLiveSha256")})
            except OSError as error:
                self.send_error_json(HTTPStatus.SERVICE_UNAVAILABLE, f"Could not queue the request: {error}")
                return
            self.send_json({"ok": True, "id": ident, "profile": live, "revert": True,
                            "note": f"Queued. The applier hands the installed preset back to the {words()['engine']}; no restart."},
                           HTTPStatus.ACCEPTED)
            return
        artifact = body.get("artifact")
        digest = body.get("artifactSha256")
        if not isinstance(artifact, str) or not artifact.startswith("usb16x16-dsp 1\n") or not artifact.endswith("end\n"):
            self.send_error_json(HTTPStatus.BAD_REQUEST, "artifact must be the compiler's bridge artifact text")
            return
        data = artifact.encode("utf-8")
        if len(data) > PRESET_ARTIFACT_MAX:
            self.send_error_json(HTTPStatus.BAD_REQUEST, f"artifact is larger than {PRESET_ARTIFACT_MAX} bytes")
            return
        computed = hashlib.sha256(data).hexdigest()
        if digest is not None and digest != computed:
            self.send_error_json(HTTPStatus.BAD_REQUEST, "artifactSha256 does not match the artifact")
            return
        gate = self.live_gate(body.get("expectedProfile"), body.get("expectedLiveSha256"))
        if gate is None:
            return
        _, live, _ = gate
        try:
            ident = write_apply_request(live, body.get("expectedProfile"), self.current_user(),
                                        extra={"kind": "live", "artifactSha256": computed,
                                               "expectedLiveSha256": body.get("expectedLiveSha256")},
                                        artifact=data)
        except OSError as error:
            self.send_error_json(HTTPStatus.SERVICE_UNAVAILABLE, f"Could not queue the request: {error}")
            return
        self.send_json({"ok": True, "id": ident, "profile": live, "artifactSha256": computed,
                        "note": "Queued. The applier checks the artifact against the running preset's shape "
                                f"and hands it to the {words()['engine']}; no restart. Not kept across a restart until committed."},
                       HTTPStatus.ACCEPTED)

    def api_apply_commit(self) -> None:
        """Make the coefficients the bridge is running the installed preset;
        no restart, since the running numbers already equal the file."""
        # The same draft compiled at the other rates may ride along (step 4d):
        # the applier writes those and removes the rates it is not sent.
        body = self.read_body(limit=len(DANTE_RATE_KEYS) * PRESET_ARTIFACT_MAX + 65536)
        if not isinstance(body, dict):
            self.send_error_json(HTTPStatus.BAD_REQUEST, "Expected a JSON object")
            return
        rate_artifacts = rate_artifacts_from(body, DANTE_RATE_KEYS)
        if isinstance(rate_artifacts, str):
            self.send_error_json(HTTPStatus.BAD_REQUEST, rate_artifacts)
            return
        gate = self.live_gate(body.get("expectedProfile"), body.get("expectedLiveSha256"))
        if gate is None:
            return
        _, live, status = gate
        if status.get("state") != "applied":
            self.send_error_json(HTTPStatus.CONFLICT,
                                 f"Nothing to commit: the {words()['engine']}'s last live answer is {status.get('state') or 'none'}")
            return
        try:
            ident = write_apply_request(live, body.get("expectedProfile"), self.current_user(),
                                        extra={"kind": "commit", "expectedLiveSha256": body.get("expectedLiveSha256")},
                                        rate_artifacts=rate_artifacts)
        except OSError as error:
            self.send_error_json(HTTPStatus.SERVICE_UNAVAILABLE, f"Could not queue the request: {error}")
            return
        self.send_json({"ok": True, "id": ident, "profile": live, "sha256": status.get("sha256"),
                        "note": "Queued. The applier copies the live coefficients over the installed preset "
                                "and re-pins it; no restart."}, HTTPStatus.ACCEPTED)

    def api_remove_preset(self, slug: str) -> None:
        if not USER_SLUG.match(slug):
            self.send_error_json(HTTPStatus.BAD_REQUEST, "not a user preset slug")
            return
        gate = self.apply_gate(None)
        if gate is None:
            return
        snapshot, live = gate
        users = [row["name"] for row in (snapshot.get("profile") or {}).get("profiles", []) if row.get("user")]
        target = preset_prefix() + slug
        if target not in users:
            self.send_error_json(HTTPStatus.NOT_FOUND, f"{target} is not installed")
            return
        if live == target:
            self.send_error_json(HTTPStatus.CONFLICT, f"{target} is the live profile; switch away first")
            return
        try:
            ident = write_apply_request(target, None, self.current_user(), extra={"kind": "remove", "slug": slug})
        except OSError as error:
            self.send_error_json(HTTPStatus.SERVICE_UNAVAILABLE, f"Could not queue the request: {error}")
            return
        self.send_json({"ok": True, "id": ident, "slug": slug, "note": "Queued for removal; no restart."}, HTTPStatus.ACCEPTED)

    def api_apply_profile(self) -> None:
        """Queue one profile switch for the privileged applier.

        Everything the applier will check again is checked here first so the
        browser gets a reason now rather than a refused receipt later; the
        applier's checks are the ones that count.
        """
        body = self.read_body(limit=4096)
        if not isinstance(body, dict):
            self.send_error_json(HTTPStatus.BAD_REQUEST, "Expected a JSON object")
            return
        profile = body.get("profile")
        expected = body.get("expectedProfile")
        if not isinstance(profile, str) or not re.match(r"^[a-z0-9][a-z0-9-]{0,63}$", profile):
            self.send_error_json(HTTPStatus.BAD_REQUEST, "profile must be a lower-case profile name")
            return
        if expected is not None and not isinstance(expected, str):
            self.send_error_json(HTTPStatus.BAD_REQUEST, "expectedProfile must be a string or null")
            return
        snapshot = self.collector.snapshot()
        control = (snapshot.get("control") or {}).get("apply") or {}
        if not control.get("available"):
            self.send_error_json(HTTPStatus.SERVICE_UNAVAILABLE,
                                 control.get("reason") or "Apply is not available on this Pi")
            return
        live = (snapshot.get("profile") or {}).get("selected")
        table = {row["name"]: row for row in (snapshot.get("profile") or {}).get("profiles", [])}
        if profile not in table:
            self.send_error_json(HTTPStatus.BAD_REQUEST, f"No profile named {profile}")
            return
        # On the Dante stack an installed preset is something to switch to;
        # the applier holds it to its guards again before it does.
        if not table[profile]["accepted"] and not (stack() == "dante" and table[profile].get("user")):
            self.send_error_json(HTTPStatus.BAD_REQUEST,
                                 f"{profile} is {table[profile]['status'] or 'unmarked'}, not accepted; "
                                 "Apply switches between accepted profiles only")
            return
        if expected is not None and expected != live:
            self.send_error_json(HTTPStatus.CONFLICT,
                                 f"This page expected {expected} to be live but {live} is; reload and retry")
            return
        if profile == live:
            self.send_error_json(HTTPStatus.CONFLICT, f"{profile} is already the live profile")
            return
        current = apply_state()
        if current["pending"] or current["inFlight"]:
            self.send_error_json(HTTPStatus.CONFLICT, "An Apply operation is already in progress")
            return
        try:
            ident = write_apply_request(profile, expected, self.current_user())
        except OSError as error:
            self.send_error_json(HTTPStatus.SERVICE_UNAVAILABLE, f"Could not queue the request: {error}")
            return
        self.send_json({"ok": True, "id": ident, "profile": profile, "expectedProfile": expected,
                        "note": f"Queued. The {words()['service']} restarts; {words()['outage']}."},
                       HTTPStatus.ACCEPTED)

    def api_apply_shutdown(self) -> None:
        """Queue a power-off of the Pi for the privileged applier.

        The body must say so twice ({"confirm": "shutdown"}) so a stray POST
        cannot do it; the browser asks the operator before sending. The
        applier stops the AES67 service in order, writes its receipt, and
        then asks systemd to power off; this service goes down with it.
        """
        body = self.read_body(limit=4096)
        if not isinstance(body, dict):
            self.send_error_json(HTTPStatus.BAD_REQUEST, "Expected a JSON object")
            return
        if body.get("confirm") != "shutdown":
            self.send_error_json(HTTPStatus.BAD_REQUEST, 'confirm must be "shutdown"')
            return
        expected = body.get("expectedProfile")
        if expected is not None and not isinstance(expected, str):
            self.send_error_json(HTTPStatus.BAD_REQUEST, "expectedProfile must be a string or null")
            return
        gate = self.apply_gate(expected)
        if gate is None:
            return
        _, live = gate
        try:
            ident = write_apply_request(live or "none", expected, self.current_user(), extra={"kind": "shutdown"})
        except OSError as error:
            self.send_error_json(HTTPStatus.SERVICE_UNAVAILABLE, f"Could not queue the request: {error}")
            return
        self.send_json({"ok": True, "id": ident, "profile": live,
                        "note": f"Queued. The {words()['service']} stops, then the Pi powers off; this page loses its "
                                "connection. Once activity stops, unplug the USB data cable, then PoE."},
                       HTTPStatus.ACCEPTED)

    def current_user(self) -> str | None:
        header = self.headers.get("Authorization") or ""
        if not header.startswith("Basic "):
            return None
        try:
            decoded = base64.b64decode(header[6:].strip(), validate=True).decode("utf-8")
        except (ValueError, UnicodeDecodeError):
            return None
        return decoded.partition(":")[0] or None

    def unsupported(self, route: str) -> None:
        self.discard_body()
        """Every device-changing route answers the same way, on purpose.

        Restarting a service or installing DSP means owning a PCM device and
        interrupting audio. That belongs to the privileged applier, which
        takes only the request kinds under POST /api/apply/* (a profile
        switch, a user preset, a live update, a commit, a power-off);
        nothing else here changes device state.
        """
        if route.startswith("/api/service") or route.startswith("/api/apply") \
                or route.startswith("/api/dsp"):
            self.send_error_json(
                HTTPStatus.NOT_IMPLEMENTED,
                "This service is read-only apart from the POST /api/apply/* requests "
                "(a profile switch, a user preset, a live update, a commit, a power-off). "
                "Service restarts are not implemented; run the commands on the Pi instead.",
            )
        else:
            self.send_error_json(HTTPStatus.METHOD_NOT_ALLOWED, "Method not allowed")

    def api_logs(self, query: dict) -> None:
        service = (query.get("service") or ["all"])[0]
        table = DANTE_LOG_UNITS if stack() == "dante" else LOG_UNITS
        if service == "aes67" and stack() == "dante":
            service = "stack"   # an older page asking for "the network service"
        if service not in table:
            self.send_error_json(HTTPStatus.BAD_REQUEST, "Choose a known log service")
            return
        try:
            lines = int((query.get("lines") or ["200"])[0])
        except ValueError:
            lines = 200
        lines = max(1, min(lines, 2000))
        argv = ["journalctl", "--no-pager", "-o", "short-iso", "-n", str(lines)]
        for unit in table[service]:
            argv += ["-u", unit]
        output = run(argv, timeout=15.0)
        if output is None:
            self.send_error_json(HTTPStatus.SERVICE_UNAVAILABLE,
                                 "journalctl is not answering on this host")
            return
        self.send_json({"ok": True, "service": service, "lines": lines, "text": output})

    def serve_static(self, route: str) -> None:
        root = self.collector.static_dir
        relative = route.lstrip("/") or "index.html"
        # The compiler modules under compiler/ import the UI's shared modules
        # as ../web-ui/<file> (their path in the repo, where work/dsp-compiler
        # sits beside work/web-ui); in the browser that is /web-ui/<file>, so
        # that prefix is the static root itself.
        if relative.startswith("web-ui/"):
            relative = relative[len("web-ui/"):]
        target = (root / relative).resolve()
        try:
            target.relative_to(root.resolve())
        except ValueError:
            self.send_error_json(HTTPStatus.FORBIDDEN, "Outside the served directory")
            return
        if target.is_dir():
            target = target / "index.html"
        if not target.is_file():
            self.send_error_json(HTTPStatus.NOT_FOUND, "Not found")
            return
        try:
            body = target.read_bytes()
        except OSError:
            self.send_error_json(HTTPStatus.INTERNAL_SERVER_ERROR, "Could not read file")
            return
        self.send_response(HTTPStatus.OK)
        self.send_header("Content-Type", MIME.get(target.suffix, "application/octet-stream"))
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-cache")
        self.end_headers()
        if self.command != "HEAD":
            self.wfile.write(body)


