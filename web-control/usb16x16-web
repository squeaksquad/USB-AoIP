class PasswordFile:
    """Users and PBKDF2 hashes, one per line.

        name:pbkdf2_sha256$<iterations>$<salt b64>$<hash b64>

    The password itself is never stored, never passed on the command line and
    never logged. The file is written 0600.
    """

    def __init__(self, path: Path) -> None:
        self.path = path

    @staticmethod
    def hash_password(password: str, iterations: int = KDF_ITERATIONS,
                      salt: bytes | None = None) -> str:
        salt = salt or secrets.token_bytes(16)
        digest = hashlib.pbkdf2_hmac("sha256", password.encode("utf-8"), salt, iterations)
        return "pbkdf2_sha256${}${}${}".format(
            iterations,
            base64.b64encode(salt).decode("ascii"),
            base64.b64encode(digest).decode("ascii"))

    @staticmethod
    def verify_password(password: str, stored: str) -> bool:
        try:
            scheme, iterations, salt, digest = stored.split("$")
            if scheme != "pbkdf2_sha256":
                return False
            candidate = hashlib.pbkdf2_hmac(
                "sha256", password.encode("utf-8"),
                base64.b64decode(salt), int(iterations))
        except (ValueError, TypeError):
            return False
        return hmac.compare_digest(candidate, base64.b64decode(digest))

    def load(self) -> dict[str, str]:
        users: dict[str, str] = {}
        text = read_text(self.path, 1 << 20)
        if text is None:
            return users
        for line in text.splitlines():
            line = line.strip()
            if not line or line.startswith("#") or ":" not in line:
                continue
            name, _, stored = line.partition(":")
            if USER_NAME.match(name):
                users[name] = stored
        return users

    def set_user(self, name: str, password: str) -> None:
        if not USER_NAME.match(name):
            raise ValueError("User names use letters, digits, dot, dash or underscore")
        if len(password) < 8:
            raise ValueError("Use a password of at least 8 characters")
        users = self.load()
        users[name] = self.hash_password(password)
        self.path.parent.mkdir(parents=True, exist_ok=True)
        temporary = self.path.with_suffix(".tmp")
        # 0600 before any content is written, so the hashes are never briefly
        # world-readable between creation and chmod.
        handle = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(handle, "w", encoding="utf-8") as out:
            out.write("# usb16x16-web credentials. Generated; do not edit by hand.\n")
            for user, stored in sorted(users.items()):
                out.write(f"{user}:{stored}\n")
            out.flush()
            os.fsync(out.fileno())
        os.replace(temporary, self.path)

    def remove_user(self, name: str) -> bool:
        users = self.load()
        if name not in users:
            return False
        del users[name]
        if not users:
            raise ValueError("Refusing to remove the last user; the service would "
                             "not start. Add another user first, or pass --no-auth.")
        # Rewrite through set_user's path by re-hashing nothing: write directly.
        temporary = self.path.with_suffix(".tmp")
        handle = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(handle, "w", encoding="utf-8") as out:
            out.write("# usb16x16-web credentials. Generated; do not edit by hand.\n")
            for user, stored in sorted(users.items()):
                out.write(f"{user}:{stored}\n")
            out.flush()
            os.fsync(out.fileno())
        os.replace(temporary, self.path)
        return True


class Authenticator:
    """Basic auth with a bounded success cache and per-client failure limit.

    The KDF is the point of a password hash, but the UI polls /api/health every
    two seconds. Paying 90 ms of PBKDF2 per poll would put a steady load on the
    machine running the audio, so a credential that has just verified is
    remembered for AUTH_CACHE_SECONDS by the SHA-256 of its header. The cache
    only ever skips work for a credential that already passed; a wrong password
    is never cached and always pays full price.
    """

    def __init__(self, password_file: PasswordFile) -> None:
        self.password_file = password_file
        self._lock = threading.Lock()
        self._verified: dict[bytes, float] = {}
        self._failures: dict[str, list[float]] = {}

    def reload(self) -> dict[str, str]:
        users = self.password_file.load()
        with self._lock:
            # Credentials change meaning when the file does: drop the cache.
            self._verified.clear()
        return users

    def throttled(self, client: str) -> bool:
        now = time.monotonic()
        with self._lock:
            recent = [t for t in self._failures.get(client, []) if now - t < FAIL_WINDOW_SECONDS]
            self._failures[client] = recent
            return len(recent) >= FAIL_LIMIT

    def clear_failures(self, client: str) -> None:
        """A correct password forgives earlier typos from that client."""
        with self._lock:
            self._failures.pop(client, None)

    def note_failure(self, client: str) -> None:
        now = time.monotonic()
        with self._lock:
            self._failures.setdefault(client, []).append(now)
            if len(self._failures) > 1024:  # bounded under a spoofed-source flood
                self._failures = {
                    key: [t for t in times if now - t < FAIL_WINDOW_SECONDS]
                    for key, times in self._failures.items()}
                self._failures = {k: v for k, v in self._failures.items() if v}

    @staticmethod
    def _token(header: str) -> bytes:
        return hashlib.sha256(header.encode("utf-8", "replace")).digest()

    def cached(self, header: str | None) -> bool:
        """Free check against credentials that already verified.

        Deliberately consulted before the failure limiter, so a flood of wrong
        passwords from one address cannot lock out someone who is already
        signed in from it.
        """
        if not header or not header.startswith("Basic "):
            return False
        token = self._token(header)
        now = time.monotonic()
        with self._lock:
            expiry = self._verified.get(token)
            if expiry is None:
                return False
            if expiry > now:
                return True
            del self._verified[token]
            return False

    def verify(self, header: str) -> bool:
        """Full check. Costs one KDF; only reached on a cache miss."""
        token = self._token(header)
        now = time.monotonic()
        try:
            decoded = base64.b64decode(header[6:].strip(), validate=True).decode("utf-8")  # noqa: E501
            name, _, password = decoded.partition(":")
        except (ValueError, UnicodeDecodeError):
            return False
        stored = self.password_file.load().get(name)
        # Hash even an unknown user, so a wrong name and a wrong password take
        # the same time and the reply does not say which was wrong.
        if stored is None:
            PasswordFile.hash_password(password)
            return False
        if not PasswordFile.verify_password(password, stored):
            return False
        with self._lock:
            if len(self._verified) >= AUTH_CACHE_MAX:
                self._verified = {k: v for k, v in self._verified.items() if v > now}
                if len(self._verified) >= AUTH_CACHE_MAX:
                    self._verified.clear()
            self._verified[token] = now + AUTH_CACHE_SECONDS
        return True


