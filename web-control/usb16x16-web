# ------------------------------------------------------------------ helpers

def read_text(path: Path, limit: int = 65536) -> str | None:
    try:
        with open(path, "r", encoding="utf-8", errors="replace") as handle:
            return handle.read(limit)
    except OSError:
        return None


def run(argv: list[str], timeout: float = 4.0) -> str | None:
    """Run a fixed argv with no shell. Returns stdout, or None on any failure."""
    try:
        done = subprocess.run(
            argv, capture_output=True, text=True, timeout=timeout, check=False
        )
    except (OSError, subprocess.SubprocessError):
        return None
    return done.stdout


def http_json(path: str, timeout: float = 3.0):
    try:
        with urllib.request.urlopen(DAEMON_API + path, timeout=timeout) as response:
            return json.loads(response.read(1 << 20).decode("utf-8", "replace"))
    except (urllib.error.URLError, OSError, ValueError, json.JSONDecodeError):
        return None


def as_number(text: str):
    try:
        value = float(text)
    except (TypeError, ValueError):
        return None
    return int(value) if value.is_integer() else value


def parse_bridge_line(line: str) -> dict:
    """Split one BRIDGE telemetry line into its key=value fields."""
    fields: dict = {}
    for token in line.split():
        if "=" not in token:
            continue
        key, _, value = token.partition("=")
        number = as_number(value)
        fields[key] = value if number is None else number
    return fields


