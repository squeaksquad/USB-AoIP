def parse_meters(text: str) -> dict | None:
    """Parse the bridge's meter snapshot file: a METERS header line and one
    TAP line per stage, key=value with comma-separated per-channel lists."""
    lines = [line for line in text.splitlines() if line.strip()]
    if not lines or not lines[0].startswith("METERS "):
        return None
    header = parse_bridge_line(lines[0])
    taps: dict = {}
    for line in lines[1:]:
        if not line.startswith("TAP "):
            continue
        fields: dict = {}
        for token in line.split()[1:]:
            key, _, value = token.partition("=")
            fields[key] = value
        stage = fields.get("stage")
        if not stage:
            continue
        try:
            peaks = [float(v) for v in fields.get("peak_dbfs", "").split(",")]
            rms = [float(v) for v in fields.get("rms_dbfs", "").split(",")]
            clipped = [int(v) for v in fields.get("clip", "").split(",")]
            if not (len(peaks) == len(rms) == len(clipped) == 16):
                continue
            taps[stage] = {
                "stage": stage,
                "where": METER_STAGES.get(stage, ""),
                "sequence": int(fields.get("seq", 0)),
                "frames": int(fields.get("frames", 0)),
                "position": int(fields.get("position", 0)),
                "peakDb": peaks,
                "rmsDb": rms,
                "clipped": clipped,
            }
        except ValueError:
            continue
    if not taps:
        return None
    return {
        "version": header.get("v"),
        "bridgeTimeUs": header.get("t_us"),
        "windowFrames": header.get("window_frames"),
        "writes": header.get("writes"),
        "taps": taps,
    }


_meters_cache: dict = {"mtime": None, "body": None}
_meters_lock = threading.Lock()


def read_meters(now: float | None = None) -> dict:
    """The latest meter snapshot, parsed once per file version. A missing or
    stale file (the bridge stopped, or runs untapped) reads as unavailable;
    the reason says which."""
    now = time.time() if now is None else now
    dante = stack() == "dante"
    meters_file = DANTE_RUN_DIR / "meters.txt" if dante else METERS_FILE
    engine = words()["engine"]
    try:
        stat = meters_file.stat()
    except OSError:
        return {"ok": True, "available": False,
                "reason": f"No meter snapshot: the {engine} is not running or runs with METERS=0."}
    age = now - stat.st_mtime
    with _meters_lock:
        if _meters_cache["mtime"] != stat.st_mtime:
            parsed = parse_meters(read_text(meters_file, 16384) or "")
            _meters_cache["mtime"] = stat.st_mtime
            _meters_cache["body"] = parsed
        body = _meters_cache["body"]
    if body is None:
        return {"ok": True, "available": False, "reason": "The meter snapshot could not be parsed."}
    if age > METERS_FRESH_S:
        return {"ok": True, "available": False, "ageSeconds": round(age, 1),
                "reason": f"The meter snapshot is {age:.0f} s old: the {engine} has stopped publishing, "
                          "or no audio is moving through it." if dante else
                          f"The meter snapshot is {age:.0f} s old: the bridge has stopped publishing."}
    return {"ok": True, "available": True, "ageSeconds": round(age, 2),
            "source": "owner-tap" if dante else "bridge-tap",
            "windowMs": round((body.get("windowFrames") or 0) / 48.0, 1), **body}


def parse_conf(text: str) -> dict[str, str]:
    """KEY=value lines of aes67.conf, quotes stripped; the same subset
    usb16x16-apply reads. Comments and blank lines are skipped."""
    values: dict[str, str] = {}
    for raw in text.splitlines():
        line = raw.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, _, value = line.partition("=")
        value = value.strip()
        if len(value) >= 2 and value[0] == value[-1] == '"':
            value = value[1:-1]
        values[key.strip()] = value
    return values


def conf_profiles(conf: dict[str, str]) -> list[dict]:
    """Every profile block with the fields the UI shows, accepted first."""
    rows = []
    for key in conf:
        match = re.match(r"^PROFILE_([A-Z0-9_]+)_TARGET$", key)
        if not match:
            continue
        upper = match.group(1)
        field = lambda suffix, u=upper: conf.get(f"PROFILE_{u}_{suffix}", "")
        rows.append({
            "name": upper.lower().replace("_", "-"),
            "status": field("STATUS"),
            "accepted": field("STATUS") == "accepted",
            "description": field("DESCRIPTION"),
            "measured": field("MEASURED"),
            "cover": field("COVER"),
            "dspPreset": field("DSP_PRESET") or None,
            # A user preset is what usb16x16-apply installed: named user-<slug>,
            # STATUS=experimental in the supervisor's vocabulary.
            "user": upper.startswith("USER_") and field("STATUS") == "experimental",
            # The block passes the bridge a live file (LIVE_COEFFICIENTS_DESIGN.md).
            "dspLive": field("DSP_LIVE") == "1",
            "dspSha256": field("DSP_SHA256") or None,
            # The installed file's shape key, user presets only (the live base).
            "dspShape": installed_shape(field("DSP_PRESET")) if upper.startswith("USER_") and field("DSP_PRESET") else None,
        })
    rows.sort(key=lambda row: (not row["accepted"], not row["user"], row["name"]))
    return rows


def parse_iso(text) -> float | None:
    try:
        return float(calendar.timegm(time.strptime(text, "%Y-%m-%dT%H:%M:%SZ")))
    except (TypeError, ValueError):
        return None


def interface_address(name: str) -> str | None:
    """The IPv4 address of an interface, read without extra dependencies."""
    output = run(["ip", "-o", "-4", "addr", "show", "dev", name])
    if not output:
        return None
    match = re.search(r"\binet\s+([0-9.]+)/", output)
    return match.group(1) if match else None


# ---------------------------------------------------------------- the Dante stack

def parse_owner_conf(text: str) -> dict[str, str]:
    """owner.conf as usb16x16-dante-start reads it: KEY=value lines."""
    values: dict[str, str] = {}
    for raw in text.splitlines():
        match = re.match(r"^([A-Z0-9_]+)=(.*)$", raw)
        if match:
            values[match.group(1)] = match.group(2)
    return values


def artifact_title(path: Path) -> str:
    """The name on an artifact's `preset` line, for the list."""
    head = read_text(path, 512) or ""
    for line in head.splitlines()[:3]:
        if line.startswith("preset "):
            return line[len("preset "):].strip()[:64]
    return ""


def dante_profiles(conf: dict[str, str]) -> tuple[str, list[dict]]:
    """What the Dante applier switches between: direct, and every installed
    dante-<slug>.dsp. The same row shape as conf_profiles, so the page's
    panel is one panel."""
    preset = conf.get("DSP_PRESET") or ""
    # At a rate other than 48 kHz the running file is dante-<slug>@<rate>.dsp.
    selected = re.sub(r"@\d+$", "", Path(preset).name.removesuffix(".dsp")) if preset else DANTE_DIRECT
    rows = [{
        "name": DANTE_DIRECT, "status": "accepted", "accepted": True,
        "description": "Direct: no DSP stage, samples pass through unchanged",
        "measured": "", "cover": "", "dspPreset": None, "user": False, "dspLive": False,
        "dspSha256": None, "dspShape": None,
    }]
    try:
        files = sorted(DSP_DIR.glob(f"{DANTE_PREFIX}*.dsp"))
    except OSError:
        files = []
    for path in files:
        slug = path.name[len(DANTE_PREFIX):-len(".dsp")]
        if not USER_SLUG.match(slug):
            continue
        name = DANTE_PREFIX + slug
        live = name == selected
        title = artifact_title(path)
        rows.append({
            "name": name, "status": "preset", "accepted": False,
            "description": f"user preset: {title}" if title else "user preset",
            "measured": "", "cover": "", "dspPreset": str(path), "user": True,
            # A preset always starts with live following on; for the running
            # one, what the configuration actually says.
            "dspLive": conf.get("DSP_LIVE") == "1" if live else True,
            # The rates this preset has an artifact for (SAMPLE_RATE_DESIGN.md, step 4d).
            "rates": [rate for rate in (44100, 48000, 88200, 96000, 176400, 192000)
                      if (path if rate == 48000 else path.with_name(f"{name}@{rate}.dsp")).is_file()],
            "dspSha256": conf.get("DSP_SHA256") if live else None,
            # The running preset's shape is its running file's: off 48 kHz that is
            # the @<rate> artifact, whose shape names its rate.
            "dspShape": installed_shape(preset if live and preset else str(path)),
        })
    return selected, rows


def parse_owner_lines(text: str, now: float | None = None) -> dict:
    """The newest OWNER, USB, DSP and METER lines of the owner's journal
    (journalctl -o short-unix): what the endpoint last said about itself."""
    now = time.time() if now is None else now
    latest: dict = {}
    for raw in text.splitlines():
        match = re.match(r"^([0-9]+\.[0-9]+) \S+ \S+: (OWNER|USB|DSP|METER) (.*)$", raw)
        if match:
            latest[match.group(2)] = (float(match.group(1)), parse_bridge_line(match.group(3)))
    if "OWNER" not in latest:
        return {"present": False}
    stamp, owner = latest["OWNER"]
    usb = latest.get("USB", (0, {}))[1]
    dsp = latest.get("DSP", (0, {}))
    meter = latest.get("METER", (0, {}))
    # A DSP or METER line older than the OWNER line belongs to an earlier
    # minute in which audio moved; it says nothing about now.
    dsp_fields = dsp[1] if dsp[0] >= stamp - 1 else {}
    meter_fields = meter[1] if meter[0] >= stamp - 1 else {}
    return {
        "present": True,
        "ageSeconds": round(now - stamp, 1),
        "uptimeSeconds": owner.get("t"),
        "loopGapUsMax": owner.get("gap_us_max"),
        "txDepth": owner.get("tx_depth"),
        "txResyncs": owner.get("tx_resyncs"),
        "rxResyncs": owner.get("rx_resyncs"),
        "netErrors": owner.get("net_errors"),
        "usb": usb.get("usb"), "usbOut": usb.get("tx"), "usbBack": usb.get("rx"),
        "txMean": usb.get("tx_mean"), "rxMean": usb.get("rx_mean"),
        "ppmOut": usb.get("tx_i"), "ppmBack": usb.get("rx_i"),
        "txLinks": usb.get("tx_links"), "txReprimes": usb.get("tx_reprimes"),
        "rxOverflow": usb.get("rx_overflow"),
        "captureFaults": usb.get("capture_faults"), "playbackFaults": usb.get("playback_faults"),
        "detaches": usb.get("detaches"),
        "dspUsMax": dsp_fields.get("dsp_us_max"), "dspUsMean": dsp_fields.get("dsp_us_mean"),
        "dspLiveGen": dsp_fields.get("dsp_live_gen"), "dspLiveRefused": dsp_fields.get("dsp_live_refused"),
        "meterUsMax": meter_fields.get("meter_us_max"),
    }


def parse_device_name(text: str | None) -> str:
    """The Dante device name: the first uncommented NAME "..." line of the
    Inferno ALSA config, else the default."""
    for raw in (text or "").splitlines():
        match = re.match(r'^\s*NAME\s+"([^"\n]{1,63})"', raw)
        if match and match.group(1).isprintable():
            return match.group(1)
    return DEFAULT_DEVICE_NAME


def parse_startcheck(text: str | None) -> dict:
    """usb16x16-dante-startcheck's status line:
    state=ok rate=6005 restarts=0 invocation=<hex> time=2026-11-01T12:00:00Z.
    Anything missing or unrecognised reads as unknown."""
    unknown = {"state": "unknown", "rate": None, "restarts": None, "time": None}
    lines = (text or "").strip().splitlines()
    if len(lines) != 1:
        return unknown
    fields = dict(token.partition("=")[::2] for token in lines[0].split() if "=" in token)
    if fields.get("state") not in STARTCHECK_STATES:
        return unknown
    as_int = lambda value: int(value) if value and value.isdigit() else None
    stamp = fields.get("time")
    return {"state": fields["state"], "rate": as_int(fields.get("rate")),
            "restarts": as_int(fields.get("restarts")),
            "time": stamp if parse_iso(stamp) is not None else None}


def parse_statime_loglevel(text: str | None) -> str | None:
    for raw in (text or "").splitlines():
        match = re.match(r'^\s*loglevel\s*=\s*"([A-Za-z]+)"', raw)
        if match:
            return match.group(1).lower()
    return None


def read_port_state(path: Path) -> tuple[str, str, float] | None:
    """(state, leader, age in seconds) from the one-line file a patched
    Statime replaces at each port-state change, e.g.
    "state=Slave port=1 leader=001dc1fffe0a0b0c0001"; None when there is no
    such file or it does not parse."""
    try:
        age = time.time() - path.stat().st_mtime
    except OSError:
        return None
    text = read_text(path, 512)
    if text is None:
        return None
    fields = dict(part.split("=", 1) for part in text.split() if "=" in part)
    state = fields.get("state", "")
    leader = fields.get("leader", "")
    if state not in ("Slave", "Master", "Listening", "Passive", "Faulty"):
        return None
    if not re.fullmatch(r"[0-9a-f]{0,40}", leader):
        leader = ""
    return state, leader, max(0.0, age)


def clock_state(statime: str | None, loglevel: str | None,
                port: tuple[str, str, float] | None = None) -> dict:
    """Whether the PTP follower has a clock leader, as far as can be known.

    With a Statime that publishes its port state (`port`, from
    read_port_state) the answer is that state: Slave is following a leader;
    Master means no other device leads and this one has elected itself,
    which a follower-only unit cannot act on; Listening past a short grace
    is no leader found. Without it, the rest of this note applies.

    Statime, not running, follows nothing: that is the one firm answer.
    Running, it says nothing that tells lock from no lock at the level it is
    installed at. Its port-state changes ("new state for port 1: Listening ->
    Slave", statime/src/port/mod.rs) are logged at info; at warn, which the
    installed config uses, the only related lines are "trying to act as
    master in PTPv1" when it loses a leader (port/master.rs) and nothing when
    it gains one, and the unit's journal rate limit (5 lines per 30 s, taken
    by the DelayReq warning other followers trigger every few seconds) can
    drop even that. At info the per-sync Measurement lines would take the
    same limit, so the newest state line could be stale. Either way a
    "locked" from the journal could be wrong, so this answers unknown.
    """
    if statime in ("inactive", "failed", "activating", "deactivating"):
        return {"state": "no-leader", "detail": f"Statime (the PTP follower) is {statime}"}
    if statime != "active":
        return {"state": "unknown", "detail": f"Statime's service state is {statime or 'unknown'}"}
    if port is not None:
        state, leader, age = port
        if state == "Slave":
            return {"state": "locked", "detail": f"following leader {leader}" if leader else "following a leader"}
        if state == "Master":
            return {"state": "no-leader", "detail": "no other device on the network is leading the clock"}
        if state == "Listening":
            if age < CLOCK_LISTENING_GRACE_SECONDS:
                return {"state": "unknown", "detail": "looking for a clock leader"}
            return {"state": "no-leader", "detail": "no clock leader has been heard on the network"}
        return {"state": "unknown", "detail": f"the PTP port is {state.lower()}"}
    if loglevel in (None, "warn", "error"):
        return {"state": "unknown",
                "detail": f"Statime runs at loglevel {loglevel or 'unknown'}, which does not log "
                          "gaining or losing a clock leader"}
    return {"state": "unknown",
            "detail": f"Statime runs at loglevel {loglevel}, but the unit's journal rate limit can drop "
                      "its port-state lines, so the newest one is not proof of lock"}


# ---------------------------------------------------------------- collector

class Collector:
    """Single owner of every read against the Pi.

    Publishes one immutable snapshot dict. Every HTTP handler reads that
    snapshot; none of them triggers work of its own, so N browsers cost the
    same as one.
    """

    def __init__(self, static_dir: Path, preset_dir: Path) -> None:
        self.static_dir = static_dir
        self.preset_dir = preset_dir
        self._lock = threading.Lock()
        self._snapshot: dict = {"ok": False, "reason": "starting"}
        self._stop = threading.Event()
        self._fast: dict = {}
        self._slow: dict = {}
        self._daemon: dict = {}
        self._started = time.time()
        self._dsp: dict = {"available": False, "reason": "not yet probed"}

    # ---- tiers

    def collect_fast(self) -> dict:
        if stack() == "dante":
            # No /run telemetry files on this stack: the owner speaks through
            # its journal (the 10 s tier) and its meter and live files.
            state = {"apply": apply_state(), "dspLive": read_live_status(),
                     "startCheck": parse_startcheck(read_text(STARTCHECK_STATUS, 1024))}
            meters = read_meters()
            state["meters"] = {"available": meters["available"], "endpoint": "/api/meters",
                               "pollMsMin": 100, "reason": meters.get("reason", ""),
                               "windowMs": meters.get("windowMs"), "stages": sorted(meters.get("taps", {}))}
            return state
        state: dict = {"bridge": {"present": False}}
        line = read_text(RUN_DIR / "last-bridge")
        if line and line.startswith("BRIDGE"):
            fields = parse_bridge_line(line)
            try:
                age = time.time() - (RUN_DIR / "last-bridge").stat().st_mtime
            except OSError:
                age = None
            state["bridge"] = {
                "present": True,
                "ageSeconds": None if age is None else round(age, 1),
                "ppm": fields.get("ppm"),
                "phaseErrorUs": fields.get("phase_us"),
                "txQueue": fields.get("tx_queue"),
                "rxQueue": fields.get("rx_queue"),
                "txQueueFloor": fields.get("tx_qfloor"),
                "rxQueueFloor": fields.get("rx_qfloor"),
                "txDepthFloor": fields.get("tx_dfloor"),
                "rxDepthFloor": fields.get("rx_dfloor"),
                "txRestarts": fields.get("tx_restarts"),
                "rxRestarts": fields.get("rx_restarts"),
                "txDropped": fields.get("tx_dropped"),
                "rxDropped": fields.get("rx_dropped"),
                "txClip": fields.get("tx_clip"),
                "rxClip": fields.get("rx_clip"),
                "txPullMax": fields.get("tx_pullmax"),
                "rxPullMax": fields.get("rx_pullmax"),
                "dspUsMax": fields.get("dsp_us_max"),
                "dspLiveGen": fields.get("dsp_live_gen"),
                "dspLiveRefused": fields.get("dsp_live_refused"),
                "meterUsMax": fields.get("meter_us_max"),
            }
        stage = read_text(RUN_DIR / "stage", 4096)
        if stage:
            stamp, _, text = stage.strip().partition(" ")
            since = None
            try:
                since = int(time.time() - int(stamp))
            except ValueError:
                text = stage.strip()
            state["stage"] = {"text": text.strip(), "secondsAgo": since}
        recovers = read_text(RUN_DIR / "recovers", 1 << 20)
        if recovers is not None:
            state["recovers"] = len([v for v in recovers.splitlines() if v.strip()])
        state["apply"] = apply_state()
        state["dspLive"] = read_live_status()
        meters = read_meters()
        state["meters"] = {"available": meters["available"], "endpoint": "/api/meters",
                           "pollMsMin": 100, "reason": meters.get("reason", ""),
                           "windowMs": meters.get("windowMs"), "stages": sorted(meters.get("taps", {}))}
        return state

    def collect_slow(self) -> dict:
        state: dict = {}
        self._slow_ticks = getattr(self, "_slow_ticks", 0) + 1
        if self._slow_ticks % 12 == 1:   # once a minute: the stack does not change under a running page
            _stack["name"] = detect_stack()
        dante = stack() == "dante"
        units = DANTE_UNITS if dante else UNITS
        names = list(units.values())
        active = (run(["systemctl", "is-active", *names]) or "").split()
        # systemctl prints one line per unit, in order, even when some are dead.
        state["services"] = {
            key: {"unit": unit, "state": active[index] if index < len(active) else "unknown"}
            for index, (key, unit) in enumerate(units.items())
        }

        carrier = read_text(Path(f"/sys/class/net/{AOIP_INTERFACE}/carrier"), 16)
        speed = read_text(Path(f"/sys/class/net/{AOIP_INTERFACE}/speed"), 16)
        state["network"] = {
            "interface": AOIP_INTERFACE,
            "carrier": (carrier or "").strip() == "1",
            "speedMbit": as_number((speed or "").strip()),
            "address": interface_address(AOIP_INTERFACE),
        }

        udc = {"present": False}
        udc_root = Path("/sys/class/udc")
        try:
            entries = sorted(p.name for p in udc_root.iterdir())
        except OSError:
            entries = []
        if entries:
            name = entries[0]
            udc = {
                "present": True,
                "name": name,
                "state": (read_text(udc_root / name / "state", 64) or "").strip(),
                "speed": (read_text(udc_root / name / "current_speed", 64) or "").strip(),
            }
        state["usb"] = udc

        if dante:
            conf_text = read_text(DANTE_CONF, 1 << 16)
            if conf_text is not None:
                owner_conf = parse_owner_conf(conf_text)
                selected, rows = dante_profiles(owner_conf)
                rate = owner_conf.get("RATE", "48000")
                # The rate the endpoint runs at (owner.conf's RATE; absent is 48 kHz).
                state["profile"] = {"selected": selected, "profiles": rows,
                                    "rate": int(rate) if rate.isdigit() else None}
            else:
                state["profile"] = {"selected": None, "profiles": [], "reason": f"{DANTE_CONF} unreadable"}
            state["device"] = {"name": parse_device_name(read_text(INFERNO_CONF, 1 << 16))}
            self._statime_loglevel = parse_statime_loglevel(read_text(STATIME_CONF, 1 << 14))
        else:
            conf_text = read_text(AES67_CONF, 1 << 20)
            if conf_text is not None:
                conf = parse_conf(conf_text)
                state["profile"] = {"selected": conf.get("PROFILE") or None, "profiles": conf_profiles(conf)}
            else:
                state["profile"] = {"selected": None, "profiles": [], "reason": f"{AES67_CONF} unreadable"}
        applier = (run(["systemctl", "is-active", APPLY_UNIT]) or "unknown").strip()
        inbox_problem = inbox_unwritable()
        reason = None
        if applier != "active":
            reason = f"{APPLY_UNIT} is {applier}: install and enable it to switch profiles from here"
        elif inbox_problem:
            reason = inbox_problem
        state["control"] = {
            "apply": {
                "available": reason is None,
                "unit": APPLY_UNIT,
                "state": applier,
                "reason": reason,
                "scope": "direct and your installed presets; a switch restarts the Dante service and draws a new latency level"
                         if dante else
                         "accepted profiles only; a switch restarts the AES67 service and draws a new latency level",
            }
        }

        system: dict = {}
        temp = run(["vcgencmd", "measure_temp"], timeout=3.0)
        if temp:
            match = re.search(r"([0-9.]+)", temp)
            if match:
                system["tempC"] = float(match.group(1))
        throttled = run(["vcgencmd", "get_throttled"], timeout=3.0)
        if throttled and "=" in throttled:
            code = throttled.strip().split("=", 1)[1]
            system["throttled"] = code
            try:
                system["throttledNow"] = bool(int(code, 16) & 0x7)
            except ValueError:
                pass
        try:
            system["load"] = list(os.getloadavg())[:3]
        except OSError:
            pass
        uptime = read_text(Path("/proc/uptime"), 128)
        if uptime:
            system["uptimeSeconds"] = int(float(uptime.split()[0]))
        state["system"] = system
        return state

    def collect_daemon(self) -> dict:
        # Deliberately limited to idempotent reads. /api/sink/status/N is not
        # among them: reading it clears the arrival-lead minimum that the
        # latency harness owns.
        if stack() == "dante":
            return self.collect_owner()
        state: dict = {}
        ptp = http_json("/api/ptp/status")
        state["ptp"] = ptp if isinstance(ptp, dict) else {"status": "unavailable"}
        config = http_json("/api/config")
        if isinstance(config, dict):
            state["daemon"] = {
                "sampleRate": config.get("sample_rate"),
                "interface": config.get("interface_name"),
                "address": config.get("ip_addr"),
                "nodeId": config.get("node_id"),
                "ptpDomain": config.get("ptp_domain"),
            }
        streams: dict = {"sinks": [], "sources": []}
        sinks = http_json("/api/sinks")
        if isinstance(sinks, dict):
            for sink in sinks.get("sinks", []):
                streams["sinks"].append({
                    "id": sink.get("id"),
                    "name": sink.get("name"),
                    "delay": sink.get("delay"),
                    "channels": len(sink.get("map") or []),
                })
        sources = http_json("/api/sources")
        if isinstance(sources, dict):
            for source in sources.get("sources", []):
                streams["sources"].append({
                    "id": source.get("id"),
                    "name": source.get("name"),
                    "enabled": source.get("enabled"),
                    "address": source.get("address"),
                    "channels": len(source.get("map") or []),
                })
        state["streams"] = streams
        return state

    def collect_owner(self) -> dict:
        """The Dante tier: the owner's last telemetry lines. There is no
        daemon to ask and no stream table; routing lives in Dante Controller."""
        text = run(["journalctl", "-u", DANTE_UNIT, "-n", "80", "--no-pager", "-o", "short-unix"], timeout=8.0)
        return {"owner": parse_owner_lines(text or "")}

    def collect_dsp(self) -> dict:
        """What the DSP processor mode would need, and what is actually there.

        The engine binary is staged but nothing runs it, no preset compiler
        exists and no DSP service is installed, so the UI must present DSP mode
        as a draft rather than a running path.
        """
        if stack() == "dante":
            return {
                "available": False,
                "engine": None,
                "missing": ["an AoIP-only source (the endpoint filters what the USB host sends)"],
                "reason": "The Dante endpoint's DSP stage is accepted and its meters are live. Settings "
                          "installs this editor's draft as a preset (compiled here, validated by the "
                          "Pi's own loader, never soaked) and switches between your presets and direct.",
            }
        # The staged CamillaDSP binary is reported on the AES67 stack only;
        # the Dante answer above never carried it.
        engine = None
        if CAMILLA_BIN.is_file() and os.access(CAMILLA_BIN, os.X_OK):
            engine = (run([str(CAMILLA_BIN), "--version"]) or "").strip() or "present"
        missing = ["metering (a benchmarked tap in the bridge)", "AoIP-only mode"]
        return {
            # The stage runs in the bridge; the draft reaches it through Apply.
            # "available" stays false until the editor can show what is live.
            "available": False,
            "engine": engine,
            "missing": missing,
            # The caller already states what is running; do not repeat it here.
            "reason": "The bridge's DSP stage is accepted. Settings switches between the two "
                      "pinned presets and installs this editor's draft as a user preset "
                      "(compiled here, validated by the Pi's own loader, never soaked).",
        }

    # ---- assembly

    def build(self) -> dict:
        services = self._slow.get("services", {})
        aes67 = services.get("aes67", {}).get("state")
        gadget = services.get("gadget", {}).get("state")
        bridge = self._fast.get("bridge", {})
        running = aes67 == "active" and bridge.get("present") and (
            bridge.get("ageSeconds") is not None and bridge["ageSeconds"] < 15
        )
        if stack() == "dante":
            return self.build_dante(services, gadget)
        snapshot = {
            "ok": True,
            "generated": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
            "service": {"name": "usb16x16-web", "version": VERSION,
                        "uptimeSeconds": int(time.time() - self._started)},
            "host": socket.gethostname(),
            "audio": {"sampleRate": self._daemon.get("daemon", {}).get("sampleRate", 48000),
                      "inputs": 16, "outputs": 16},
            "stack": "aes67",
            "device": {"name": DEFAULT_DEVICE_NAME},
            "mode": {
                "actual": "direct",
                "running": bool(running),
                "detail": "Direct USB ↔ AoIP bridge" if running
                          else f"AES67 service {aes67 or 'unknown'}, USB gadget {gadget or 'unknown'}",
            },
            # Overridden by the fast tier's read of the bridge's snapshot file.
            "meters": {"available": False, "reason": "not yet read"},
            "dsp": self._dsp,
        }
        snapshot.update(self._fast)
        snapshot.update(self._slow)
        snapshot.update(self._daemon)
        return snapshot

    def build_dante(self, services: dict, gadget) -> dict:
        dante = services.get("dante", {}).get("state")
        statime = services.get("statime", {}).get("state")
        running = dante == "active"
        selected = (self._slow.get("profile") or {}).get("selected")
        if running:
            detail = ("USB ↔ Dante endpoint, direct" if selected in (None, DANTE_DIRECT)
                      else f"USB ↔ Dante endpoint with DSP preset {selected}")
        else:
            detail = f"Dante service {dante or 'unknown'}, clock {statime or 'unknown'}, USB gadget {gadget or 'unknown'}"
        # owner.conf's RATE= (absent is 48 kHz; profile.rate is None only when it is garbled).
        rate = (self._slow.get("profile") or {}).get("rate")
        snapshot = {
            "ok": True,
            "generated": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
            "service": {"name": "usb16x16-web", "version": VERSION,
                        "uptimeSeconds": int(time.time() - self._started)},
            "host": socket.gethostname(),
            "audio": {"sampleRate": rate if isinstance(rate, int) else 48000, "inputs": 16, "outputs": 16},
            "stack": "dante",
            "device": {"name": DEFAULT_DEVICE_NAME},
            "startCheck": {"state": "unknown", "rate": None, "restarts": None, "time": None},
            "clock": clock_state(statime, getattr(self, "_statime_loglevel", None), read_port_state(CLOCK_STATE_FILE)),
            "mode": {
                "actual": "direct" if selected in (None, DANTE_DIRECT) else "dsp",
                "running": bool(running),
                "detail": detail,
            },
            "meters": {"available": False, "reason": "not yet read"},
            "dsp": self._dsp,
            "owner": {"present": False},
        }
        snapshot.update(self._fast)
        snapshot.update(self._slow)
        snapshot.update(self._daemon)
        return snapshot

    def loop(self) -> None:
        _stack["name"] = detect_stack()
        self._dsp = self.collect_dsp()
        next_slow = 0.0
        next_daemon = 0.0
        while not self._stop.is_set():
            now = time.monotonic()
            try:
                self._fast = self.collect_fast()
                if now >= next_slow:
                    self._slow = self.collect_slow()
                    next_slow = now + SLOW_INTERVAL
                if now >= next_daemon:
                    self._daemon = self.collect_daemon()
                    next_daemon = now + DAEMON_INTERVAL
                snapshot = self.build()
            except Exception as error:  # never let the collector die
                snapshot = {"ok": False, "reason": f"collector error: {error}"}
            with self._lock:
                self._snapshot = snapshot
            self._stop.wait(FAST_INTERVAL)

    def snapshot(self) -> dict:
        with self._lock:
            return self._snapshot

    def stop(self) -> None:
        self._stop.set()


# ------------------------------------------------------------------ apply

# The id of the last request this process put in the inbox. The inbox cannot
# be listed from here, so "a request is pending" means that name is still
# there: the applier removes a request when it picks it up.
_last_request: dict = {"id": None}
_last_request_lock = threading.Lock()


def inbox_unwritable() -> str | None:
    """Why requests cannot be put in the inbox, or None when they can."""
    if not APPLY_INBOX.is_dir():
        return f"{APPLY_INBOX} does not exist; the Apply units are not installed"
    if not os.access(APPLY_INBOX, os.W_OK | os.X_OK):
        return (f"{APPLY_INBOX} is not writable by this service; it must be in the inbox's group "
                "(reinstall the Apply units)")
    return None


def apply_state() -> dict:
    """What the privileged applier last wrote, plus whether a request waits."""
    state: dict = {"current": None, "pending": False, "inFlight": False}
    text = read_text(APPLY_STATE / "current.json", 1 << 18)
    if text:
        try:
            current = json.loads(text)
        except ValueError:
            current = None
        if isinstance(current, dict):
            state["current"] = current
            updated = parse_iso(current.get("updatedAt"))
            fresh = updated is not None and (time.time() - updated) < APPLY_STALE_SECONDS
            state["inFlight"] = current.get("state") not in APPLY_TERMINAL and fresh
    with _last_request_lock:
        ident = _last_request["id"]
    if ident:
        try:
            pending = (APPLY_INBOX / f"{ident}.request").stat()
            state["pending"] = (time.time() - pending.st_mtime) < REQUEST_MAX_AGE_SECONDS
        except OSError:
            pass
    return state


def artifact_shape(text: str) -> str | None:
    """The canonical shape text of a bridge artifact (every count and index,
    gains, delays and coefficients blanked; all 16 outputs in index order),
    line for line what bridge-artifact.mjs, usb16x16-apply and the bridge
    produce. None when the text is not an artifact. Read-only use here: the
    installed preset's shape key lets the page tell a live edit from one
    that needs Compile & apply without compiling the installed file itself."""
    lines = [line.strip() for line in text.split("\n") if line.strip()]
    at = 0
    try:
        def next_line() -> str:
            nonlocal at
            at += 1
            return lines[at - 1]
        def header(keyword: str) -> str:
            parts = next_line().split()
            if parts[0] != keyword or len(parts) != 2:
                raise ValueError(keyword)
            return parts[1]
        out = []
        if header("usb16x16-dsp") != "1":
            return None
        out.append("usb16x16-dsp-shape 1")
        if not next_line().startswith("preset"):
            return None
        for keyword in ("rate", "channels", "internal", "maxdelay"):
            out.append(f"{keyword} {header(keyword)}")
        def mix(keyword: str) -> None:
            rows = int(header(keyword))
            out.append(f"{keyword} {rows}")
            for _ in range(rows):
                parts = next_line().split()
                if len(parts) != 3:
                    raise ValueError(keyword)
                out.append(f"{parts[0]} {parts[1]}")
        mix("expand")
        branches = int(header("branch"))
        out.append(f"branch {branches}")
        for _ in range(branches):
            parts = next_line().split()
            if len(parts) != 2:
                raise ValueError("branch")
            out.append(f"{parts[0]} {parts[1]}")
            at += int(parts[1])
        mix("assign")
        per_output = [0] * 16
        for _ in range(int(header("output"))):
            parts = next_line().split()
            if len(parts) != 4 or int(parts[0]) >= 16:
                raise ValueError("output")
            per_output[int(parts[0])] = int(parts[3])
            at += int(parts[3])
        out.append("output 16")
        out.extend(f"{index} {sections}" for index, sections in enumerate(per_output))
        if next_line() != "end" or at != len(lines):
            return None
    except (ValueError, IndexError):
        return None
    out.append("end")
    return "\n".join(out) + "\n"


def shape_key(text: str) -> str | None:
    shape = artifact_shape(text)
    return None if shape is None else hashlib.sha256(shape.encode("utf-8")).hexdigest()


_shape_cache: dict = {}


def installed_shape(path: str) -> str | None:
    """The shape key of an installed preset file, cached on its mtime and size."""
    try:
        stat = os.stat(path)
    except OSError:
        return None
    stamp = (stat.st_mtime_ns, stat.st_size)
    hit = _shape_cache.get(path)
    if hit and hit[0] == stamp:
        return hit[1]
    text = read_text(Path(path), 1 << 18)
    key = shape_key(text) if text else None
    _shape_cache[path] = (stamp, key)
    return key


def read_live_status(now: float | None = None) -> dict:
    """The bridge's one-line answer to the last live file, under RUN_DIR:
    DSPLIVE gen= sha256= state=applied|refused|ignored|idle reason="" t_us=."""
    dante = stack() == "dante"
    path = (DANTE_RUN_DIR if dante else RUN_DIR) / "dsp-live.status"
    text = read_text(path, 4096)
    if not text or not text.startswith("DSPLIVE "):
        return {"available": False,
                "reason": "the Dante endpoint follows no live file (no preset is running)" if dante else
                          "the bridge has no live file (the profile does not set DSP_LIVE=1)"}
    fields: dict = {}
    for match in re.finditer(r'(\w+)=("([^"]*)"|\S+)', text[len("DSPLIVE "):]):
        fields[match.group(1)] = match.group(3) if match.group(3) is not None else match.group(2)
    try:
        age = (now if now is not None else time.time()) - path.stat().st_mtime
    except OSError:
        age = None
    gen = fields.get("gen")
    return {"available": True, "gen": int(gen) if gen and gen.isdigit() else None,
            "sha256": None if fields.get("sha256") in (None, "none") else fields.get("sha256"),
            "state": fields.get("state"), "reason": fields.get("reason", ""),
            "ageSeconds": None if age is None else round(age, 1)}


def preset_slug(name: str) -> str:
    """The <slug> of user-<slug> / dante-<slug> from a preset name: lower-case letters, digits and single
    dashes, at most 24 characters, the same rule the applier enforces."""
    slug = re.sub(r"[^a-z0-9]+", "-", name.lower()).strip("-")[:24].rstrip("-")
    return slug if USER_SLUG.match(slug) else ""


def rate_artifacts_from(body: dict, allowed: tuple[str, ...]) -> dict[str, bytes] | str:
    """A request's `rateArtifacts` {rate: artifact text} as bytes, or the reason it is refused."""
    given = body.get("rateArtifacts")
    if given is None:
        return {}
    if not isinstance(given, dict) or len(given) > len(allowed):
        return "rateArtifacts must map rates to artifact texts"
    found: dict[str, bytes] = {}
    for rate, text in given.items():
        if rate not in allowed:
            return f"rateArtifacts: {str(rate)[:12]} is not a rate this request carries ({', '.join(allowed)})"
        if not isinstance(text, str) or not text.startswith("usb16x16-dsp 1\n") or not text.endswith("end\n"):
            return f"rateArtifacts {rate}: not the compiler's bridge artifact text"
        data = text.encode("utf-8")
        if len(data) > PRESET_ARTIFACT_MAX:
            return f"rateArtifacts {rate}: larger than {PRESET_ARTIFACT_MAX} bytes"
        found[rate] = data
    return found


def write_inbox_file(name: str, data: bytes) -> None:
    """One file into the inbox, whole or not at all: written under <name>.tmp
    (created exclusively, never through a link, mode 0640), fsynced, then
    renamed to <name>."""
    temporary = APPLY_INBOX / f"{name}.tmp"
    fd = os.open(temporary, os.O_CREAT | os.O_EXCL | os.O_WRONLY | getattr(os, "O_NOFOLLOW", 0), 0o640)
    try:
        os.fchmod(fd, 0o640)   # whatever the umask
        with os.fdopen(fd, "wb") as handle:
            fd = -1
            handle.write(data)
            handle.flush()
            os.fsync(handle.fileno())
        os.rename(temporary, APPLY_INBOX / name)
    except BaseException:
        if fd >= 0:
            os.close(fd)
        try:
            os.unlink(temporary)
        except OSError:
            pass
        raise


def write_apply_request(profile: str, expected: str | None, user: str | None, extra: dict | None = None,
                        artifact: bytes | None = None, rate_artifacts: dict[str, bytes] | None = None) -> str:
    """The only write this process makes outside its preset store: the
    artifacts a request refers to (<id>.dsp, <id>-<rate>.dsp), then the
    request itself (<id>.request), each atomically, into the applier's
    inbox, which the installer creates. The request comes last, so the
    applier never finds one whose artifacts are not all there."""
    problem = inbox_unwritable()
    if problem:
        raise PermissionError(problem)
    ident = secrets.token_hex(8)
    payload = {"id": ident, "profile": profile, "expectedProfile": expected,
               "requestedAt": time.time(), "requestedBy": user}
    if extra:
        payload.update(extra)
    if artifact is not None:
        write_inbox_file(f"{ident}.dsp", artifact)
        payload["artifactFile"] = f"{ident}.dsp"
    if rate_artifacts:
        payload["rateArtifacts"] = {}
        for rate, data in sorted(rate_artifacts.items()):
            write_inbox_file(f"{ident}-{rate}.dsp", data)
            payload["rateArtifacts"][rate] = {"file": f"{ident}-{rate}.dsp", "sha256": hashlib.sha256(data).hexdigest()}
    write_inbox_file(f"{ident}.request", json.dumps(payload, indent=2).encode("utf-8"))
    with _last_request_lock:
        _last_request["id"] = ident
    return ident


# ------------------------------------------------------------------ presets

class PresetStore:
    """Durable presets as one JSON file each, written atomically.

    A preset is UI configuration only. Nothing here is applied to the device;
    the file is the same document the browser exports.
    """

    MAX_BYTES = 1 << 20
    MAX_COUNT = 200

    def __init__(self, directory: Path) -> None:
        self.directory = directory
        self.directory.mkdir(parents=True, exist_ok=True)

    @staticmethod
    def slug(name: str) -> str:
        return re.sub(r"[^A-Za-z0-9._-]", "_", name)[:80]

    def path(self, name: str) -> Path:
        return self.directory / f"{self.slug(name)}.json"

    def list(self) -> list[dict]:
        items = []
        for entry in sorted(self.directory.glob("*.json")):
            try:
                document = json.loads(entry.read_text(encoding="utf-8"))
            except (OSError, ValueError):
                continue
            if isinstance(document, dict):
                items.append({
                    "name": document.get("name") or entry.stem,
                    "modified": int(entry.stat().st_mtime),
                })
        return items

    def read(self, name: str):
        try:
            return json.loads(self.path(name).read_text(encoding="utf-8"))
        except (OSError, ValueError):
            return None

    def write(self, name: str, document: dict) -> None:
        if not PRESET_NAME.match(name):
            raise ValueError("Preset names use letters, digits, space, dot, dash "
                             "or underscore, up to 64 characters")
        target = self.path(name)
        if not target.exists() and len(list(self.directory.glob("*.json"))) >= self.MAX_COUNT:
            raise ValueError(f"The preset store holds at most {self.MAX_COUNT} presets")
        document = dict(document)
        document["name"] = name
        payload = json.dumps(document, indent=2)
        if len(payload.encode("utf-8")) > self.MAX_BYTES:
            raise ValueError("Preset is larger than 1 MB")
        temporary = target.with_suffix(".json.tmp")
        with open(temporary, "w", encoding="utf-8") as handle:
            handle.write(payload)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temporary, target)

    def delete(self, name: str) -> bool:
        try:
            self.path(name).unlink()
            return True
        except OSError:
            return False


