def choose_bind(explicit: str, interface: str, lookup=interface_address) -> str | None:
    """The address to listen on: --bind when given, else the management
    interface's IPv4 address. None when that interface has none yet; the
    caller exits and systemd retries, rather than serving on loopback."""
    if explicit:
        return explicit
    return lookup(interface) or None


def tls_context(cert: str, key: str) -> ssl.SSLContext:
    """A server context at TLS 1.2 or later. Raises OSError or ssl.SSLError
    when the certificate or key cannot be read or do not match."""
    context = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
    context.minimum_version = ssl.TLSVersion.TLSv1_2
    context.load_cert_chain(certfile=cert, keyfile=key)
    return context


def make_server(bind: str, port: int, context: ssl.SSLContext | None = None) -> ThreadingHTTPServer:
    """The HTTP(S) server. With a context, accepted connections are wrapped
    without a handshake; Handler.setup performs it in the connection's thread."""
    server = ThreadingHTTPServer((bind, port), Handler)
    server.daemon_threads = True
    if context is not None:
        server.socket = context.wrap_socket(server.socket, server_side=True, do_handshake_on_connect=False)
    return server


def main() -> int:
    here = Path(__file__).resolve().parent
    parser = argparse.ArgumentParser(description="Web control service for USB-AoIP")
    parser.add_argument("--static", default=str(here.parent / "web-ui"),
                        help="directory holding the web UI files")
    parser.add_argument("--presets", default=os.path.expanduser("~/usb-16x16-work/web-presets"),
                        help="directory holding saved presets")
    parser.add_argument("--bind", default="",
                        help="address to bind (default: the management interface address)")
    parser.add_argument("--management-interface", default=os.environ.get("USB16X16_MGMT_IF", "wlan0"),
                        help="interface whose address is used when --bind is empty")
    parser.add_argument("--port", type=int, default=8088)
    parser.add_argument("--tls-cert", metavar="FILE", default="",
                        help="serve HTTPS with this certificate (PEM; needs --tls-key)")
    parser.add_argument("--tls-key", metavar="FILE", default="",
                        help="the certificate's private key (PEM; needs --tls-cert)")
    parser.add_argument("--auth-file", default=os.path.expanduser("~/usb-16x16-work/web-auth"),
                        help="file holding user names and password hashes")
    parser.add_argument("--no-auth", action="store_true",
                        help="serve without authentication (do not use on a shared network)")
    parser.add_argument("--add-user", metavar="NAME",
                        help="prompt for a password, add or replace this user, then exit")
    parser.add_argument("--remove-user", metavar="NAME",
                        help="remove this user, then exit")
    arguments = parser.parse_args()

    password_file = PasswordFile(Path(arguments.auth_file))

    # Credential management runs and exits without starting a server, so a
    # password never reaches argv, the shell history or the journal.
    if arguments.add_user:
        try:
            password = getpass.getpass(f"Password for {arguments.add_user}: ")
            if password != getpass.getpass("Repeat password: "):
                print("passwords did not match", file=sys.stderr)
                return 2
            password_file.set_user(arguments.add_user, password)
        except (ValueError, OSError) as error:
            print(error, file=sys.stderr)
            return 2
        except (KeyboardInterrupt, EOFError):
            print("cancelled", file=sys.stderr)
            return 2
        print(f"user {arguments.add_user} written to {password_file.path}")
        print("restart the service to pick it up: sudo systemctl restart usb16x16-web.service")
        return 0

    if arguments.remove_user:
        try:
            if not password_file.remove_user(arguments.remove_user):
                print(f"no such user: {arguments.remove_user}", file=sys.stderr)
                return 2
        except (ValueError, OSError) as error:
            print(error, file=sys.stderr)
            return 2
        print(f"user {arguments.remove_user} removed from {password_file.path}")
        return 0

    static_dir = Path(arguments.static).resolve()
    if not (static_dir / "index.html").is_file():
        print(f"no index.html under {static_dir}", file=sys.stderr)
        return 2

    # Fail closed. Serving this open has to be a decision someone typed, not
    # what happens when a credentials file is missing or unreadable.
    authenticator = None
    if arguments.no_auth:
        print("WARNING: --no-auth, serving without authentication", file=sys.stderr, flush=True)
    else:
        users = password_file.load()
        if not users:
            print(f"no users in {password_file.path}\n"
                  f"add one:  {sys.argv[0]} --auth-file {password_file.path} --add-user NAME\n"
                  f"or serve open with --no-auth", file=sys.stderr)
            return 2
        authenticator = Authenticator(password_file)

    if bool(arguments.tls_cert) != bool(arguments.tls_key):
        print("--tls-cert and --tls-key go together: give both, or neither for plain HTTP", file=sys.stderr)
        return 2
    context = None
    if arguments.tls_cert:
        try:
            context = tls_context(arguments.tls_cert, arguments.tls_key)
        except (OSError, ssl.SSLError) as error:
            print(f"cannot use the TLS certificate {arguments.tls_cert} with key {arguments.tls_key}: {error}",
                  file=sys.stderr)
            return 2

    bind = choose_bind(arguments.bind, arguments.management_interface)
    if bind is None:
        print(f"{arguments.management_interface} has no IPv4 address yet; not serving "
              f"(exit {EXIT_NO_ADDRESS}, the unit retries). Use --bind ADDR to choose one.",
              file=sys.stderr, flush=True)
        return EXIT_NO_ADDRESS

    collector = Collector(static_dir, Path(arguments.presets))
    Handler.collector = collector
    Handler.presets = PresetStore(Path(arguments.presets))
    Handler.auth = authenticator
    Handler.tls = context is not None

    thread = threading.Thread(target=collector.loop, name="collector", daemon=True)
    thread.start()

    server = make_server(bind, arguments.port, context)
    guard = f"{len(password_file.load())} user(s)" if authenticator else "NO AUTHENTICATION"
    print(f"TLS on, certificate {arguments.tls_cert}" if context else "TLS off: plain HTTP",
          file=sys.stderr, flush=True)
    scheme = "https" if context else "http"
    print(f"usb16x16-web {VERSION} serving {static_dir} on {scheme}://{bind}:{arguments.port} ({guard})",
          file=sys.stderr, flush=True)
    try:
        server.serve_forever(poll_interval=0.5)
    except KeyboardInterrupt:
        pass
    finally:
        collector.stop()
        server.server_close()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
