def parse_meters(text: str) -> dict | None:
    """Parse the bridge's meter snapshot file: a METERS header line and one
    TAP line per stage, key=value with comma-separated per-channel lists."""
    lines = [line for line in text.splitlines() if line.strip()]
    if not lines or not lines[0].startswith("METERS "):
        return None
    header = parse_bridge_line(lines[0])
    taps: dict = {}
    for line in lines[1:]:
        if not line.startswith("TAP "):
            continue
        fields: dict = {}
        for token in line.split()[1:]:
            key, _, value = token.partition("=")
            fields[key] = value
        stage = fields.get("stage")
        if not stage:
            continue
        try:
            peaks = [float(v) for v in fields.get("peak_dbfs", "").split(",")]
            rms = [float(v) for v in fields.get("rms_dbfs", "").split(",")]
            clipped = [int(v) for v in fields.get("clip", "").split(",")]
            if not (len(peaks) == len(rms) == len(clipped) == 16):
                continue
            taps[stage] = {
                "stage": stage,
                "where": METER_STAGES.get(stage, ""),
                "sequence": int(fields.get("seq", 0)),
                "frames": int(fields.get("frames", 0)),
                "position": int(fields.get("position", 0)),
                "peakDb": peaks,
                "rmsDb": rms,
                "clipped": clipped,
            }
        except ValueError:
            continue
    if not taps:
        return None
    return {
        "version": header.get("v"),
        "bridgeTimeUs": header.get("t_us"),
        "windowFrames": header.get("window_frames"),
        "writes": header.get("writes"),
        "taps": taps,
    }


_meters_cache: dict = {"mtime": None, "body": None}
_meters_lock = threading.Lock()
# stage -> (sequence last seen, when it was first seen at that value). The owner
# rewrites its file twenty times a second whether or not audio is moving, and a
# tap that has had no frames keeps its last window in it: a file that is fresh
# says nothing about a tap that is not. A tap is live while its sequence moves.
_tap_progress: dict = {}
METER_FLOOR_DB = -144.0


def settle_taps(taps: dict, now: float) -> tuple[dict, list[str]]:
    """The taps with every one whose sequence has stood still for longer than
    METERS_FRESH_S reported as silent and marked idle, and the idle stages'
    names. The readings a still tap holds are of audio that stopped some time
    ago (found 2026-11-15: the last window of a test two days earlier, shown
    as live); what is true of it now is that nothing is passing."""
    settled, idle = {}, []
    for stage, tap in taps.items():
        seen = _tap_progress.get(stage)
        if seen is None or seen[0] != tap["sequence"]:
            _tap_progress[stage] = seen = (tap["sequence"], now)
        if now - seen[1] > METERS_FRESH_S:
            idle.append(stage)
            tap = {**tap, "idle": True, "peakDb": [METER_FLOOR_DB] * 16,
                   "rmsDb": [METER_FLOOR_DB] * 16, "clipped": [0] * 16}
        settled[stage] = tap
    return settled, sorted(idle)


def read_meters(now: float | None = None) -> dict:
    """The latest meter snapshot, parsed once per file version. A missing or
    stale file (the bridge stopped, or runs untapped) reads as unavailable;
    the reason says which."""
    now = time.time() if now is None else now
    dante = stack() == "dante"
    meters_file = DANTE_RUN_DIR / "meters.txt" if dante else METERS_FILE
    engine = words()["engine"]
    try:
        stat = meters_file.stat()
    except OSError:
        return {"ok": True, "available": False,
                "reason": f"No meter snapshot: the {engine} is not running or runs with METERS=0."}
    age = now - stat.st_mtime
    with _meters_lock:
        if _meters_cache["mtime"] != stat.st_mtime:
            parsed = parse_meters(read_text(meters_file, 16384) or "")
            _meters_cache["mtime"] = stat.st_mtime
            _meters_cache["body"] = parsed
        body = _meters_cache["body"]
    if body is None:
        return {"ok": True, "available": False, "reason": "The meter snapshot could not be parsed."}
    if age > METERS_FRESH_S:
        return {"ok": True, "available": False, "ageSeconds": round(age, 1),
                "reason": f"The meter snapshot is {age:.0f} s old: the {engine} has stopped publishing, "
                          "or no audio is moving through it." if dante else
                          f"The meter snapshot is {age:.0f} s old: the bridge has stopped publishing."}
    if dante:
        with _meters_lock:
            taps, idle = settle_taps(body["taps"], now)
        body = {**body, "taps": taps, "idleStages": idle}
    return {"ok": True, "available": True, "ageSeconds": round(age, 2),
            "source": "owner-tap" if dante else "bridge-tap",
            "windowMs": round((body.get("windowFrames") or 0) / 48.0, 1), **body}


def parse_conf(text: str) -> dict[str, str]:
    """KEY=value lines of aes67.conf, quotes stripped; the same subset
    usb16x16-apply reads. Comments and blank lines are skipped."""
    values: dict[str, str] = {}
    for raw in text.splitlines():
        line = raw.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, _, value = line.partition("=")
        value = value.strip()
        if len(value) >= 2 and value[0] == value[-1] == '"':
            value = value[1:-1]
        values[key.strip()] = value
    return values


def conf_profiles(conf: dict[str, str]) -> list[dict]:
    """Every profile block with the fields the UI shows, accepted first."""
    rows = []
    for key in conf:
        match = re.match(r"^PROFILE_([A-Z0-9_]+)_TARGET$", key)
        if not match:
            continue
        upper = match.group(1)
        field = lambda suffix, u=upper: conf.get(f"PROFILE_{u}_{suffix}", "")
        rows.append({
            "name": upper.lower().replace("_", "-"),
            "status": field("STATUS"),
            "accepted": field("STATUS") == "accepted",
            "description": field("DESCRIPTION"),
            "measured": field("MEASURED"),
            "cover": field("COVER"),
            "dspPreset": field("DSP_PRESET") or None,
            # A user preset is what usb16x16-apply installed: named user-<slug>,
            # STATUS=experimental in the supervisor's vocabulary.
            "user": upper.startswith("USER_") and field("STATUS") == "experimental",
            # The block passes the bridge a live file (LIVE_COEFFICIENTS_DESIGN.md).
            "dspLive": field("DSP_LIVE") == "1",
            "dspSha256": field("DSP_SHA256") or None,
            # The installed file's shape key, user presets only (the live base).
            "dspShape": installed_shape(field("DSP_PRESET")) if upper.startswith("USER_") and field("DSP_PRESET") else None,
        })
    rows.sort(key=lambda row: (not row["accepted"], not row["user"], row["name"]))
    return rows


def parse_iso(text) -> float | None:
    try:
        return float(calendar.timegm(time.strptime(text, "%Y-%m-%dT%H:%M:%SZ")))
    except (TypeError, ValueError):
        return None


def interface_address(name: str) -> str | None:
    """The IPv4 address of an interface, read without extra dependencies."""
    output = run(["ip", "-o", "-4", "addr", "show", "dev", name])
    if not output:
        return None
    match = re.search(r"\binet\s+([0-9.]+)/", output)
    return match.group(1) if match else None


# ---------------------------------------------------------------- the Dante stack

def parse_owner_conf(text: str) -> dict[str, str]:
    """owner.conf as usb16x16-dante-start reads it: KEY=value lines."""
    values: dict[str, str] = {}
    for raw in text.splitlines():
        match = re.match(r"^([A-Z0-9_]+)=(.*)$", raw)
        if match:
            values[match.group(1)] = match.group(2)
    return values


def artifact_title(path: Path) -> str:
    """The name on an artifact's `preset` line, for the list."""
    head = read_text(path, 512) or ""
    for line in head.splitlines()[:3]:
        if line.startswith("preset "):
            return line[len("preset "):].strip()[:64]
    return ""


def dante_profiles(conf: dict[str, str]) -> tuple[str, list[dict]]:
    """What the Dante applier switches between: direct, and every installed
    dante-<slug>.dsp. The same row shape as conf_profiles, so the page's
    panel is one panel."""
    preset = conf.get("DSP_PRESET") or ""
    # At a rate other than 48 kHz the running file is dante-<slug>@<rate>.dsp.
    selected = re.sub(r"@\d+$", "", Path(preset).name.removesuffix(".dsp")) if preset else DANTE_DIRECT
    rows = [{
        "name": DANTE_DIRECT, "status": "accepted", "accepted": True,
        "description": "Direct: no DSP stage, samples pass through unchanged",
        "measured": "", "cover": "", "dspPreset": None, "user": False, "dspLive": False,
        "dspSha256": None, "dspShape": None,
    }]
    try:
        files = sorted(DSP_DIR.glob(f"{DANTE_PREFIX}*.dsp"))
    except OSError:
        files = []
    for path in files:
        slug = path.name[len(DANTE_PREFIX):-len(".dsp")]
        if not USER_SLUG.match(slug):
            continue
        name = DANTE_PREFIX + slug
        live = name == selected
        title = artifact_title(path)
        rows.append({
            "name": name, "status": "preset", "accepted": False,
            "description": f"user preset: {title}" if title else "user preset",
            "measured": "", "cover": "", "dspPreset": str(path), "user": True,
            # A preset always starts with live following on; for the running
            # one, what the configuration actually says.
            "dspLive": conf.get("DSP_LIVE") == "1" if live else True,
            # The rates this preset has an artifact for (SAMPLE_RATE_DESIGN.md, step 4d).
            "rates": [rate for rate in (44100, 48000, 88200, 96000, 176400, 192000)
                      if (path if rate == 48000 else path.with_name(f"{name}@{rate}.dsp")).is_file()],
            "dspSha256": conf.get("DSP_SHA256") if live else None,
            # The running preset's shape is its running file's: off 48 kHz that is
            # the @<rate> artifact, whose shape names its rate.
            "dspShape": installed_shape(preset if live and preset else str(path)),
        })
    return selected, rows


def parse_owner_lines(text: str, now: float | None = None) -> dict:
    """The newest OWNER, USB, DSP and METER lines of the owner's journal
    (journalctl -o short-unix): what the endpoint last said about itself."""
    now = time.time() if now is None else now
    latest: dict = {}
    for raw in text.splitlines():
        match = re.match(r"^([0-9]+\.[0-9]+) \S+ \S+: (OWNER|USB|DSP|METER) (.*)$", raw)
        if match:
            latest[match.group(2)] = (float(match.group(1)), parse_bridge_line(match.group(3)))
    if "OWNER" not in latest:
        return {"present": False}
    stamp, owner = latest["OWNER"]
    usb = latest.get("USB", (0, {}))[1]
    dsp = latest.get("DSP", (0, {}))
    meter = latest.get("METER", (0, {}))
    # A DSP or METER line older than the OWNER line belongs to an earlier
    # minute in which audio moved; it says nothing about now.
    dsp_fields = dsp[1] if dsp[0] >= stamp - 1 else {}
    meter_fields = meter[1] if meter[0] >= stamp - 1 else {}
    return {
        "present": True,
        "ageSeconds": round(now - stamp, 1),
        "uptimeSeconds": owner.get("t"),
        "loopGapUsMax": owner.get("gap_us_max"),
        "txDepth": owner.get("tx_depth"),
        "txResyncs": owner.get("tx_resyncs"),
        "rxResyncs": owner.get("rx_resyncs"),
        "netErrors": owner.get("net_errors"),
        "usb": usb.get("usb"), "usbOut": usb.get("tx"), "usbBack": usb.get("rx"),
        "txMean": usb.get("tx_mean"), "rxMean": usb.get("rx_mean"),
        "ppmOut": usb.get("tx_i"), "ppmBack": usb.get("rx_i"),
        "txLinks": usb.get("tx_links"), "txReprimes": usb.get("tx_reprimes"),
        "rxOverflow": usb.get("rx_overflow"),
        "captureFaults": usb.get("capture_faults"), "playbackFaults": usb.get("playback_faults"),
        "detaches": usb.get("detaches"),
        "dspUsMax": dsp_fields.get("dsp_us_max"), "dspUsMean": dsp_fields.get("dsp_us_mean"),
        "dspLiveGen": dsp_fields.get("dsp_live_gen"), "dspLiveRefused": dsp_fields.get("dsp_live_refused"),
        "meterUsMax": meter_fields.get("meter_us_max"),
    }


def parse_device_name(text: str | None) -> str:
    """The Dante device name: the first uncommented NAME "..." line of the
    Inferno ALSA config, else the default."""
    for raw in (text or "").splitlines():
        match = re.match(r'^\s*NAME\s+"([^"\n]{1,63})"', raw)
        if match and match.group(1).isprintable():
            return match.group(1)
    return DEFAULT_DEVICE_NAME


def parse_startcheck(text: str | None) -> dict:
    """usb16x16-dante-startcheck's status line:
    state=ok rate=6005 restarts=0 invocation=<hex> time=2026-11-01T12:00:00Z.
    Anything missing or unrecognised reads as unknown."""
    unknown = {"state": "unknown", "rate": None, "restarts": None, "time": None}
    lines = (text or "").strip().splitlines()
    if len(lines) != 1:
        return unknown
    fields = dict(token.partition("=")[::2] for token in lines[0].split() if "=" in token)
    if fields.get("state") not in STARTCHECK_STATES:
        return unknown
    as_int = lambda value: int(value) if value and value.isdigit() else None
    stamp = fields.get("time")
    return {"state": fields["state"], "rate": as_int(fields.get("rate")),
            "restarts": as_int(fields.get("restarts")),
            "time": stamp if parse_iso(stamp) is not None else None}


def parse_statime_loglevel(text: str | None) -> str | None:
    for raw in (text or "").splitlines():
        match = re.match(r'^\s*loglevel\s*=\s*"([A-Za-z]+)"', raw)
        if match:
            return match.group(1).lower()
    return None


def read_port_state(path: Path) -> tuple[str, str, float] | None:
    """(state, leader, age in seconds) from the one-line file a patched
    Statime replaces at each port-state change, e.g.
    "state=Slave port=1 leader=001dc1fffe0a0b0c0001"; None when there is no
    such file or it does not parse."""
    try:
        age = time.time() - path.stat().st_mtime
    except OSError:
        return None
    text = read_text(path, 512)
    if text is None:
        return None
    fields = dict(part.split("=", 1) for part in text.split() if "=" in part)
    state = fields.get("state", "")
    leader = fields.get("leader", "")
    if state not in ("Slave", "Master", "Listening", "Passive", "Faulty"):
        return None
    if not re.fullmatch(r"[0-9a-f]{0,40}", leader):
        leader = ""
    return state, leader, max(0.0, age)


def clock_state(statime: str | None, loglevel: str | None,
                port: tuple[str, str, float] | None = None) -> dict:
    """Whether the PTP follower has a clock leader, as far as can be known.

    With a Statime that publishes its port state (`port`, from
    read_port_state) the answer is that state: Slave is following a leader;
    Master means no other device leads and this one has elected itself,
    which a follower-only unit cannot act on; Listening past a short grace
    is no leader found. Without it, the rest of this note applies.

    Statime, not running, follows nothing: that is the one firm answer.
    Running, it says nothing that tells lock from no lock at the level it is
    installed at. Its port-state changes ("new state for port 1: Listening ->
    Slave", statime/src/port/mod.rs) are logged at info; at warn, which the
    installed config uses, the only related lines are "trying to act as
    master in PTPv1" when it loses a leader (port/master.rs) and nothing when
    it gains one, and the unit's journal rate limit (5 lines per 30 s, taken
    by the DelayReq warning other followers trigger every few seconds) can
    drop even that. At info the per-sync Measurement lines would take the
    same limit, so the newest state line could be stale. Either way a
    "locked" from the journal could be wrong, so this answers unknown.
    """
    if statime in ("inactive", "failed", "activating", "deactivating"):
        return {"state": "no-leader", "detail": f"Statime (the PTP follower) is {statime}"}
    if statime != "active":
        return {"state": "unknown", "detail": f"Statime's service state is {statime or 'unknown'}"}
    if port is not None:
        state, leader, age = port
        if state == "Slave":
            return {"state": "locked", "detail": f"following leader {leader}" if leader else "following a leader"}
        if state == "Master":
            return {"state": "no-leader", "detail": "no other device on the network is leading the clock"}
        if state == "Listening":
            if age < CLOCK_LISTENING_GRACE_SECONDS:
                return {"state": "unknown", "detail": "looking for a clock leader"}
            return {"state": "no-leader", "detail": "no clock leader has been heard on the network"}
        return {"state": "unknown", "detail": f"the PTP port is {state.lower()}"}
    if loglevel in (None, "warn", "error"):
        return {"state": "unknown",
                "detail": f"Statime runs at loglevel {loglevel or 'unknown'}, which does not log "
                          "gaining or losing a clock leader"}
    return {"state": "unknown",
            "detail": f"Statime runs at loglevel {loglevel}, but the unit's journal rate limit can drop "
                      "its port-state lines, so the newest one is not proof of lock"}


# ---------------------------------------------------------------- collector

class Collector:
    """Single owner of every read against the Pi.

    Publishes one immutable snapshot dict. Every HTTP handler reads that
    snapshot; none of them triggers work of its own, so N browsers cost the
    same as one.
    """

    def __init__(self, static_dir: Path, preset_dir: Path, auth: bool = True) -> None:
        self.static_dir = static_dir
        self.preset_dir = preset_dir
        # False under --no-auth: there is no login whose password could change.
        self.auth = auth
        self._lock = threading.Lock()
        self._snapshot: dict = {"ok": False, "reason": "starting"}
        self._stop = threading.Event()
        self._fast: dict = {}
        self._slow: dict = {}
        self._daemon: dict = {}
        self._started = time.time()
        self._dsp: dict = {"available": False, "reason": "not yet probed"}

    # ---- tiers

    def collect_fast(self) -> dict:
        if stack() == "dante":
            # No /run telemetry files on this stack: the owner speaks through
            # its journal (the 10 s tier) and its meter and live files.
            state = {"apply": apply_state(), "dspLive": read_live_status(),
                     "startCheck": parse_startcheck(read_text(STARTCHECK_STATUS, 1024))}
            meters = read_meters()
            state["meters"] = {"available": meters["available"], "endpoint": "/api/meters",
                               "pollMsMin": 100, "reason": meters.get("reason", ""),
                               "windowMs": meters.get("windowMs"), "stages": sorted(meters.get("taps", {}))}
            return state
        state: dict = {"bridge": {"present": False}}
        line = read_text(RUN_DIR / "last-bridge")
        if line and line.startswith("BRIDGE"):
            fields = parse_bridge_line(line)
            try:
                age = time.time() - (RUN_DIR / "last-bridge").stat().st_mtime
            except OSError:
                age = None
            state["bridge"] = {
                "present": True,
                "ageSeconds": None if age is None else round(age, 1),
                "ppm": fields.get("ppm"),
                "phaseErrorUs": fields.get("phase_us"),
                "txQueue": fields.get("tx_queue"),
                "rxQueue": fields.get("rx_queue"),
                "txQueueFloor": fields.get("tx_qfloor"),
                "rxQueueFloor": fields.get("rx_qfloor"),
                "txDepthFloor": fields.get("tx_dfloor"),
                "rxDepthFloor": fields.get("rx_dfloor"),
                "txRestarts": fields.get("tx_restarts"),
                "rxRestarts": fields.get("rx_restarts"),
                "txDropped": fields.get("tx_dropped"),
                "rxDropped": fields.get("rx_dropped"),
                "txClip": fields.get("tx_clip"),
                "rxClip": fields.get("rx_clip"),
                "txPullMax": fields.get("tx_pullmax"),
                "rxPullMax": fields.get("rx_pullmax"),
                "dspUsMax": fields.get("dsp_us_max"),
                "dspLiveGen": fields.get("dsp_live_gen"),
                "dspLiveRefused": fields.get("dsp_live_refused"),
                "meterUsMax": fields.get("meter_us_max"),
            }
        stage = read_text(RUN_DIR / "stage", 4096)
        if stage:
            stamp, _, text = stage.strip().partition(" ")
            since = None
            try:
                since = int(time.time() - int(stamp))
            except ValueError:
                text = stage.strip()
            state["stage"] = {"text": text.strip(), "secondsAgo": since}
        recovers = read_text(RUN_DIR / "recovers", 1 << 20)
        if recovers is not None:
            state["recovers"] = len([v for v in recovers.splitlines() if v.strip()])
        state["apply"] = apply_state()
        state["dspLive"] = read_live_status()
        meters = read_meters()
        state["meters"] = {"available": meters["available"], "endpoint": "/api/meters",
                           "pollMsMin": 100, "reason": meters.get("reason", ""),
                           "windowMs": meters.get("windowMs"), "stages": sorted(meters.get("taps", {}))}
        return state

    def collect_slow(self) -> dict:
        state: dict = {}
        self._slow_ticks = getattr(self, "_slow_ticks", 0) + 1
        if self._slow_ticks % 12 == 1:   # once a minute: the stack does not change under a running page
            _stack["name"] = detect_stack()
        dante = stack() == "dante"
        units = DANTE_UNITS if dante else UNITS
        names = list(units.values())
        active = (run(["systemctl", "is-active", *names]) or "").split()
        # systemctl prints one line per unit, in order, even when some are dead.
        state["services"] = {
            key: {"unit": unit, "state": active[index] if index < len(active) else "unknown"}
            for index, (key, unit) in enumerate(units.items())
        }

        carrier = read_text(Path(f"/sys/class/net/{AOIP_INTERFACE}/carrier"), 16)
        speed = read_text(Path(f"/sys/class/net/{AOIP_INTERFACE}/speed"), 16)
        state["network"] = {
            "interface": AOIP_INTERFACE,
            "carrier": (carrier or "").strip() == "1",
            "speedMbit": as_number((speed or "").strip()),
            "address": interface_address(AOIP_INTERFACE),
        }

        udc = {"present": False}
        udc_root = Path("/sys/class/udc")
        try:
            entries = sorted(p.name for p in udc_root.iterdir())
        except OSError:
            entries = []
        if entries:
            name = entries[0]
            udc = {
                "present": True,
                "name": name,
                "state": (read_text(udc_root / name / "state", 64) or "").strip(),
                "speed": (read_text(udc_root / name / "current_speed", 64) or "").strip(),
            }
        state["usb"] = udc

        if dante:
            conf_text = read_text(DANTE_CONF, 1 << 16)
            if conf_text is not None:
                owner_conf = parse_owner_conf(conf_text)
                selected, rows = dante_profiles(owner_conf)
                rate = owner_conf.get("RATE", "48000")
                # The rate the endpoint runs at (owner.conf's RATE; absent is 48 kHz).
                state["profile"] = {"selected": selected, "profiles": rows,
                                    "rate": int(rate) if rate.isdigit() else None}
            else:
                state["profile"] = {"selected": None, "profiles": [], "reason": f"{DANTE_CONF} unreadable"}
            state["device"] = {"name": parse_device_name(read_text(INFERNO_CONF, 1 << 16))}
            self._statime_loglevel = parse_statime_loglevel(read_text(STATIME_CONF, 1 << 14))
        else:
            conf_text = read_text(AES67_CONF, 1 << 20)
            if conf_text is not None:
                conf = parse_conf(conf_text)
                state["profile"] = {"selected": conf.get("PROFILE") or None, "profiles": conf_profiles(conf)}
            else:
                state["profile"] = {"selected": None, "profiles": [], "reason": f"{AES67_CONF} unreadable"}
        applier = (run(["systemctl", "is-active", APPLY_UNIT]) or "unknown").strip()
        inbox_problem = inbox_unwritable()
        reason = None
        if applier != "active":
            reason = f"{APPLY_UNIT} is {applier}: install and enable it to switch profiles from here"
        elif inbox_problem:
            reason = inbox_problem
        state["control"] = {
            "apply": {
                "available": reason is None,
                "unit": APPLY_UNIT,
                "state": applier,
                "reason": reason,
                "scope": "direct and your installed presets; a switch restarts the Dante service and draws a new latency level"
                         if dante else
                         "accepted profiles only; a switch restarts the AES67 service and draws a new latency level",
                "actions": apply_actions(reason is None, dante, self.auth),
            },
            "monitor": monitor_control(dante, state["services"], reason is None),
        }

        system: dict = {}
        temp = run(["vcgencmd", "measure_temp"], timeout=3.0)
        if temp:
            match = re.search(r"([0-9.]+)", temp)
            if match:
                system["tempC"] = float(match.group(1))
        throttled = run(["vcgencmd", "get_throttled"], timeout=3.0)
        if throttled and "=" in throttled:
            code = throttled.strip().split("=", 1)[1]
            system["throttled"] = code
            try:
                system["throttledNow"] = bool(int(code, 16) & 0x7)
            except ValueError:
                pass
        try:
            system["load"] = list(os.getloadavg())[:3]
        except OSError:
            pass
        uptime = read_text(Path("/proc/uptime"), 128)
        if uptime:
            system["uptimeSeconds"] = int(float(uptime.split()[0]))
        state["system"] = system
        return state

    def collect_daemon(self) -> dict:
        # Deliberately limited to idempotent reads. /api/sink/status/N is not
        # among them: reading it clears the arrival-lead minimum that the
        # latency harness owns.
        if stack() == "dante":
            return self.collect_owner()
        state: dict = {}
        ptp = http_json("/api/ptp/status")
        state["ptp"] = ptp if isinstance(ptp, dict) else {"status": "unavailable"}
        config = http_json("/api/config")
        if isinstance(config, dict):
            state["daemon"] = {
                "sampleRate": config.get("sample_rate"),
                "interface": config.get("interface_name"),
                "address": config.get("ip_addr"),
                "nodeId": config.get("node_id"),
                "ptpDomain": config.get("ptp_domain"),
            }
        streams: dict = {"sinks": [], "sources": []}
        sinks = http_json("/api/sinks")
        if isinstance(sinks, dict):
            for sink in sinks.get("sinks", []):
                streams["sinks"].append({
                    "id": sink.get("id"),
                    "name": sink.get("name"),
                    "delay": sink.get("delay"),
                    "channels": len(sink.get("map") or []),
                })
        sources = http_json("/api/sources")
        if isinstance(sources, dict):
            for source in sources.get("sources", []):
                streams["sources"].append({
                    "id": source.get("id"),
                    "name": source.get("name"),
                    "enabled": source.get("enabled"),
                    "address": source.get("address"),
                    "channels": len(source.get("map") or []),
                })
        state["streams"] = streams
        return state

    def collect_owner(self) -> dict:
        """The Dante tier: the owner's last telemetry lines. There is no
        daemon to ask and no stream table; routing lives in Dante Controller."""
        text = run(["journalctl", "-u", DANTE_UNIT, "-n", "80", "--no-pager", "-o", "short-unix"], timeout=8.0)
        return {"owner": parse_owner_lines(text or "")}

    def collect_dsp(self) -> dict:
        """What the DSP processor mode would need, and what is actually there.

        The engine binary is staged but nothing runs it, no preset compiler
        exists and no DSP service is installed, so the UI must present DSP mode
        as a draft rather than a running path.
        """
        if stack() == "dante":
            return {
                "available": False,
                "engine": None,
                "missing": ["an AoIP-only source (the endpoint filters what the USB host sends)"],
                "reason": "The Dante endpoint's DSP stage is accepted and its meters are live. Settings "
                          "installs this editor's draft as a preset (compiled here, validated by the "
                          "Pi's own loader, never soaked) and switches between your presets and direct.",
            }
        # The staged CamillaDSP binary is reported on the AES67 stack only;
        # the Dante answer above never carried it.
        engine = None
        if CAMILLA_BIN.is_file() and os.access(CAMILLA_BIN, os.X_OK):
            engine = (run([str(CAMILLA_BIN), "--version"]) or "").strip() or "present"
        missing = ["metering (a benchmarked tap in the bridge)", "AoIP-only mode"]
        return {
            # The stage runs in the bridge; the draft reaches it through Apply.
            # "available" stays false until the editor can show what is live.
            "available": False,
            "engine": engine,
            "missing": missing,
            # The caller already states what is running; do not repeat it here.
            "reason": "The bridge's DSP stage is accepted. Settings switches between the two "
                      "pinned presets and installs this editor's draft as a user preset "
                      "(compiled here, validated by the Pi's own loader, never soaked).",
        }

    # ---- assembly

    def build(self) -> dict:
        services = self._slow.get("services", {})
        aes67 = services.get("aes67", {}).get("state")
        gadget = services.get("gadget", {}).get("state")
        bridge = self._fast.get("bridge", {})
        running = aes67 == "active" and bridge.get("present") and (
            bridge.get("ageSeconds") is not None and bridge["ageSeconds"] < 15
        )
        if stack() == "dante":
            return self.build_dante(services, gadget)
        snapshot = {
            "ok": True,
            "generated": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
            "service": {"name": "usb16x16-web", "version": VERSION,
                        "uptimeSeconds": int(time.time() - self._started)},
            "host": socket.gethostname(),
            "audio": {"sampleRate": self._daemon.get("daemon", {}).get("sampleRate", 48000),
                      "inputs": 16, "outputs": 16},
            "stack": "aes67",
            "device": {"name": DEFAULT_DEVICE_NAME},
            "mode": {
                "actual": "direct",
                "running": bool(running),
                "detail": "Direct USB ↔ AoIP bridge" if running
                          else f"AES67 service {aes67 or 'unknown'}, USB gadget {gadget or 'unknown'}",
            },
            # Overridden by the fast tier's read of the bridge's snapshot file.
            "meters": {"available": False, "reason": "not yet read"},
            "dsp": self._dsp,
        }
        snapshot.update(self._fast)
        snapshot.update(self._slow)
        snapshot.update(self._daemon)
        return snapshot

    def build_dante(self, services: dict, gadget) -> dict:
        dante = services.get("dante", {}).get("state")
        statime = services.get("statime", {}).get("state")
        running = dante == "active"
        selected = (self._slow.get("profile") or {}).get("selected")
        if running:
            detail = ("USB ↔ Dante endpoint, direct" if selected in (None, DANTE_DIRECT)
                      else f"USB ↔ Dante endpoint with DSP preset {selected}")
        else:
            detail = f"Dante service {dante or 'unknown'}, clock {statime or 'unknown'}, USB gadget {gadget or 'unknown'}"
        # owner.conf's RATE= (absent is 48 kHz; profile.rate is None only when it is garbled).
        rate = (self._slow.get("profile") or {}).get("rate")
        snapshot = {
            "ok": True,
            "generated": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
            "service": {"name": "usb16x16-web", "version": VERSION,
                        "uptimeSeconds": int(time.time() - self._started)},
            "host": socket.gethostname(),
            "audio": {"sampleRate": rate if isinstance(rate, int) else 48000, "inputs": 16, "outputs": 16},
            "stack": "dante",
            "device": {"name": DEFAULT_DEVICE_NAME},
            "startCheck": {"state": "unknown", "rate": None, "restarts": None, "time": None},
            "clock": clock_state(statime, getattr(self, "_statime_loglevel", None), read_port_state(CLOCK_STATE_FILE)),
            "mode": {
                "actual": "direct" if selected in (None, DANTE_DIRECT) else "dsp",
                "running": bool(running),
                "detail": detail,
            },
            "meters": {"available": False, "reason": "not yet read"},
            "dsp": self._dsp,
            "owner": {"present": False},
        }
        snapshot.update(self._fast)
        snapshot.update(self._slow)
        snapshot.update(self._daemon)
        return snapshot

    def loop(self) -> None:
        _stack["name"] = detect_stack()
        self._dsp = self.collect_dsp()
        next_slow = 0.0
        next_daemon = 0.0
        while not self._stop.is_set():
            now = time.monotonic()
            try:
                self._fast = self.collect_fast()
                if now >= next_slow:
                    self._slow = self.collect_slow()
                    next_slow = now + SLOW_INTERVAL
                if now >= next_daemon:
                    self._daemon = self.collect_daemon()
                    next_daemon = now + DAEMON_INTERVAL
                snapshot = self.build()
            except Exception as error:  # never let the collector die
                snapshot = {"ok": False, "reason": f"collector error: {error}"}
            with self._lock:
                self._snapshot = snapshot
            self._stop.wait(FAST_INTERVAL)

    def snapshot(self) -> dict:
        with self._lock:
            return self._snapshot

    def stop(self) -> None:
        self._stop.set()


# ------------------------------------------------------------------ apply

# The id of the last request this process put in the inbox. The inbox cannot
# be listed from here, so "a request is pending" means that name is still
# there: the applier removes a request when it picks it up.
_last_request: dict = {"id": None}
_last_request_lock = threading.Lock()


def inbox_unwritable() -> str | None:
    """Why requests cannot be put in the inbox, or None when they can."""
    if not APPLY_INBOX.is_dir():
        return f"{APPLY_INBOX} does not exist; the Apply units are not installed"
    if not os.access(APPLY_INBOX, os.W_OK | os.X_OK):
        return (f"{APPLY_INBOX} is not writable by this service; it must be in the inbox's group "
                "(reinstall the Apply units)")
    return None


def apply_actions(available: bool, dante: bool, auth: bool) -> list[str]:
    """The System actions this unit can take now: none when Apply is not
    available (what apply_gate refuses on), no clock restart on the AES67
    stack (it has no separate clock service), no password change without
    sign-in (--no-auth)."""
    if not available:
        return []
    return [action for action in APPLY_ACTIONS
            if not (action == "restart-clock" and not dante) and not (action == "password" and not auth)]


def monitor_control(dante: bool, services: dict, apply_available: bool) -> dict:
    """control.monitor: whether the knobs work now (the Dante service active
    and the owner's status readable), and which of the two limits kinds the
    applier can take now (none when Apply is unavailable, as for
    control.apply.actions). The limits do not need the owner running."""
    if not dante:
        available, reason = False, "The monitor is the Dante endpoint's; this unit runs the AES67 stack."
    elif (services.get("dante") or {}).get("state") != "active":
        available, reason = False, f"The Dante service is {(services.get('dante') or {}).get('state') or 'unknown'}."
    else:
        status, reason = read_monitor_status()
        available = status is not None
    return {"available": available, "reason": "" if available else reason, "endpoint": "/api/monitor",
            "kinds": list(MONITOR_KINDS) if apply_available and dante else []}


def read_support_bundle(ident: str) -> bytes | None:
    """The support bundle the applier wrote for request <ident>, or None when
    it is not there or cannot be read. Only an id of the form SUPPORT_ID
    reaches the file name; the file is opened without following a link (and
    without blocking on anything that is not a regular file) and read to a
    bound."""
    if not isinstance(ident, str) or not SUPPORT_ID.fullmatch(ident):
        return None
    path = APPLY_STATE / "bundles" / f"{ident}.json"
    flags = os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_NONBLOCK", 0) | getattr(os, "O_CLOEXEC", 0)
    try:
        fd = os.open(path, flags)
    except OSError:
        return None
    try:
        info = os.fstat(fd)
        if not stat.S_ISREG(info.st_mode) or info.st_size > SUPPORT_BUNDLE_MAX:
            return None
        chunks, total = [], 0
        while total <= SUPPORT_BUNDLE_MAX:
            chunk = os.read(fd, min(1 << 16, SUPPORT_BUNDLE_MAX + 1 - total))
            if not chunk:
                break
            chunks.append(chunk)
            total += len(chunk)
        if total > SUPPORT_BUNDLE_MAX:
            return None   # grew while being read
        return b"".join(chunks)
    except OSError:
        return None
    finally:
        os.close(fd)


def apply_state() -> dict:
    """What the privileged applier last wrote, plus whether a request waits.
    current.json is passed through whole, so a receipt's kind, its bundle
    ({"file", "bytes"}) and the user of a password change reach the page."""
    state: dict = {"current": None, "pending": False, "inFlight": False}
    text = read_text(APPLY_STATE / "current.json", 1 << 18)
    if text:
        try:
            current = json.loads(text)
        except ValueError:
            current = None
        if isinstance(current, dict):
            state["current"] = current
            updated = parse_iso(current.get("updatedAt"))
            fresh = updated is not None and (time.time() - updated) < APPLY_STALE_SECONDS
            state["inFlight"] = current.get("state") not in APPLY_TERMINAL and fresh
    with _last_request_lock:
        ident = _last_request["id"]
    if ident:
        try:
            pending = (APPLY_INBOX / f"{ident}.request").stat()
            state["pending"] = (time.time() - pending.st_mtime) < REQUEST_MAX_AGE_SECONDS
        except OSError:
            pass
    return state


def artifact_shape(text: str) -> str | None:
    """The canonical shape text of a bridge artifact (every count and index,
    gains, delays and coefficients blanked; all 16 outputs in index order),
    line for line what bridge-artifact.mjs, usb16x16-apply and the bridge
    produce. None when the text is not an artifact. Read-only use here: the
    installed preset's shape key lets the page tell a live edit from one
    that needs Compile & apply without compiling the installed file itself."""
    lines = [line.strip() for line in text.split("\n") if line.strip()]
    at = 0
    try:
        def next_line() -> str:
            nonlocal at
            at += 1
            return lines[at - 1]
        def header(keyword: str) -> str:
            parts = next_line().split()
            if parts[0] != keyword or len(parts) != 2:
                raise ValueError(keyword)
            return parts[1]
        out = []
        if header("usb16x16-dsp") != "1":
            return None
        out.append("usb16x16-dsp-shape 1")
        if not next_line().startswith("preset"):
            return None
        for keyword in ("rate", "channels", "internal", "maxdelay"):
            out.append(f"{keyword} {header(keyword)}")
        def mix(keyword: str) -> None:
            rows = int(header(keyword))
            out.append(f"{keyword} {rows}")
            for _ in range(rows):
                parts = next_line().split()
                if len(parts) != 3:
                    raise ValueError(keyword)
                out.append(f"{parts[0]} {parts[1]}")
        mix("expand")
        branches = int(header("branch"))
        out.append(f"branch {branches}")
        for _ in range(branches):
            parts = next_line().split()
            if len(parts) != 2:
                raise ValueError("branch")
            out.append(f"{parts[0]} {parts[1]}")
            at += int(parts[1])
        mix("assign")
        per_output = [0] * 16
        for _ in range(int(header("output"))):
            parts = next_line().split()
            if len(parts) != 4 or int(parts[0]) >= 16:
                raise ValueError("output")
            per_output[int(parts[0])] = int(parts[3])
            at += int(parts[3])
        out.append("output 16")
        out.extend(f"{index} {sections}" for index, sections in enumerate(per_output))
        if next_line() != "end" or at != len(lines):
            return None
    except (ValueError, IndexError):
        return None
    out.append("end")
    return "\n".join(out) + "\n"


def shape_key(text: str) -> str | None:
    shape = artifact_shape(text)
    return None if shape is None else hashlib.sha256(shape.encode("utf-8")).hexdigest()


_shape_cache: dict = {}


def installed_shape(path: str) -> str | None:
    """The shape key of an installed preset file, cached on its mtime and size."""
    try:
        stat = os.stat(path)
    except OSError:
        return None
    stamp = (stat.st_mtime_ns, stat.st_size)
    hit = _shape_cache.get(path)
    if hit and hit[0] == stamp:
        return hit[1]
    text = read_text(Path(path), 1 << 18)
    key = shape_key(text) if text else None
    _shape_cache[path] = (stamp, key)
    return key


def read_live_status(now: float | None = None) -> dict:
    """The bridge's one-line answer to the last live file, under RUN_DIR:
    DSPLIVE gen= sha256= state=applied|refused|ignored|idle reason="" t_us=."""
    dante = stack() == "dante"
    path = (DANTE_RUN_DIR if dante else RUN_DIR) / "dsp-live.status"
    text = read_text(path, 4096)
    if not text or not text.startswith("DSPLIVE "):
        return {"available": False,
                "reason": "the Dante endpoint follows no live file (no preset is running)" if dante else
                          "the bridge has no live file (the profile does not set DSP_LIVE=1)"}
    fields: dict = {}
    for match in re.finditer(r'(\w+)=("([^"]*)"|\S+)', text[len("DSPLIVE "):]):
        fields[match.group(1)] = match.group(3) if match.group(3) is not None else match.group(2)
    try:
        age = (now if now is not None else time.time()) - path.stat().st_mtime
    except OSError:
        age = None
    gen = fields.get("gen")
    return {"available": True, "gen": int(gen) if gen and gen.isdigit() else None,
            "sha256": None if fields.get("sha256") in (None, "none") else fields.get("sha256"),
            "state": fields.get("state"), "reason": fields.get("reason", ""),
            "ageSeconds": None if age is None else round(age, 1)}


def preset_slug(name: str) -> str:
    """The <slug> of user-<slug> / dante-<slug> from a preset name: lower-case letters, digits and single
    dashes, at most 24 characters, the same rule the applier enforces."""
    slug = re.sub(r"[^a-z0-9]+", "-", name.lower()).strip("-")[:24].rstrip("-")
    return slug if USER_SLUG.match(slug) else ""


def rate_artifacts_from(body: dict, allowed: tuple[str, ...]) -> dict[str, bytes] | str:
    """A request's `rateArtifacts` {rate: artifact text} as bytes, or the reason it is refused."""
    given = body.get("rateArtifacts")
    if given is None:
        return {}
    if not isinstance(given, dict) or len(given) > len(allowed):
        return "rateArtifacts must map rates to artifact texts"
    found: dict[str, bytes] = {}
    for rate, text in given.items():
        if rate not in allowed:
            return f"rateArtifacts: {str(rate)[:12]} is not a rate this request carries ({', '.join(allowed)})"
        if not isinstance(text, str) or not text.startswith("usb16x16-dsp 1\n") or not text.endswith("end\n"):
            return f"rateArtifacts {rate}: not the compiler's bridge artifact text"
        data = text.encode("utf-8")
        if len(data) > PRESET_ARTIFACT_MAX:
            return f"rateArtifacts {rate}: larger than {PRESET_ARTIFACT_MAX} bytes"
        found[rate] = data
    return found


def write_inbox_file(name: str, data: bytes) -> None:
    """One file into the inbox, whole or not at all: written under <name>.tmp
    (created exclusively, never through a link, mode 0640), fsynced, then
    renamed to <name>."""
    temporary = APPLY_INBOX / f"{name}.tmp"
    fd = os.open(temporary, os.O_CREAT | os.O_EXCL | os.O_WRONLY | getattr(os, "O_NOFOLLOW", 0), 0o640)
    try:
        os.fchmod(fd, 0o640)   # whatever the umask
        with os.fdopen(fd, "wb") as handle:
            fd = -1
            handle.write(data)
            handle.flush()
            os.fsync(handle.fileno())
        os.rename(temporary, APPLY_INBOX / name)
    except BaseException:
        if fd >= 0:
            os.close(fd)
        try:
            os.unlink(temporary)
        except OSError:
            pass
        raise


def write_apply_request(profile: str, expected: str | None, user: str | None, extra: dict | None = None,
                        artifact: bytes | None = None, rate_artifacts: dict[str, bytes] | None = None) -> str:
    """The only write this process makes outside its preset store and the
    monitor's state (MonitorStore): the artifacts a request refers to (<id>.dsp, <id>-<rate>.dsp), then the
    request itself (<id>.request), each atomically, into the applier's
    inbox, which the installer creates. The request comes last, so the
    applier never finds one whose artifacts are not all there."""
    problem = inbox_unwritable()
    if problem:
        raise PermissionError(problem)
    ident = secrets.token_hex(8)
    payload = {"id": ident, "profile": profile, "expectedProfile": expected,
               "requestedAt": time.time(), "requestedBy": user}
    if extra:
        payload.update(extra)
    if artifact is not None:
        write_inbox_file(f"{ident}.dsp", artifact)
        payload["artifactFile"] = f"{ident}.dsp"
    if rate_artifacts:
        payload["rateArtifacts"] = {}
        for rate, data in sorted(rate_artifacts.items()):
            write_inbox_file(f"{ident}-{rate}.dsp", data)
            payload["rateArtifacts"][rate] = {"file": f"{ident}-{rate}.dsp", "sha256": hashlib.sha256(data).hexdigest()}
    write_inbox_file(f"{ident}.request", json.dumps(payload, indent=2).encode("utf-8"))
    with _last_request_lock:
        _last_request["id"] = ident
    return ident


# ------------------------------------------------------------------ monitor
#
# The monitor block (phase 3 of docs/web/REDESIGN-2026-11.md). Three files,
# whose formats docs/web/MONITOR-FILES.md fixes for this process, the applier
# and the owner alike:
#
#   state    MONITOR_RUN_DIR/state, written here on every change the page
#            posts, polled by the owner (which validates and clamps it); and
#            a remembered copy in MONITOR_STATE_DIR, written 2 s after the
#            last change. The third place this process writes, beside its
#            preset store and the inbox (ACCESS.md, "The monitor path").
#   limits   APPLY_STATE/monitor-limits, root's: the applier writes it on the
#            kinds monitor-limits and monitor-reference; read here.
#   status   DANTE_RUN_DIR/monitor.status, the owner's: what is in force and
#            the running preset's sets and outputs; read here.
#
# A knob move is a POST /api/monitor that rewrites the state file at once:
# no applier, no receipt.

MONITOR_RUN_DIR = Path("/run/usb-aoip-monitor")
MONITOR_STATE_DIR = Path("/var/lib/usb-aoip-monitor")
MONITOR_FILE = "state"
MONITOR_STATUS = DANTE_RUN_DIR / "monitor.status"
MONITOR_LIMITS = "monitor-limits"          # under APPLY_STATE
MONITOR_KINDS = ("monitor-limits", "monitor-reference")
MONITOR_FILE_MAX = 8192
MONITOR_STATUS_MAX = 16384
MONITOR_BODY_MAX = 4096
MONITOR_SETS_MAX = 16
MONITOR_PERSIST_S = 2.0                    # the remembered copy: this long after the last change
MONITOR_SET_ID = re.compile(r"[a-z][a-z0-9-]{0,31}")
MONITOR_FOLD = re.compile(r"[a-z0-9.]{1,16}")
_DB = r"-?[0-9]{1,3}\.[0-9]"
_ID = r"[a-z][a-z0-9-]{0,31}"
_FOLD = r"[a-z0-9.]{1,16}"
_TEXT = r'[ !#-\[\]-~]'                    # printable ASCII without " and \
_FLAGS = r"[01](?:,[01]){15}"
MONITOR_NOTE = re.compile(_TEXT + r"{0,64}")
MONITOR_LEVEL = (-60.0, 0.0)
MONITOR_TRIM = (-12.0, 12.0)
MONITOR_DIM = (-40.0, 0.0)
MONITOR_MAX = (-30.0, 0.0)
MONITOR_START_RULES = ("last", "reference", "fixed")
MONITOR_REF_DEFAULT = -10.0
MONITOR_SET_FIELDS = ("levelDb", "trimDb", "dim", "mute", "fold")
MONITOR_PATCH_KEYS = frozenset(("set", *MONITOR_SET_FIELDS, "active", "dimDb", "subs", "solo", "outMute", "clearSolo"))


class MonitorRefusal(Exception):
    """A request the monitor routes refuse: the HTTP status and why."""

    def __init__(self, status: int, message: str) -> None:
        super().__init__(message)
        self.status = status


def monitor_db(text: str, low: float, high: float) -> float:
    if not re.fullmatch(_DB, text):
        raise ValueError(f"{text[:16]!r} is not a number with one decimal")
    value = float(text) + 0.0
    if not low <= value <= high:
        raise ValueError(f"{text} is outside {low:.1f}..{high:.1f}")
    return value


def monitor_fmt(value: float) -> str:
    value = round(float(value), 1) + 0.0
    return f"{0.0 if value == 0 else value:.1f}"


def monitor_flags(text: str) -> list[bool]:
    return [flag == "1" for flag in text.split(",")]


def monitor_flag_text(flags: list[bool]) -> str:
    return ",".join("1" if flag else "0" for flag in flags)


def read_monitor_file(path: Path, cap: int) -> str:
    """A monitor file whole, by MONITOR-FILES.md's reading rules: no link
    followed, never blocking on a FIFO, a regular file of at most `cap`
    bytes, ASCII. Raises FileNotFoundError when nothing is there and
    ValueError (or OSError) for anything else that is wrong."""
    flags = os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_NONBLOCK", 0) | getattr(os, "O_CLOEXEC", 0)
    fd = os.open(path, flags)
    try:
        info = os.fstat(fd)
        if not stat.S_ISREG(info.st_mode):
            raise ValueError("not a regular file")
        chunks, total = [], 0
        while total <= cap:
            chunk = os.read(fd, cap + 1 - total)
            if not chunk:
                break
            chunks.append(chunk)
            total += len(chunk)
        if total > cap:
            raise ValueError(f"larger than {cap} bytes")
        return b"".join(chunks).decode("ascii")
    except UnicodeDecodeError:
        raise ValueError("not ASCII")
    finally:
        os.close(fd)


def write_monitor_file(path: Path, data: bytes) -> None:
    """MONITOR-FILES.md's writing rule: a temporary file beside `path`
    (O_EXCL, never through a link), mode 0644 whatever the umask (the
    service's UMask is 0027 and the owner's account must read it), fsync,
    rename."""
    temporary = path.with_name(f".{path.name}.{secrets.token_hex(8)}.tmp")
    fd = os.open(temporary, os.O_CREAT | os.O_EXCL | os.O_WRONLY | getattr(os, "O_NOFOLLOW", 0)
                 | getattr(os, "O_CLOEXEC", 0), 0o644)
    try:
        os.fchmod(fd, 0o644)
        with os.fdopen(fd, "wb") as handle:
            fd = -1
            handle.write(data)
            handle.flush()
            os.fsync(handle.fileno())
        os.rename(temporary, path)
    except BaseException:
        if fd >= 0:
            os.close(fd)
        try:
            os.unlink(temporary)
        except OSError:
            pass
        raise


def monitor_lines(text: str) -> list[str]:
    """The lines of a monitor file, which must end with end\\n and nothing after."""
    if not text.endswith("\nend\n"):
        raise ValueError("does not end with an end line")
    lines = text[:-1].split("\n")
    if any("\r" in line or "\t" in line for line in lines):
        raise ValueError("a line holds a carriage return or a tab")
    return lines


def empty_monitor_state() -> dict:
    return {"active": "all", "dimDb": -20.0, "subs": True, "sets": {},
            "solo": [False] * 16, "outMute": [False] * 16}


def parse_monitor_state(text: str) -> tuple[int, dict]:
    """(seq, state) from a state file's text; ValueError when it breaks any
    rule of MONITOR-FILES.md (a)."""
    lines = monitor_lines(text)
    at = 0

    def line(pattern: str, what: str):
        nonlocal at
        if at >= len(lines):
            raise ValueError(f"missing the {what} line")
        match = re.fullmatch(pattern, lines[at])
        if match is None:
            raise ValueError(f"line {at + 1} is not the {what} line")
        at += 1
        return match

    seq = int(line(r"MONITOR-STATE v=1 seq=([0-9]{1,18})", "header").group(1))
    active = line(rf"active=(all|{_ID})", "active").group(1)
    state = empty_monitor_state()
    state["dimDb"] = monitor_db(line(rf"dim_db=({_DB})", "dim_db").group(1), *MONITOR_DIM)
    state["subs"] = line(r"subs=(on|off)", "subs").group(1) == "on"
    set_line = rf"set id=({_ID}) level_db=({_DB}) trim_db=({_DB}) dim=([01]) mute=([01]) fold=({_FOLD})"
    while at < len(lines) and lines[at].startswith("set "):
        match = line(set_line, "set")
        ident = match.group(1)
        if ident in state["sets"]:
            raise ValueError(f"set {ident} is listed twice")
        if len(state["sets"]) >= MONITOR_SETS_MAX:
            raise ValueError(f"more than {MONITOR_SETS_MAX} sets")
        state["sets"][ident] = {"levelDb": monitor_db(match.group(2), *MONITOR_LEVEL),
                                "trimDb": monitor_db(match.group(3), *MONITOR_TRIM),
                                "dim": match.group(4) == "1", "mute": match.group(5) == "1",
                                "fold": match.group(6)}
    if active != "all" and active not in state["sets"]:
        raise ValueError(f"the active set {active} is not listed")
    state["active"] = active
    state["solo"] = monitor_flags(line(rf"solo=({_FLAGS})", "solo").group(1))
    state["outMute"] = monitor_flags(line(rf"mute=({_FLAGS})", "mute").group(1))
    line("end", "end")
    if at != len(lines):
        raise ValueError("lines after end")
    return seq, state


def render_monitor_state(seq: int, state: dict) -> str:
    lines = [f"MONITOR-STATE v=1 seq={seq}", f"active={state['active']}", f"dim_db={monitor_fmt(state['dimDb'])}",
             f"subs={'on' if state['subs'] else 'off'}"]
    for ident, values in state["sets"].items():
        lines.append(f"set id={ident} level_db={monitor_fmt(values['levelDb'])} trim_db={monitor_fmt(values['trimDb'])} "
                     f"dim={int(values['dim'])} mute={int(values['mute'])} fold={values['fold']}")
    lines += [f"solo={monitor_flag_text(state['solo'])}", f"mute={monitor_flag_text(state['outMute'])}", "end"]
    return "\n".join(lines) + "\n"


def default_monitor_limits() -> dict:
    return {"maxDb": 0.0, "start": "last", "startDb": -30.0, "lock": False, "refs": {}}


def parse_monitor_limits(text: str) -> dict:
    """The limits file (MONITOR-FILES.md (b)); ValueError when it breaks a
    rule. start_db and the references come back clamped to max_db."""
    lines = monitor_lines(text)
    if len(lines) < 6:
        raise ValueError("too few lines")
    patterns = (r"MONITOR-LIMITS v=1", rf"max_db=({_DB})", r"start=(last|reference|fixed)", rf"start_db=({_DB})",
                r"lock=([01])")
    found = []
    for index, pattern in enumerate(patterns):
        match = re.fullmatch(pattern, lines[index])
        if match is None:
            raise ValueError(f"line {index + 1} is not what MONITOR-LIMITS has there")
        found.append(match)
    limits = {"maxDb": monitor_db(found[1].group(1), *MONITOR_MAX), "start": found[2].group(1),
              "startDb": monitor_db(found[3].group(1), *MONITOR_LEVEL), "lock": found[4].group(1) == "1", "refs": {}}
    for index, text_line in enumerate(lines[5:-1], start=6):
        match = re.fullmatch(rf'ref id=({_ID}) level_db=({_DB}) note="({_TEXT}{{0,64}})"', text_line)
        if match is None:
            raise ValueError(f"line {index} is not a ref line")
        if match.group(1) in limits["refs"]:
            raise ValueError(f"ref {match.group(1)} is listed twice")
        if len(limits["refs"]) >= MONITOR_SETS_MAX:
            raise ValueError(f"more than {MONITOR_SETS_MAX} refs")
        limits["refs"][match.group(1)] = {"levelDb": min(monitor_db(match.group(2), *MONITOR_LEVEL), limits["maxDb"]),
                                          "note": match.group(3)}
    if lines[-1] != "end":
        raise ValueError("does not end with an end line")
    limits["startDb"] = min(limits["startDb"], limits["maxDb"])
    return limits


def read_monitor_limits() -> dict:
    """root's limits, with `file`: absent, present or invalid (an invalid
    file reads as the defaults, as it does for the owner)."""
    try:
        limits = parse_monitor_limits(read_monitor_file(APPLY_STATE / MONITOR_LIMITS, MONITOR_FILE_MAX))
        limits["file"] = "present"
    except FileNotFoundError:
        limits = {**default_monitor_limits(), "file": "absent"}
    except (OSError, ValueError):
        limits = {**default_monitor_limits(), "file": "invalid"}
    return limits


def parse_monitor_status(text: str) -> dict:
    """The owner's status file (MONITOR-FILES.md (c)); ValueError when any
    of it breaks a rule. gain_db -inf comes back as None."""
    lines = monitor_lines(text)
    at = 0

    def line(pattern: str, what: str):
        nonlocal at
        if at >= len(lines):
            raise ValueError(f"missing the {what} line")
        match = re.fullmatch(pattern, lines[at])
        if match is None:
            raise ValueError(f"line {at + 1} is not the {what} line")
        at += 1
        return match

    head = line(r"MONITOR v=1 gen=([0-9]{1,18}) seq=([0-9]{1,18}|none) state=(idle|start|applied|refused) "
                rf'reason="({_TEXT}{{0,128}})" t_us=([0-9]{{1,20}})', "header")
    active = line(rf"active=(all|{_ID})", "active").group(1)
    dims = line(rf"dim_db=({_DB}) subs=(on|off)", "dim_db")
    status = {"gen": int(head.group(1)), "seq": None if head.group(2) == "none" else int(head.group(2)),
              "state": head.group(3), "reason": head.group(4), "tUs": int(head.group(5)), "active": active,
              "dimDb": monitor_db(dims.group(1), *MONITOR_DIM), "subs": dims.group(2) == "on",
              "sets": [], "outputs": []}
    set_line = (rf"set id=({_ID}) kind=(speakers|headphones) level_db=({_DB}) trim_db=({_DB}) dim=([01]) mute=([01]) "
                rf"fold=({_FOLD}) folds=({_FOLD}(?:,{_FOLD}){{0,7}}) gain_db=({_DB}|-inf)")
    ids = set()
    while at < len(lines) and lines[at].startswith("set "):
        match = line(set_line, "set")
        ident, folds = match.group(1), match.group(8).split(",")
        if ident in ids:
            raise ValueError(f"set {ident} is listed twice")
        if len(ids) >= MONITOR_SETS_MAX:
            raise ValueError(f"more than {MONITOR_SETS_MAX} sets")
        if len(set(folds)) != len(folds) or "full" not in folds or match.group(7) not in folds:
            raise ValueError(f"set {ident}: folds must be distinct, include full and the set's fold")
        gain = match.group(9)
        ids.add(ident)
        status["sets"].append({"id": ident, "kind": match.group(2),
                               "levelDb": monitor_db(match.group(3), *MONITOR_LEVEL),
                               "trimDb": monitor_db(match.group(4), *MONITOR_TRIM),
                               "dim": match.group(5) == "1", "mute": match.group(6) == "1",
                               "fold": match.group(7), "folds": folds,
                               "gainDb": None if gain == "-inf" else float(gain) + 0.0})
    if active != "all" and active not in ids:
        raise ValueError(f"the active set {active} is not listed")
    pairs = set()
    while at < len(lines) and lines[at].startswith("out "):
        match = line(rf'out n=([0-9]{{1,2}}) set=({_ID}) role=(speaker|sub) label="({_TEXT}{{0,64}})"', "out")
        number, owner_set = int(match.group(1)), match.group(2)
        if number > 15 or owner_set not in ids or (number, owner_set) in pairs or len(pairs) >= 64:
            raise ValueError(f"line {at}: output {number} of {owner_set} is out of range, unknown or repeated")
        pairs.add((number, owner_set))
        status["outputs"].append({"n": number, "set": owner_set, "role": match.group(3), "label": match.group(4)})
    arrays = line(rf"solo=({_FLAGS}) mute=({_FLAGS})", "solo")
    status["solo"], status["outMute"] = monitor_flags(arrays.group(1)), monitor_flags(arrays.group(2))
    line("end", "end")
    if at != len(lines):
        raise ValueError("lines after end")
    return status


_monitor_status_cache: dict = {"identity": None, "status": None, "reason": ""}
_monitor_status_lock = threading.Lock()


def read_monitor_status() -> tuple[dict | None, str]:
    """The owner's status, parsed once per file version (stat, then a read
    only when it changed, as read_meters does), and why it is None."""
    try:
        info = os.stat(MONITOR_STATUS)
    except OSError:
        return None, "The Dante endpoint has written no monitor status: its preset has no monitor block, or it is not running."
    identity = (info.st_mtime_ns, info.st_size, info.st_ino)
    with _monitor_status_lock:
        if _monitor_status_cache["identity"] != identity:
            try:
                status, reason = parse_monitor_status(read_monitor_file(MONITOR_STATUS, MONITOR_STATUS_MAX)), ""
            except (OSError, ValueError) as error:
                status, reason = None, f"The monitor status could not be read: {error}"
            _monitor_status_cache.update(identity=identity, status=status, reason=reason)
        return _monitor_status_cache["status"], _monitor_status_cache["reason"]


def monitor_available(snapshot: dict) -> tuple[dict | None, str]:
    """The owner's status when the monitor can be driven, and why not: the
    Dante stack, its service active (the collector's last look) and a status
    file that reads whole. An old status is not a stale one: the owner
    writes it only on a change."""
    if stack() != "dante":
        return None, "The monitor is the Dante endpoint's; this unit runs the AES67 stack."
    unit = (((snapshot.get("services") or {}).get("dante")) or {}).get("state")
    if unit != "active":
        return None, f"The Dante service is {unit or 'unknown'}."
    return read_monitor_status()


def monitor_effective(status: dict) -> dict:
    return {"gen": status["gen"], "seq": status["seq"], "state": status["state"], "reason": status["reason"],
            "tUs": status["tUs"], "active": status["active"], "dimDb": status["dimDb"], "subs": status["subs"],
            "sets": {s["id"]: {k: s[k] for k in ("kind", "levelDb", "trimDb", "dim", "mute", "fold", "gainDb")}
                     for s in status["sets"]},
            "solo": status["solo"], "outMute": status["outMute"]}


def monitor_topology(status: dict) -> dict:
    return {"sets": [{"id": s["id"], "kind": s["kind"], "folds": s["folds"],
                      "outputs": [{"n": o["n"], "role": o["role"], "label": o["label"]}
                                  for o in status["outputs"] if o["set"] == s["id"]]}
                     for s in status["sets"]]}


def monitor_number(body: dict, key: str, low: float, high: float) -> float:
    value = body[key]
    try:
        ok = not isinstance(value, bool) and isinstance(value, (int, float)) and math.isfinite(float(value))
    except OverflowError:
        ok = False
    if not ok or not low <= float(value) <= high:
        raise MonitorRefusal(HTTPStatus.BAD_REQUEST, f"{key} must be a number from {low:g} to {high:g}")
    return round(float(value), 1) + 0.0


def monitor_bool(body: dict, key: str) -> bool:
    if not isinstance(body[key], bool):
        raise MonitorRefusal(HTTPStatus.BAD_REQUEST, f"{key} must be true or false")
    return body[key]


def monitor_patch(body, status: dict) -> dict:
    """A POST /api/monitor body checked and normalised, against the running
    preset's sets: 400 for a body of the wrong form, 409 for a set, fold or
    active set the running preset does not have."""
    if not isinstance(body, dict) or not body:
        raise MonitorRefusal(HTTPStatus.BAD_REQUEST, "Send a JSON object naming at least one change")
    unknown = sorted(str(key)[:24] for key in body if key not in MONITOR_PATCH_KEYS)
    if unknown:
        raise MonitorRefusal(HTTPStatus.BAD_REQUEST, f"unknown key {unknown[0]!r}")
    patch: dict = {}
    fields = [key for key in MONITOR_SET_FIELDS if key in body]
    sets = {s["id"]: s for s in status["sets"]}
    if "set" in body:
        ident = body["set"]
        if not isinstance(ident, str) or not MONITOR_SET_ID.fullmatch(ident):
            raise MonitorRefusal(HTTPStatus.BAD_REQUEST, "set must be a set id")
        if not fields:
            raise MonitorRefusal(HTTPStatus.BAD_REQUEST, f"set needs one of {', '.join(MONITOR_SET_FIELDS)}")
        patch["set"] = ident
        if "levelDb" in body:
            patch["levelDb"] = monitor_number(body, "levelDb", *MONITOR_LEVEL)
        if "trimDb" in body:
            patch["trimDb"] = monitor_number(body, "trimDb", *MONITOR_TRIM)
        for key in ("dim", "mute"):
            if key in body:
                patch[key] = monitor_bool(body, key)
        if "fold" in body:
            if not isinstance(body["fold"], str) or not MONITOR_FOLD.fullmatch(body["fold"]):
                raise MonitorRefusal(HTTPStatus.BAD_REQUEST, "fold must be a fold name")
            patch["fold"] = body["fold"]
    elif fields:
        raise MonitorRefusal(HTTPStatus.BAD_REQUEST, f"{fields[0]} needs set")
    if "active" in body:
        active = body["active"]
        if not isinstance(active, str) or not (active == "all" or MONITOR_SET_ID.fullmatch(active)):
            raise MonitorRefusal(HTTPStatus.BAD_REQUEST, 'active must be a set id or "all"')
        patch["active"] = active
    if "dimDb" in body:
        patch["dimDb"] = monitor_number(body, "dimDb", *MONITOR_DIM)
    if "subs" in body:
        patch["subs"] = monitor_bool(body, "subs")
    for key in ("solo", "outMute"):
        if key in body:
            value = body[key]
            if not isinstance(value, list) or len(value) != 16 or not all(isinstance(v, bool) for v in value):
                raise MonitorRefusal(HTTPStatus.BAD_REQUEST, f"{key} must be 16 true or false values")
            patch[key] = list(value)
    if "clearSolo" in body:
        if body["clearSolo"] is not True:
            raise MonitorRefusal(HTTPStatus.BAD_REQUEST, "clearSolo must be true")
        if "solo" in body:
            raise MonitorRefusal(HTTPStatus.BAD_REQUEST, "clearSolo and solo together: send one")
        patch["solo"] = [False] * 16
    # Against the running preset.
    if "set" in patch:
        if patch["set"] not in sets:
            raise MonitorRefusal(HTTPStatus.CONFLICT, f"The running preset has no monitor set {patch['set']}; reload")
        if "fold" in patch and patch["fold"] not in sets[patch["set"]]["folds"]:
            raise MonitorRefusal(HTTPStatus.CONFLICT, f"Set {patch['set']} offers no fold {patch['fold']}")
    if patch.get("active") not in (None, "all") and patch["active"] not in sets:
        raise MonitorRefusal(HTTPStatus.CONFLICT, f"The running preset has no monitor set {patch['active']}; reload")
    return patch


class MonitorStore:
    """The state the page asks for, in memory and in the state file.

    Starts from the run file (it survives a restart of this service), else
    from the remembered copy, which is NOT then written to the run file: after
    a boot the owner's start rule decides, and while no run file exists a
    status of state=start is taken as the state (adopt). The run file is
    written on a POST only. The remembered copy follows MONITOR_PERSIST_S
    after the last change (tick), with solo cleared, and on a clean stop
    (flush). `clock` is injectable for the tests."""

    def __init__(self, run_dir: Path, state_dir: Path, clock=time.monotonic) -> None:
        self.run_path = run_dir / MONITOR_FILE
        self.keep_path = state_dir / MONITOR_FILE
        self.clock = clock
        self._lock = threading.Lock()
        self.state = empty_monitor_state()
        self.seq = 0
        self.run_written = False    # a valid run file is ours: never adopt the owner's start again
        self.dirty = False          # a change the remembered copy lacks
        self.last_change = 0.0      # clock() of the last change
        self.load()

    def load(self) -> None:
        for path, is_run in ((self.run_path, True), (self.keep_path, False)):
            try:
                seq, state = parse_monitor_state(read_monitor_file(path, MONITOR_FILE_MAX))
            except FileNotFoundError:
                continue
            except (OSError, ValueError) as error:
                print(f"monitor: {path} discarded: {error}", file=sys.stderr, flush=True)
                continue
            if not is_run:
                state["solo"] = [False] * 16
            self.seq, self.state, self.run_written = seq, state, is_run
            return

    def adopt(self, status: dict | None) -> None:
        """While no run file of ours exists, an owner that computed its own
        start (state=start) is followed: its active set and each set's level,
        trim, dim, mute and fold become the state. Caller holds the lock."""
        if self.run_written or not status or status["state"] != "start":
            return
        for row in status["sets"]:
            self.state["sets"][row["id"]] = {key: row[key] for key in MONITOR_SET_FIELDS}
        self.state["active"] = status["active"]

    def view(self, status: dict | None) -> tuple[dict, int]:
        with self._lock:
            self.adopt(status)
            return json.loads(json.dumps(self.state)), self.seq

    @staticmethod
    def seeded(state: dict, status: dict) -> dict:
        """A copy of `state` holding every set of the running preset (a new
        one at the owner's values), and at most MONITOR_SETS_MAX sets: the
        remembered ones of other presets go first, oldest first."""
        state = json.loads(json.dumps(state))
        running = [row["id"] for row in status["sets"]]
        for row in status["sets"]:
            if row["id"] not in state["sets"]:
                state["sets"][row["id"]] = {key: row[key] for key in MONITOR_SET_FIELDS}
        for ident in [i for i in state["sets"] if i not in running]:
            if len(state["sets"]) <= MONITOR_SETS_MAX:
                break
            del state["sets"][ident]
        if state["active"] != "all" and state["active"] not in state["sets"]:
            state["active"] = "all"
        return state

    def change(self, patch: dict, status: dict, max_db: float) -> tuple[dict, int]:
        """Merge a checked patch, write the run file, and return the state.
        A level above max_db is lowered to it (the owner enforces the limit;
        this is so the page shows what will play). OSError when the run file
        cannot be written: nothing is changed then."""
        with self._lock:
            self.adopt(status)
            state = self.seeded(self.state, status)
            if "set" in patch:
                row = state["sets"][patch["set"]]
                for key in MONITOR_SET_FIELDS:
                    if key in patch:
                        row[key] = patch[key]
                if "levelDb" in patch:
                    row["levelDb"] = min(row["levelDb"], max_db)
            for key in ("active", "dimDb", "subs", "solo", "outMute"):
                if key in patch:
                    state[key] = patch[key]
            seq = self.seq + 1
            write_monitor_file(self.run_path, render_monitor_state(seq, state).encode("ascii"))
            self.state, self.seq, self.run_written = state, seq, True
            self.dirty, self.last_change = True, self.clock()
            return json.loads(json.dumps(state)), seq

    def remembered_text(self) -> bytes:
        return render_monitor_state(self.seq, {**self.state, "solo": [False] * 16}).encode("ascii")

    def tick(self) -> bool:
        """Write the remembered copy once MONITOR_PERSIST_S has passed since
        the last change. True when it wrote."""
        with self._lock:
            if not self.dirty or self.clock() - self.last_change < MONITOR_PERSIST_S:
                return False
            return self._persist()

    def flush(self) -> bool:
        """On a clean stop: the remembered copy now, if a change is unwritten."""
        with self._lock:
            return self.dirty and self._persist()

    def _persist(self) -> bool:
        try:
            write_monitor_file(self.keep_path, self.remembered_text())
        except OSError as error:
            print(f"monitor: could not write {self.keep_path}: {error}", file=sys.stderr, flush=True)
            self.last_change = self.clock()    # try again a period later, not on every tick
            return False
        self.dirty = False
        return True

    def run(self, stop: threading.Event, period: float = 0.5) -> None:
        while not stop.wait(period):
            self.tick()


