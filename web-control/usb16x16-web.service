[Unit]
Description=USB-AoIP web control service
Documentation=file:///home/bdimaio/usb-16x16-work/web-control/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bdimaio
Group=bdimaio
# Reads the audio services' journal for the page's log panel.
SupplementaryGroups=systemd-journal
# The installer writes web.env: the TLS certificate and an explicit bind
# address, when install.conf sets them (USB_AOIP_WEB_ARGS).
EnvironmentFile=-/etc/usb-aoip/web.env
ExecStart=/usr/local/bin/usb16x16-web \
  --static /home/bdimaio/usb-16x16-work/web-ui \
  --presets /home/bdimaio/usb-16x16-work/web-presets \
  --auth-file /etc/usb-aoip/web-auth \
  --management-interface wlan0 \
  --port 8088 $USB_AOIP_WEB_ARGS
# With no address on the management interface yet the service exits 75 and is
# started again, instead of listening where nobody can reach it.
Restart=on-failure
RestartSec=5

# The service refuses to start with no users in the login file, so a missing or
# unreadable file fails closed rather than serving open. The file is root's,
# readable by this service's group; add a login with:
#   sudo install/install.sh set-password NAME

# The audio stack owns this machine. This service is background work: it must
# never win a CPU or IO contest against the bridge, and it must not be able to
# change anything outside three places: its own preset directory; the request
# inbox, a root-owned directory it can drop files into and cannot list (a
# request there is what usb16x16-apply.path acts on as root); and the monitor's
# state, /run/usb-aoip-monitor and its remembered copy in
# /var/lib/usb-aoip-monitor, which systemd makes for this service (and, under
# ProtectSystem=strict, writable by it alone). The Dante endpoint polls that
# file as untrusted input and clamps it to limits only the applier writes
# (docs/web/ACCESS.md, "The monitor path"). Both directories are 0755 and the
# service writes its files 0644 despite the UMask below, so the endpoint's
# account can read them; the run directory is kept across a restart of this
# service, so the state is read back rather than lost.
Nice=15
IOSchedulingClass=idle
CPUWeight=20
MemoryMax=192M
TasksMax=64

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/bdimaio/usb-16x16-work/web-presets /var/spool/usb-aoip/inbox
RuntimeDirectory=usb-aoip-monitor
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
StateDirectory=usb-aoip-monitor
StateDirectoryMode=0755
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native
CapabilityBoundingSet=
ProtectClock=yes
ProtectHostname=yes
ProtectKernelLogs=yes
RestrictNamespaces=yes
RemoveIPC=yes
UMask=0027

[Install]
WantedBy=multi-user.target
