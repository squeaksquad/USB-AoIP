+  // then the supported rates. Sent at start, every minute and on any 0x0081.
+  async fn send_sample_rate_status(&mut self) {
+    if self.self_info.supported_sample_rates.is_empty() {
+      return;
+    }
+    let mut bytes = ByteBuffer::new();
+    bytes.set_endian(bytebuffer::Endian::BigEndian);
+    bytes.write_u16(0x0018);
+    bytes.write_u16(self.self_info.supported_sample_rates.len() as u16);
+    bytes.write_u32(self.self_info.sample_rate);
+    bytes.write_u32(self.self_info.sample_rate);
