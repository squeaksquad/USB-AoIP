+    bytes.write_u32(bits);
+    bytes.write_u32(0x0002_0000);
+    bytes.write_u32(bits);
+    self
+      .send(self.device_info_destination, 0xffff, [0x07, 0x2a, 0x00, 0x82, 0, 0, 0, 0], bytes.as_bytes())
+      .await;
+  }
