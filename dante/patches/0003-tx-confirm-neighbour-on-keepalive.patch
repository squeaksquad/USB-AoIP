+// usb16x16 patch 0003: tell the kernel the receiver is reachable when it has just proved it.
+// A receiver's keepalive is that proof. Without it the neighbour entry of a receiver that
+// does not answer unicast ARP probes (a Ferrofish Pulse 16 DX, 2026-10-11) fails every few
+// seconds and is resolved again by broadcast, and every packet of every flow to it waits for
+// the reply: usually a fraction of a millisecond, now and then 5 to 10 ms, which the receiver
+// discards as late. MSG_CONFIRM on a send keeps the entry reachable, so it is never probed.
+extern "C" {
+  fn send(socket: i32, buffer: *const u8, length: usize, flags: i32) -> isize;
+}
+const MSG_CONFIRM: i32 = 0x800;
+
+fn send_confirming(socket: &UdpSocket, packet: &[u8]) -> std::io::Result<usize> {
+  let sent = unsafe { send(socket.as_raw_fd(), packet.as_ptr(), packet.len(), MSG_CONFIRM) };
+  if sent < 0 {
+    Err(std::io::Error::last_os_error())
+  } else {
+    Ok(sent as usize)
+  }
+}
