#!/usr/bin/env node
// Compile a USB 16x16 UI preset into a CamillaDSP configuration.
//
// Offline only. It reads a preset, writes YAML and a report, and exits. It does
// not talk to the Pi, start an engine, or apply anything.

import { readFileSync, writeFileSync } from 'node:fs';
import { parsePreset } from '../web-ui/model.mjs';
import { compile, fileDevices, alsaDevices, SAMPLE_RATE } from './compile.mjs';
import { toYaml } from './yaml.mjs';
import { bridgeArtifact, delayLatency } from './bridge-artifact.mjs';

const usage = `usage: usb16x16-dsp-compile PRESET.json [options]

  -o, --out FILE          write the configuration here (default: stdout)
      --report FILE       also write the JSON report here
      --bridge FILE       also write the bridge's coefficient artifact here
      --shape minimal|fixed
                          minimal (default) emits only what shapes the audio;
                          fixed pads every band and row so value edits keep the
                          artifact's shape (LIVE_COEFFICIENTS_DESIGN.md)
      --target file|alsa  device section to emit (default: file)
      --in FILE           file target: raw 16-channel input  (default: in.raw)
      --raw FILE          file target: raw 16-channel output (default: out.raw)
      --format FMT        sample format (default: S32_LE for file, S24_3_LE for alsa)
      --capture DEVICE    alsa target: capture device
      --playback DEVICE   alsa target: playback device
      --chunksize N       frames per chunk (default: 1024)
      --rate HZ           sample rate to compile for, a Dante rate (default: 48000);
                          the artifact names it and the Pi refuses it at any other
`;

function parseArgs(argv) {
  const options = {target: 'file', in: 'in.raw', raw: 'out.raw', chunksize: 1024, shape: 'minimal', rate: SAMPLE_RATE};
  const rest = [];
  for (let i = 0; i < argv.length; i += 1) {
    const arg = argv[i];
    const take = () => {
      const value = argv[i + 1];
      if (value === undefined) throw new Error(`${arg} needs a value`);
      i += 1;
      return value;
    };
    if (arg === '-h' || arg === '--help') { process.stdout.write(usage); process.exit(0); }
    else if (arg === '-o' || arg === '--out') options.out = take();
    else if (arg === '--report') options.report = take();
    else if (arg === '--bridge') options.bridge = take();
    else if (arg === '--shape') options.shape = take();
    else if (arg === '--target') options.target = take();
    else if (arg === '--in') options.in = take();
    else if (arg === '--raw') options.raw = take();
    else if (arg === '--format') options.format = take();
    else if (arg === '--capture') options.capture = take();
    else if (arg === '--playback') options.playback = take();
    else if (arg === '--chunksize') options.chunksize = Number(take());
    else if (arg === '--rate') options.rate = Number(take());
    else if (arg.startsWith('-')) throw new Error(`Unknown option ${arg}`);
    else rest.push(arg);
  }
  if (rest.length !== 1) throw new Error('Give exactly one preset file');
  options.preset = rest[0];
  return options;
}

function main() {
  let options;
  try { options = parseArgs(process.argv.slice(2)); }
  catch (error) { process.stderr.write(`${error.message}\n\n${usage}`); return 2; }

  let preset;
  try { preset = parsePreset(readFileSync(options.preset, 'utf8')); }
  catch (error) { process.stderr.write(`Could not read preset: ${error.message}\n`); return 3; }

  let devices;
  if (options.target === 'file') {
    devices = fileDevices(options.in, options.raw, options.format || 'S32_LE', options.chunksize, options.rate);
  } else if (options.target === 'alsa') {
    if (!options.capture || !options.playback) {
      process.stderr.write('The alsa target needs --capture and --playback.\n');
      return 2;
    }
    devices = alsaDevices(options.capture, options.playback, options.format || 'S24_3_LE', options.chunksize, options.rate);
  } else {
    process.stderr.write(`Unknown target ${options.target}\n`);
    return 2;
  }

  let result;
  try { result = compile(preset, devices, {shape: options.shape}); }
  catch (error) { process.stderr.write(`Could not compile: ${error.message}\n`); return 4; }

  const header = [
    'Generated by usb16x16-dsp-compile. Do not edit; edit the preset and recompile.',
    `Preset: ${result.report.preset}`,
    `Internal channels: ${result.report.internalChannels}`
      + ` (${result.plan.channels.filter(c => c.kind === 'main').length} main,`
      + ` ${result.plan.channels.filter(c => c.kind === 'bass').length} bass,`
      + ` ${result.plan.channels.filter(c => c.kind === 'phones').length} headphone)`,
    `Filters: ${result.report.biquadCount} PEQ biquads, ${result.report.crossoverCount} crossover combos`
      + (result.report.shape === 'fixed' ? `, ${result.report.placeholderCount} unity placeholders (fixed shape)` : ''),
    `Headroom: ${result.report.headroomDb} dB, applied once in the expand mixer`,
    '',
    'Filter steps before the "assign" mixer index the internal channels below;',
    'steps after it index the 16 physical outputs. The two numberings overlap,',
    'and are told apart only by position in the pipeline.',
    '',
    'Internal channel map:',
    ...result.report.channelMap.map(entry =>
      entry.kind === 'phones'
        ? `  ${entry.index}: headphones ${entry.busId} ear ${entry.ear + 1}`
        : `  ${entry.index}: ${entry.kind} branch of input ${entry.input + 1}`
          + (entry.lfe ? ' (LFE)' : '')),
  ];
  if (options.target === 'alsa') {
    header.push('',
      'ALSA target: capture and playback devices, clock ownership and rate',
      'matching have NOT been validated. The accepted transport remains the',
      'existing bridge; see work/web-ui/README.md, "Mode integration decisions".');
  }

  const yaml = toYaml(result.config, header);
  if (options.out) writeFileSync(options.out, yaml);
  else process.stdout.write(yaml);
  // Emitted from the same compilation as the YAML, never a second one, so the
  // two cannot describe different pipelines.
  if (options.bridge) {
    try { writeFileSync(options.bridge, bridgeArtifact(result, {presetName: preset.name})); }
    catch (error) { process.stderr.write(`Could not write the bridge artifact: ${error.message}\n`); return 4; }
  }
  const latency = delayLatency(preset, options.rate);
  if (latency.text) result.report.warnings.push(latency.text);
  result.report.delayLatency = latency;
  if (options.report) writeFileSync(options.report, `${JSON.stringify(result.report, null, 2)}\n`);

  for (const warning of result.report.warnings) process.stderr.write(`warning: ${warning}\n`);
  const clipping = result.report.worstCaseDbfs.some(level => level !== null && level > 0);
  return clipping ? 1 : 0;
}

process.exit(main());
