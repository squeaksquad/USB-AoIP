#!/bin/bash
# Start usb16x16-dante-owner the way /etc/usb16x16/dante/owner.conf says:
# the unit's ExecStart once the owner has DSP. The unit keeps the user, the
# capabilities and the environment; this only turns the configuration into
# the owner's command line and execs it, so the owner is the unit's main
# process as before.
#
#   usb16x16-dante-start            exec the owner
#   usb16x16-dante-start --print    print the command line, one argument a line, and exit
#
# owner.conf is KEY=value lines, read, never sourced. Every key is optional;
# with no file at all the command line is the one the unit carried before
# there was a configuration (direct, no meters).
#
#   METERS=0|1         1: --meter-file /run/usb16x16-dante/meters.txt
#   DSP_PRESET=PATH    a coefficient artifact under /etc/usb16x16/dsp/; empty: direct
#   DSP_SHA256=HEX     required with DSP_PRESET: the file must hash to this
#   DSP_LIVE=0|1       1: follow /run/usb16x16-dante/dsp-live.dsp (needs DSP_PRESET)
#   RATE=HZ            --rate HZ, a Dante rate; absent: the owner's 48000. DSP_PRESET
#                      must then be the artifact compiled for it (the owner refuses
#                      another); the applier writes the two together
#
# A configuration that cannot be honoured is a refusal (exit 2), never a
# quieter start: a system set up with crossovers must not come up without
# them. The unit does not restart on exit 2.
set -euo pipefail

conf=${USB16X16_DANTE_CONF:-/etc/usb16x16/dante/owner.conf}
owner=${USB16X16_DANTE_OWNER:-/usr/local/libexec/usb16x16-dante/usb16x16-dante-owner}
dsp_dir=${USB16X16_DSP_DIR:-/etc/usb16x16/dsp}
run_dir=${USB16X16_DANTE_RUN_DIR:-/run/usb16x16-dante}
state_dir=${USB16X16_DANTE_STATE_DIR:-/var/lib/usb16x16-dante}
refuse() { echo "usb16x16-dante-start: REFUSED: $*" >&2; exit 2; }

meters=0
preset=
preset_sha=
live=0
rate=
if [ -e "$conf" ]; then
  [ -r "$conf" ] || refuse "$conf cannot be read"
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in ''|'#'*) continue ;; esac
    [[ $line =~ ^([A-Z0-9_]+)=(.*)$ ]] || refuse "$conf: not KEY=value: $line"
    key=${BASH_REMATCH[1]}
    value=${BASH_REMATCH[2]}
    case "$key" in
      METERS)     [[ $value =~ ^[01]$ ]] || refuse "METERS must be 0 or 1"; meters=$value ;;
      DSP_LIVE)   [[ $value =~ ^[01]$ ]] || refuse "DSP_LIVE must be 0 or 1"; live=$value ;;
      DSP_PRESET) preset=$value ;;
      RATE)       [[ $value =~ ^(44100|48000|88200|96000|176400|192000)$ ]] || refuse "RATE must be a Dante rate (44100, 48000, 88200, 96000, 176400 or 192000)"
                  rate=$value ;;
      DSP_SHA256) [[ $value =~ ^[0-9a-f]{64}$ ]] || refuse "DSP_SHA256 must be 64 hex digits"; preset_sha=$value ;;
      *)          refuse "$conf: unknown key $key" ;;
    esac
  done < "$conf"
fi

sha256_of() { if command -v sha256sum >/dev/null 2>&1; then sha256sum "$1" | cut -c1-64; else shasum -a 256 "$1" | cut -c1-64; fi; }

arguments=(--seconds 0 --ppm-file "$state_dir/usb16x16-dante-owner.ppm" --log-every 60)
[ -n "$rate" ] && arguments+=(--rate "$rate")
[ "$meters" = 1 ] && arguments+=(--meter-file "$run_dir/meters.txt")
if [ -n "$preset" ]; then
  [[ $preset == "$dsp_dir"/*.dsp && $preset != *..* && ${preset#"$dsp_dir"/} != */* ]] ||
    refuse "DSP_PRESET must be a .dsp file directly under $dsp_dir"
  [ -f "$preset" ] && [ -r "$preset" ] || refuse "DSP_PRESET $preset is missing or unreadable"
  [ -n "$preset_sha" ] || refuse "DSP_PRESET needs DSP_SHA256"
  actual=$(sha256_of "$preset")
  [ "$actual" = "$preset_sha" ] || refuse "DSP_PRESET $preset hashes to ${actual:0:8}, not the ${preset_sha:0:8} in $conf"
  arguments+=(--dsp-preset "$preset")
  if [ "$live" = 1 ]; then
    arguments+=(--dsp-live-file "$run_dir/dsp-live.dsp" --dsp-live-status "$run_dir/dsp-live.status")
  fi
else
  [ -z "$preset_sha" ] || refuse "DSP_SHA256 without DSP_PRESET"
  [ "$live" = 0 ] || refuse "DSP_LIVE=1 needs DSP_PRESET: there is no stage to update"
fi

if [ "${1:-}" = --print ]; then
  printf '%s\n' "$owner" "${arguments[@]}"
  exit 0
fi
[ $# -eq 0 ] || refuse "usage: $0 [--print]"
exec "$owner" "${arguments[@]}"
