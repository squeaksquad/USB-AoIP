#!/bin/bash
# Start usb16x16-dante-owner the way /etc/usb16x16/dante/owner.conf says:
# the unit's ExecStart once the owner has DSP. The unit keeps the user, the
# capabilities and the environment; this only turns the configuration into
# the owner's command line and execs it, so the owner is the unit's main
# process as before.
#
#   usb16x16-dante-start            exec the owner
#   usb16x16-dante-start --print    print the command line, one argument a line, and exit
#
# owner.conf is KEY=value lines, read, never sourced. Every key is optional;
# with no file at all the command line is the one the unit carried before
# there was a configuration (direct, no meters).
#
#   METERS=0|1         1: --meter-file /run/usb16x16-dante/meters.txt
#   DSP_PRESET=PATH    a coefficient artifact under /etc/usb16x16/dsp/; empty: direct
#   DSP_SHA256=HEX     required with DSP_PRESET: the file must hash to this
#   DSP_LIVE=0|1       1: follow /run/usb16x16-dante/dsp-live.dsp (needs DSP_PRESET)
#   RATE=HZ            --rate HZ, a Dante rate; absent: the owner's 48000. DSP_PRESET
#                      must then be the artifact compiled for it (the owner refuses
#                      another); the applier writes the two together
#
# This is usb16x16-dante-start plus one thing (2026-10-12): transport settings
# from a second file, /etc/usb16x16/dante/transport.conf, same KEY=value form.
# They are kept out of owner.conf because the applier rewrites that file from
# the page and knows only its own keys; what is here is installed by the
# operator and survives every Apply. With no such file the command line is
# exactly the one usb16x16-dante-start makes.
#
#   RX_QUEUE=N         --rx-queue N: the return queue's target depth in frames
#                      (the owner's default is 144; it refuses under 96)
#   RATE_REQUESTS=0|1  1: --rate-request-file /run/usb16x16-dante/rate-request, so a
#                      host at another rate becomes a request for the arbiter
#                      (usb16x16-dante-rate.path; SAMPLE_RATE_DESIGN.md step 4).
#                      Needs an owner that has the option.
#   PRIME_DROP=N       --prime-drop N (0 to 48): the outgoing prime drops a constant N of
#                      the host's first block, so the round trip does not depend on the
#                      depth the prime finds (work/mac-driver-spike/SPIKE_PLAN.md, Phase B)
#   CAPTURE_DRAIN=0|1  1: --capture-drain, the gadget capture PCM restarted at each host
#                      stop, so every host session starts from an empty ring on a period
#                      boundary (SPIKE_PLAN.md, Phase C). With PRIME_DROP=24 the round
#                      trip is the same at every host open. Both need owner abee374a or later.
#
# Depths in frames for a rate other than 48 kHz (2026-10-31, RATE96_PLAN.md phase 5):
# every depth is frames, so at 96 kHz each lasts half as long, and 96 runs with all
# of them doubled (arm A). With none of these the owner keeps its defaults.
#
#   RX_SLACK=N  BUFFER=N  TX_LEAD=N  GUARD=N  USB_PERIOD=N  USB_BUFFER=N
#                      --rx-slack, --buffer, --tx-lead, --guard, --usb-period, --usb-buffer
#
# Every key but RATE_REQUESTS may also be written KEY_<rate> (RX_QUEUE_96000=192):
# it applies only when owner.conf's RATE= is that rate (absent: 48000) and wins over
# the plain KEY there. An empty KEY_<rate>= leaves the option off at that rate
# (PRIME_DROP_96000= : no --prime-drop at 96 kHz). The applier moves RATE=; this
# file is what each rate then runs with.
#
# A configuration that cannot be honoured is a refusal (exit 2), never a
# quieter start: a system set up with crossovers must not come up without
# them. The unit does not restart on exit 2.
set -euo pipefail

conf=${USB16X16_DANTE_CONF:-/etc/usb16x16/dante/owner.conf}
owner=${USB16X16_DANTE_OWNER:-/usr/local/libexec/usb16x16-dante/usb16x16-dante-owner}
transport=${USB16X16_DANTE_TRANSPORT:-/etc/usb16x16/dante/transport.conf}
dsp_dir=${USB16X16_DSP_DIR:-/etc/usb16x16/dsp}
run_dir=${USB16X16_DANTE_RUN_DIR:-/run/usb16x16-dante}
state_dir=${USB16X16_DANTE_STATE_DIR:-/var/lib/usb16x16-dante}
refuse() { echo "usb16x16-dante-start: REFUSED: $*" >&2; exit 2; }

meters=0
preset=
preset_sha=
live=0
rate=
if [ -e "$conf" ]; then
  [ -r "$conf" ] || refuse "$conf cannot be read"
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in ''|'#'*) continue ;; esac
    [[ $line =~ ^([A-Z0-9_]+)=(.*)$ ]] || refuse "$conf: not KEY=value: $line"
    key=${BASH_REMATCH[1]}
    value=${BASH_REMATCH[2]}
    case "$key" in
      METERS)     [[ $value =~ ^[01]$ ]] || refuse "METERS must be 0 or 1"; meters=$value ;;
      DSP_LIVE)   [[ $value =~ ^[01]$ ]] || refuse "DSP_LIVE must be 0 or 1"; live=$value ;;
      DSP_PRESET) preset=$value ;;
      RATE)       [[ $value =~ ^(44100|48000|88200|96000|176400|192000)$ ]] || refuse "RATE must be a Dante rate (44100, 48000, 88200, 96000, 176400 or 192000)"
                  rate=$value ;;
      DSP_SHA256) [[ $value =~ ^[0-9a-f]{64}$ ]] || refuse "DSP_SHA256 must be 64 hex digits"; preset_sha=$value ;;
      *)          refuse "$conf: unknown key $key" ;;
    esac
  done < "$conf"
fi

# Each transport key: its range check, then its plain value and the one for this
# rate (t_KEY, r_KEY, with has_r_KEY set when KEY_<rate> was given, even empty).
transport_keys="RX_QUEUE RX_SLACK BUFFER TX_LEAD GUARD USB_PERIOD USB_BUFFER PRIME_DROP CAPTURE_DRAIN"
running_rate=${rate:-48000}
check_transport() {   # key, value; refuses unless the value is in range
  local v=$2
  case "$1" in
    RX_QUEUE)      [[ $v =~ ^[0-9]{2,4}$ ]] && [ "$v" -ge 96 ] && [ "$v" -le 384 ] || refuse "RX_QUEUE must be a number of frames from 96 to 384" ;;
    RX_SLACK)      [[ $v =~ ^[0-9]{2,4}$ ]] && [ "$v" -ge 16 ] && [ "$v" -le 768 ] || refuse "RX_SLACK must be a number of frames from 16 to 768" ;;
    BUFFER)        [[ $v =~ ^[0-9]{3,4}$ ]] && [ "$v" -ge 256 ] && [ "$v" -le 8192 ] || refuse "BUFFER must be a number of frames from 256 to 8192" ;;
    TX_LEAD)       [[ $v =~ ^[0-9]{2,4}$ ]] && [ "$v" -ge 16 ] && [ "$v" -le 2048 ] || refuse "TX_LEAD must be a number of frames from 16 to 2048" ;;
    GUARD)         [[ $v =~ ^[0-9]{2,4}$ ]] && [ "$v" -ge 16 ] && [ "$v" -le 4096 ] || refuse "GUARD must be a number of frames from 16 to 4096" ;;
    USB_PERIOD)    [[ $v =~ ^[0-9]{2,3}$ ]] && [ "$v" -ge 12 ] && [ "$v" -le 384 ] || refuse "USB_PERIOD must be a number of frames from 12 to 384" ;;
    USB_BUFFER)    [[ $v =~ ^[0-9]{2,4}$ ]] && [ "$v" -ge 96 ] && [ "$v" -le 3840 ] || refuse "USB_BUFFER must be a number of frames from 96 to 3840" ;;
    PRIME_DROP)    [[ $v =~ ^[0-9]{1,2}$ ]] && [ "$v" -le 48 ] || refuse "PRIME_DROP must be a number of frames from 0 to 48" ;;
    CAPTURE_DRAIN) [[ $v =~ ^[01]$ ]] || refuse "CAPTURE_DRAIN must be 0 or 1" ;;
  esac
}
# declare, not printf -v: bash 3.2 (the Mac's, where the test runs) leaves a printf -v of '' unset.
for k in $transport_keys; do declare "t_$k=" "r_$k=" "has_r_$k=0"; done
rate_requests=0
if [ -e "$transport" ]; then
  [ -r "$transport" ] || refuse "$transport cannot be read"
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in ''|'#'*) continue ;; esac
    [[ $line =~ ^([A-Z0-9_]+)=(.*)$ ]] || refuse "$transport: not KEY=value: $line"
    key=${BASH_REMATCH[1]}
    value=${BASH_REMATCH[2]}
    if [ "$key" = RATE_REQUESTS ]; then
      [[ $value =~ ^[01]$ ]] || refuse "RATE_REQUESTS must be 0 or 1"; rate_requests=$value; continue
    fi
    for_rate=
    if [[ $key =~ ^(.*)_(44100|48000|88200|96000|176400|192000)$ ]]; then key=${BASH_REMATCH[1]}; for_rate=${BASH_REMATCH[2]}; fi
    [[ " $transport_keys " == *" $key "* ]] || refuse "$transport: unknown key ${line%%=*}"
    if [ -z "$for_rate" ]; then
      check_transport "$key" "$value"; declare "t_$key=$value"
    else
      [ -z "$value" ] || check_transport "$key" "$value"
      if [ "$for_rate" = "$running_rate" ]; then declare "r_$key=$value" "has_r_$key=1"; fi
    fi
  done < "$transport"
fi
for k in $transport_keys; do
  has=has_r_$k
  if [ "${!has}" = 1 ]; then r=r_$k; declare "$k=${!r}"; else t=t_$k; declare "$k=${!t}"; fi
done

sha256_of() { if command -v sha256sum >/dev/null 2>&1; then sha256sum "$1" | cut -c1-64; else shasum -a 256 "$1" | cut -c1-64; fi; }

arguments=(--seconds 0 --ppm-file "$state_dir/usb16x16-dante-owner.ppm" --log-every 60)
[ -n "$rate" ] && arguments+=(--rate "$rate")
[ -n "$RX_QUEUE" ] && arguments+=(--rx-queue "$RX_QUEUE")
[ -n "$RX_SLACK" ] && arguments+=(--rx-slack "$RX_SLACK")
[ -n "$BUFFER" ] && arguments+=(--buffer "$BUFFER")
[ -n "$TX_LEAD" ] && arguments+=(--tx-lead "$TX_LEAD")
[ -n "$GUARD" ] && arguments+=(--guard "$GUARD")
[ -n "$USB_PERIOD" ] && arguments+=(--usb-period "$USB_PERIOD")
[ -n "$USB_BUFFER" ] && arguments+=(--usb-buffer "$USB_BUFFER")
[ "$rate_requests" = 1 ] && arguments+=(--rate-request-file "$run_dir/rate-request")
[ -n "$PRIME_DROP" ] && arguments+=(--prime-drop "$PRIME_DROP")
[ "$CAPTURE_DRAIN" = 1 ] && arguments+=(--capture-drain)
[ "$meters" = 1 ] && arguments+=(--meter-file "$run_dir/meters.txt")
if [ -n "$preset" ]; then
  [[ $preset == "$dsp_dir"/*.dsp && $preset != *..* && ${preset#"$dsp_dir"/} != */* ]] ||
    refuse "DSP_PRESET must be a .dsp file directly under $dsp_dir"
  [ -f "$preset" ] && [ -r "$preset" ] || refuse "DSP_PRESET $preset is missing or unreadable"
  [ -n "$preset_sha" ] || refuse "DSP_PRESET needs DSP_SHA256"
  actual=$(sha256_of "$preset")
  [ "$actual" = "$preset_sha" ] || refuse "DSP_PRESET $preset hashes to ${actual:0:8}, not the ${preset_sha:0:8} in $conf"
  arguments+=(--dsp-preset "$preset")
  if [ "$live" = 1 ]; then
    arguments+=(--dsp-live-file "$run_dir/dsp-live.dsp" --dsp-live-status "$run_dir/dsp-live.status")
  fi
else
  [ -z "$preset_sha" ] || refuse "DSP_SHA256 without DSP_PRESET"
  [ "$live" = 0 ] || refuse "DSP_LIVE=1 needs DSP_PRESET: there is no stage to update"
fi

if [ "${1:-}" = --print ]; then
  printf '%s\n' "$owner" "${arguments[@]}"
  exit 0
fi
[ $# -eq 0 ] || refuse "usage: $0 [--print]"
exec "$owner" "${arguments[@]}"
