+// The arbiter's request (usb16x16-apply rate): one line of key=value fields,
+// the same form the owner writes for a host at another rate.
+fn rate_request_line(rate: u32, from: &std::net::SocketAddr, at: u64) -> String {
+  format!("rate={rate} source=dante from={} at={at}\n", from.ip())
+}
+
+fn unix_now() -> u64 {
+  std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).map(|d| d.as_secs()).unwrap_or(0)
+}
+
+// Write by rename, so the arbiter's path unit never reads half a line.
+fn write_rate_request(path: &str, line: &str) -> std::io::Result<()> {
+  let temporary = format!("{path}.tmp");
+  std::fs::write(&temporary, line)?;
+  std::fs::rename(&temporary, path)
+}
+
+#[cfg(test)]
+mod rate_request_tests {
+  use super::*;
+
+  #[test]
+  fn the_line_is_what_the_arbiter_parses() {
+    let from: std::net::SocketAddr = "169.254.26.52:8700".parse().unwrap();
+    assert_eq!(rate_request_line(96000, &from, 1760700000), "rate=96000 source=dante from=169.254.26.52 at=1760700000\n");
+  }
+
+  #[test]
+  fn the_file_is_written_whole() {
+    let dir = std::env::temp_dir().join(format!("inferno-rate-request-{}", std::process::id()));
+    std::fs::create_dir_all(&dir).unwrap();
+    let path = dir.join("rate-request");
+    let path = path.to_str().unwrap();
+    write_rate_request(path, "rate=96000 source=dante from=1.2.3.4 at=1\n").unwrap();
+    assert_eq!(std::fs::read_to_string(path).unwrap(), "rate=96000 source=dante from=1.2.3.4 at=1\n");
+    assert!(!std::path::Path::new(&format!("{path}.tmp")).exists());
+    std::fs::remove_dir_all(&dir).unwrap();
+  }
+}
