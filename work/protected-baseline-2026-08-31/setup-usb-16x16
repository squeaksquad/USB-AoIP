#!/bin/bash
set -euo pipefail

G=/sys/kernel/config/usb_gadget/studio_audio
F="$G/functions/uac2.usb0"
C="$G/configs/c.1"
LINK="$C/uac2.usb0"
UDC=1000480000.usb

stop_gadget() {
	if [[ ! -d "$G" ]]; then
		return
	fi

	if [[ -f "$G/UDC" ]]; then
		printf '\n' > "$G/UDC" || true
	fi

	if [[ -L "$LINK" ]]; then
		unlink "$LINK"
	fi

	if [[ -d "$F" ]]; then
		rmdir "$F"
	fi

	rmdir "$C/strings/0x409" 2>/dev/null || true
	rmdir "$C" 2>/dev/null || true
	rmdir "$G/strings/0x409" 2>/dev/null || true
	rmdir "$G" 2>/dev/null || true
}

start_gadget() {
	if ! mountpoint -q /sys/kernel/config; then
		mount -t configfs configfs /sys/kernel/config
	fi

	modprobe -r g_ether 2>/dev/null || true
	modprobe libcomposite
	modprobe usb_f_uac2

	stop_gadget

	if [[ ! -e "/sys/class/udc/$UDC" ]]; then
		echo "UDC $UDC is not available" >&2
		exit 1
	fi

	mkdir -p "$G/strings/0x409"
	mkdir -p "$C/strings/0x409"

	# Prototype VID/PID only; obtain a production USB VID/PID before shipping.
	printf '%s\n' 0x1d6b > "$G/idVendor"
	printf '%s\n' 0x0104 > "$G/idProduct"
	printf '%s\n' 0x0200 > "$G/bcdUSB"
	printf '%s\n' 0x0100 > "$G/bcdDevice"

	printf '%s\n' AUDDEV001 > "$G/strings/0x409/serialnumber"
	printf '%s\n' 'Bryan DiMaio' > "$G/strings/0x409/manufacturer"
	printf '%s\n' 'USB 16x16' > "$G/strings/0x409/product"
	printf '%s\n' 'UAC2 Audio' > "$C/strings/0x409/configuration"

	mkdir "$F"

	printf '%s\n' 65535 > "$F/p_chmask"
	printf '%s\n' 48000 > "$F/p_srate"
	printf '%s\n' 3 > "$F/p_ssize"
	printf '%s\n' 0 > "$F/p_hs_bint"

	printf '%s\n' 65535 > "$F/c_chmask"
	printf '%s\n' 48000 > "$F/c_srate"
	printf '%s\n' 3 > "$F/c_ssize"
	printf '%s\n' 0 > "$F/c_hs_bint"
	printf '%s\n' async > "$F/c_sync"

	printf '%s\n' 2 > "$F/req_number"
	printf '%s\n' 5 > "$F/fb_max"
	printf '%s\n' 'USB 16x16' > "$F/function_name"
	printf '%s\n' 'USB 16x16' > "$F/if_ctrl_name"

	ln -s "$F" "$LINK"
	printf '%s\n' "$UDC" > "$G/UDC"
}

case "${1:-start}" in
	start)
		start_gadget
		;;
	stop)
		stop_gadget
		;;
	*)
		echo "Usage: $0 {start|stop}" >&2
		exit 2
		;;
esac
