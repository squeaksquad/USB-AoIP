# ------------------------------------------------------------------ helpers

def read_text(path: Path, limit: int = 65536) -> str | None:
    try:
        with open(path, "r", encoding="utf-8", errors="replace") as handle:
            return handle.read(limit)
    except OSError:
        return None


def run(argv: list[str], timeout: float = 4.0) -> str | None:
    """Run a fixed argv with no shell. Returns stdout, or None on any failure."""
    try:
        done = subprocess.run(
            argv, capture_output=True, text=True, timeout=timeout, check=False
        )
    except (OSError, subprocess.SubprocessError):
        return None
    return done.stdout


def http_json(path: str, timeout: float = 3.0):
    try:
        with urllib.request.urlopen(DAEMON_API + path, timeout=timeout) as response:
            return json.loads(response.read(1 << 20).decode("utf-8", "replace"))
    except (urllib.error.URLError, OSError, ValueError, json.JSONDecodeError):
        return None


def as_number(text: str):
    try:
        value = float(text)
    except (TypeError, ValueError):
        return None
    return int(value) if value.is_integer() else value


def parse_bridge_line(line: str) -> dict:
    """Split one BRIDGE telemetry line into its key=value fields."""
    fields: dict = {}
    for token in line.split():
        if "=" not in token:
            continue
        key, _, value = token.partition("=")
        number = as_number(value)
        fields[key] = value if number is None else number
    return fields


def interface_address(name: str) -> str | None:
    """The IPv4 address of an interface, read without extra dependencies."""
    output = run(["ip", "-o", "-4", "addr", "show", "dev", name])
    if not output:
        return None
    match = re.search(r"\binet\s+([0-9.]+)/", output)
    return match.group(1) if match else None


# ---------------------------------------------------------------- collector

class Collector:
    """Single owner of every read against the Pi.

    Publishes one immutable snapshot dict. Every HTTP handler reads that
    snapshot; none of them triggers work of its own, so N browsers cost the
    same as one.
    """

    def __init__(self, static_dir: Path, preset_dir: Path) -> None:
        self.static_dir = static_dir
        self.preset_dir = preset_dir
        self._lock = threading.Lock()
        self._snapshot: dict = {"ok": False, "reason": "starting"}
        self._stop = threading.Event()
        self._fast: dict = {}
        self._slow: dict = {}
        self._daemon: dict = {}
        self._started = time.time()
        self._dsp: dict = {"available": False, "reason": "not yet probed"}

    # ---- tiers

    def collect_fast(self) -> dict:
        state: dict = {"bridge": {"present": False}}
        line = read_text(RUN_DIR / "last-bridge")
        if line and line.startswith("BRIDGE"):
            fields = parse_bridge_line(line)
            try:
                age = time.time() - (RUN_DIR / "last-bridge").stat().st_mtime
            except OSError:
                age = None
            state["bridge"] = {
                "present": True,
                "ageSeconds": None if age is None else round(age, 1),
                "ppm": fields.get("ppm"),
                "phaseErrorUs": fields.get("phase_us"),
                "txQueue": fields.get("tx_queue"),
                "rxQueue": fields.get("rx_queue"),
                "txQueueFloor": fields.get("tx_qfloor"),
                "rxQueueFloor": fields.get("rx_qfloor"),
                "txDepthFloor": fields.get("tx_dfloor"),
                "rxDepthFloor": fields.get("rx_dfloor"),
                "txRestarts": fields.get("tx_restarts"),
                "rxRestarts": fields.get("rx_restarts"),
                "txDropped": fields.get("tx_dropped"),
                "rxDropped": fields.get("rx_dropped"),
                "txClip": fields.get("tx_clip"),
                "rxClip": fields.get("rx_clip"),
                "txPullMax": fields.get("tx_pullmax"),
                "rxPullMax": fields.get("rx_pullmax"),
            }
        stage = read_text(RUN_DIR / "stage", 4096)
        if stage:
            stamp, _, text = stage.strip().partition(" ")
            since = None
            try:
                since = int(time.time() - int(stamp))
            except ValueError:
                text = stage.strip()
            state["stage"] = {"text": text.strip(), "secondsAgo": since}
        recovers = read_text(RUN_DIR / "recovers", 1 << 20)
        if recovers is not None:
            state["recovers"] = len([v for v in recovers.splitlines() if v.strip()])
        return state

    def collect_slow(self) -> dict:
        state: dict = {}
        names = list(UNITS.values())
        active = (run(["systemctl", "is-active", *names]) or "").split()
        # systemctl prints one line per unit, in order, even when some are dead.
        state["services"] = {
            key: {"unit": unit, "state": active[index] if index < len(active) else "unknown"}
            for index, (key, unit) in enumerate(UNITS.items())
        }

        carrier = read_text(Path(f"/sys/class/net/{AOIP_INTERFACE}/carrier"), 16)
        speed = read_text(Path(f"/sys/class/net/{AOIP_INTERFACE}/speed"), 16)
        state["network"] = {
            "interface": AOIP_INTERFACE,
            "carrier": (carrier or "").strip() == "1",
            "speedMbit": as_number((speed or "").strip()),
            "address": interface_address(AOIP_INTERFACE),
        }

        udc = {"present": False}
        udc_root = Path("/sys/class/udc")
        try:
            entries = sorted(p.name for p in udc_root.iterdir())
        except OSError:
            entries = []
        if entries:
            name = entries[0]
            udc = {
                "present": True,
                "name": name,
                "state": (read_text(udc_root / name / "state", 64) or "").strip(),
                "speed": (read_text(udc_root / name / "current_speed", 64) or "").strip(),
            }
        state["usb"] = udc

        system: dict = {}
        temp = run(["vcgencmd", "measure_temp"], timeout=3.0)
        if temp:
            match = re.search(r"([0-9.]+)", temp)
            if match:
                system["tempC"] = float(match.group(1))
        throttled = run(["vcgencmd", "get_throttled"], timeout=3.0)
        if throttled and "=" in throttled:
            code = throttled.strip().split("=", 1)[1]
            system["throttled"] = code
            try:
                system["throttledNow"] = bool(int(code, 16) & 0x7)
            except ValueError:
                pass
        try:
            system["load"] = list(os.getloadavg())[:3]
        except OSError:
            pass
        uptime = read_text(Path("/proc/uptime"), 128)
        if uptime:
            system["uptimeSeconds"] = int(float(uptime.split()[0]))
        state["system"] = system
        return state

    def collect_daemon(self) -> dict:
        # Deliberately limited to idempotent reads. /api/sink/status/N is not
        # among them: reading it clears the arrival-lead minimum that the
        # latency harness owns.
        state: dict = {}
        ptp = http_json("/api/ptp/status")
        state["ptp"] = ptp if isinstance(ptp, dict) else {"status": "unavailable"}
        config = http_json("/api/config")
        if isinstance(config, dict):
            state["daemon"] = {
                "sampleRate": config.get("sample_rate"),
                "interface": config.get("interface_name"),
                "address": config.get("ip_addr"),
                "nodeId": config.get("node_id"),
                "ptpDomain": config.get("ptp_domain"),
            }
        streams: dict = {"sinks": [], "sources": []}
        sinks = http_json("/api/sinks")
        if isinstance(sinks, dict):
            for sink in sinks.get("sinks", []):
                streams["sinks"].append({
                    "id": sink.get("id"),
                    "name": sink.get("name"),
                    "delay": sink.get("delay"),
                    "channels": len(sink.get("map") or []),
                })
        sources = http_json("/api/sources")
        if isinstance(sources, dict):
            for source in sources.get("sources", []):
                streams["sources"].append({
                    "id": source.get("id"),
                    "name": source.get("name"),
                    "enabled": source.get("enabled"),
                    "address": source.get("address"),
                    "channels": len(source.get("map") or []),
                })
        state["streams"] = streams
        return state

    def collect_dsp(self) -> dict:
        """What the DSP processor mode would need, and what is actually there.

        The engine binary is staged but nothing runs it, no preset compiler
        exists and no DSP service is installed, so the UI must present DSP mode
        as a draft rather than a running path.
        """
        engine = None
        if CAMILLA_BIN.is_file() and os.access(CAMILLA_BIN, os.X_OK):
            engine = (run([str(CAMILLA_BIN), "--version"]) or "").strip() or "present"
        missing = []
        if not engine:
            missing.append("the CamillaDSP engine binary")
        missing.append("a preset-to-YAML compiler")
        missing.append("a DSP service that owns the PCM devices")
        return {
            "available": False,
            "engine": engine,
            "missing": missing,
            # The caller already states what is running; do not repeat it here.
            "reason": "DSP processor mode is under development.",
        }

    # ---- assembly

    def build(self) -> dict:
        services = self._slow.get("services", {})
        aes67 = services.get("aes67", {}).get("state")
        gadget = services.get("gadget", {}).get("state")
        bridge = self._fast.get("bridge", {})
        running = aes67 == "active" and bridge.get("present") and (
            bridge.get("ageSeconds") is not None and bridge["ageSeconds"] < 15
        )
        snapshot = {
            "ok": True,
            "generated": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
            "service": {"name": "usb16x16-web", "version": VERSION,
                        "uptimeSeconds": int(time.time() - self._started)},
            "host": socket.gethostname(),
            "audio": {"sampleRate": self._daemon.get("daemon", {}).get("sampleRate", 48000),
                      "inputs": 16, "outputs": 16},
            "mode": {
                "actual": "direct",
                "running": bool(running),
                "detail": "Direct USB ↔ AoIP bridge" if running
                          else f"AES67 service {aes67 or 'unknown'}, USB gadget {gadget or 'unknown'}",
            },
            "meters": {
                "available": False,
                "reason": "The bridge has no metering tap. Opening a second ALSA "
                          "stream to read levels would compete with the audio path, "
                          "so the meters shown are display activity only.",
            },
            "dsp": self._dsp,
        }
        snapshot.update(self._fast)
        snapshot.update(self._slow)
        snapshot.update(self._daemon)
        return snapshot

    def loop(self) -> None:
        self._dsp = self.collect_dsp()
        next_slow = 0.0
        next_daemon = 0.0
        while not self._stop.is_set():
            now = time.monotonic()
            try:
                self._fast = self.collect_fast()
                if now >= next_slow:
                    self._slow = self.collect_slow()
                    next_slow = now + SLOW_INTERVAL
                if now >= next_daemon:
                    self._daemon = self.collect_daemon()
                    next_daemon = now + DAEMON_INTERVAL
                snapshot = self.build()
            except Exception as error:  # never let the collector die
                snapshot = {"ok": False, "reason": f"collector error: {error}"}
            with self._lock:
                self._snapshot = snapshot
            self._stop.wait(FAST_INTERVAL)

    def snapshot(self) -> dict:
        with self._lock:
            return self._snapshot

    def stop(self) -> None:
        self._stop.set()


# ------------------------------------------------------------------ presets

class PresetStore:
    """Durable presets as one JSON file each, written atomically.

    A preset is UI configuration only. Nothing here is applied to the device;
    the file is the same document the browser exports.
    """

    MAX_BYTES = 1 << 20
    MAX_COUNT = 200

    def __init__(self, directory: Path) -> None:
        self.directory = directory
        self.directory.mkdir(parents=True, exist_ok=True)

    @staticmethod
    def slug(name: str) -> str:
        return re.sub(r"[^A-Za-z0-9._-]", "_", name)[:80]

    def path(self, name: str) -> Path:
        return self.directory / f"{self.slug(name)}.json"

    def list(self) -> list[dict]:
        items = []
        for entry in sorted(self.directory.glob("*.json")):
            try:
                document = json.loads(entry.read_text(encoding="utf-8"))
            except (OSError, ValueError):
                continue
            if isinstance(document, dict):
                items.append({
                    "name": document.get("name") or entry.stem,
                    "modified": int(entry.stat().st_mtime),
                })
        return items

    def read(self, name: str):
        try:
            return json.loads(self.path(name).read_text(encoding="utf-8"))
        except (OSError, ValueError):
            return None

    def write(self, name: str, document: dict) -> None:
        if not PRESET_NAME.match(name):
            raise ValueError("Preset names use letters, digits, space, dot, dash "
                             "or underscore, up to 64 characters")
        target = self.path(name)
        if not target.exists() and len(list(self.directory.glob("*.json"))) >= self.MAX_COUNT:
            raise ValueError(f"The preset store holds at most {self.MAX_COUNT} presets")
        document = dict(document)
        document["name"] = name
        payload = json.dumps(document, indent=2)
        if len(payload.encode("utf-8")) > self.MAX_BYTES:
            raise ValueError("Preset is larger than 1 MB")
        temporary = target.with_suffix(".json.tmp")
        with open(temporary, "w", encoding="utf-8") as handle:
            handle.write(payload)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temporary, target)

    def delete(self, name: str) -> bool:
        try:
            self.path(name).unlink()
            return True
        except OSError:
            return False


# --------------------------------------------------------------------- auth

class PasswordFile:
    """Users and PBKDF2 hashes, one per line.

        name:pbkdf2_sha256$<iterations>$<salt b64>$<hash b64>

    The password itself is never stored, never passed on the command line and
    never logged. The file is written 0600.
    """

    def __init__(self, path: Path) -> None:
        self.path = path

    @staticmethod
    def hash_password(password: str, iterations: int = KDF_ITERATIONS,
                      salt: bytes | None = None) -> str:
        salt = salt or secrets.token_bytes(16)
        digest = hashlib.pbkdf2_hmac("sha256", password.encode("utf-8"), salt, iterations)
        return "pbkdf2_sha256${}${}${}".format(
            iterations,
            base64.b64encode(salt).decode("ascii"),
            base64.b64encode(digest).decode("ascii"))

    @staticmethod
    def verify_password(password: str, stored: str) -> bool:
        try:
            scheme, iterations, salt, digest = stored.split("$")
            if scheme != "pbkdf2_sha256":
                return False
            candidate = hashlib.pbkdf2_hmac(
                "sha256", password.encode("utf-8"),
                base64.b64decode(salt), int(iterations))
        except (ValueError, TypeError):
            return False
        return hmac.compare_digest(candidate, base64.b64decode(digest))

    def load(self) -> dict[str, str]:
        users: dict[str, str] = {}
        text = read_text(self.path, 1 << 20)
        if text is None:
            return users
        for line in text.splitlines():
            line = line.strip()
            if not line or line.startswith("#") or ":" not in line:
                continue
            name, _, stored = line.partition(":")
            if USER_NAME.match(name):
                users[name] = stored
        return users

    def set_user(self, name: str, password: str) -> None:
        if not USER_NAME.match(name):
            raise ValueError("User names use letters, digits, dot, dash or underscore")
        if len(password) < 8:
            raise ValueError("Use a password of at least 8 characters")
        users = self.load()
        users[name] = self.hash_password(password)
        self.path.parent.mkdir(parents=True, exist_ok=True)
        temporary = self.path.with_suffix(".tmp")
        # 0600 before any content is written, so the hashes are never briefly
        # world-readable between creation and chmod.
        handle = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(handle, "w", encoding="utf-8") as out:
            out.write("# usb16x16-web credentials. Generated; do not edit by hand.\n")
            for user, stored in sorted(users.items()):
                out.write(f"{user}:{stored}\n")
            out.flush()
            os.fsync(out.fileno())
        os.replace(temporary, self.path)

    def remove_user(self, name: str) -> bool:
        users = self.load()
        if name not in users:
            return False
        del users[name]
        if not users:
            raise ValueError("Refusing to remove the last user; the service would "
                             "not start. Add another user first, or pass --no-auth.")
        # Rewrite through set_user's path by re-hashing nothing: write directly.
        temporary = self.path.with_suffix(".tmp")
        handle = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(handle, "w", encoding="utf-8") as out:
            out.write("# usb16x16-web credentials. Generated; do not edit by hand.\n")
            for user, stored in sorted(users.items()):
                out.write(f"{user}:{stored}\n")
            out.flush()
            os.fsync(out.fileno())
        os.replace(temporary, self.path)
        return True


class Authenticator:
    """Basic auth with a bounded success cache and per-client failure limit.

    The KDF is the point of a password hash, but the UI polls /api/health every
    two seconds. Paying 90 ms of PBKDF2 per poll would put a steady load on the
    machine running the audio, so a credential that has just verified is
    remembered for AUTH_CACHE_SECONDS by the SHA-256 of its header. The cache
    only ever skips work for a credential that already passed; a wrong password
    is never cached and always pays full price.
    """

    def __init__(self, password_file: PasswordFile) -> None:
        self.password_file = password_file
        self._lock = threading.Lock()
        self._verified: dict[bytes, float] = {}
        self._failures: dict[str, list[float]] = {}

    def reload(self) -> dict[str, str]:
        users = self.password_file.load()
        with self._lock:
            # Credentials change meaning when the file does: drop the cache.
            self._verified.clear()
        return users

    def throttled(self, client: str) -> bool:
        now = time.monotonic()
        with self._lock:
            recent = [t for t in self._failures.get(client, []) if now - t < FAIL_WINDOW_SECONDS]
            self._failures[client] = recent
            return len(recent) >= FAIL_LIMIT

    def clear_failures(self, client: str) -> None:
        """A correct password forgives earlier typos from that client."""
        with self._lock:
            self._failures.pop(client, None)

    def note_failure(self, client: str) -> None:
        now = time.monotonic()
        with self._lock:
            self._failures.setdefault(client, []).append(now)
            if len(self._failures) > 1024:  # bounded under a spoofed-source flood
                self._failures = {
                    key: [t for t in times if now - t < FAIL_WINDOW_SECONDS]
                    for key, times in self._failures.items()}
                self._failures = {k: v for k, v in self._failures.items() if v}

    @staticmethod
    def _token(header: str) -> bytes:
        return hashlib.sha256(header.encode("utf-8", "replace")).digest()

    def cached(self, header: str | None) -> bool:
        """Free check against credentials that already verified.

        Deliberately consulted before the failure limiter, so a flood of wrong
        passwords from one address cannot lock out someone who is already
        signed in from it.
        """
        if not header or not header.startswith("Basic "):
            return False
        token = self._token(header)
        now = time.monotonic()
        with self._lock:
            expiry = self._verified.get(token)
            if expiry is None:
                return False
            if expiry > now:
                return True
            del self._verified[token]
            return False

    def verify(self, header: str) -> bool:
        """Full check. Costs one KDF; only reached on a cache miss."""
        token = self._token(header)
        now = time.monotonic()
        try:
            decoded = base64.b64decode(header[6:].strip(), validate=True).decode("utf-8")  # noqa: E501
            name, _, password = decoded.partition(":")
        except (ValueError, UnicodeDecodeError):
            return False
        stored = self.password_file.load().get(name)
        # Hash even an unknown user, so a wrong name and a wrong password take
        # the same time and the reply does not say which was wrong.
        if stored is None:
            PasswordFile.hash_password(password)
            return False
        if not PasswordFile.verify_password(password, stored):
            return False
        with self._lock:
            if len(self._verified) >= AUTH_CACHE_MAX:
                self._verified = {k: v for k, v in self._verified.items() if v > now}
                if len(self._verified) >= AUTH_CACHE_MAX:
                    self._verified.clear()
            self._verified[token] = now + AUTH_CACHE_SECONDS
        return True


# ------------------------------------------------------------------ handler

class Handler(BaseHTTPRequestHandler):
    server_version = f"usb16x16-web/{VERSION}"
    protocol_version = "HTTP/1.1"

    collector: Collector
    presets: PresetStore
    auth: Authenticator | None = None

    # ---- plumbing

    def log_message(self, fmt: str, *args) -> None:  # quieter journal
        if self.command != "GET" or not self.path.startswith("/api/health"):
            sys.stderr.write("%s - %s\n" % (self.address_string(), fmt % args))

    def send_json(self, payload, status: int = 200) -> None:
        body = json.dumps(payload).encode("utf-8")
        self.send_response(status)
        self.send_header("Content-Type", "application/json; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        if self.command != "HEAD":
            self.wfile.write(body)

    def send_error_json(self, status: int, message: str) -> None:
        self.send_json({"ok": False, "error": message}, status)

    def discard_body(self) -> None:
        """Drain an unread request body before rejecting the request.

        Under HTTP/1.1 keep-alive, answering a PUT without reading its body
        leaves that body in the connection, and the server then parses it as the
        next request line. A rejected write would poison the following request
        on the same connection. Anything larger than the preset cap is not worth
        draining, so close instead.
        """
        try:
            length = int(self.headers.get("Content-Length") or 0)
        except ValueError:
            self.close_connection = True
            return
        if length <= 0:
            return
        if length > (1 << 20):
            self.close_connection = True
            return
        try:
            self.rfile.read(length)
        except OSError:
            self.close_connection = True

    def send_auth_challenge(self, message: str = "Authentication required") -> None:
        self.discard_body()
        body = json.dumps({"ok": False, "error": message}).encode()
        self.send_response(HTTPStatus.UNAUTHORIZED)
        self.send_header("WWW-Authenticate", f'Basic realm="{REALM}", charset="UTF-8"')
        self.send_header("Content-Type", "application/json; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        if self.command != "HEAD":
            self.wfile.write(body)

    def authorize(self) -> bool:
        """Gate every route. Returns False having already answered the client.

        Order matters. A request with no Authorization header is the Basic auth
        handshake, not a failed sign-in: every browser makes one per session, so
        counting it would let normal use throttle itself. And the free cache is
        consulted before the limiter, so someone flooding wrong passwords from
        an address cannot lock out a user already signed in from it.
        """
        if self.auth is None:
            return True
        header = self.headers.get("Authorization")
        if not header or not header.startswith("Basic "):
            self.send_auth_challenge()
            return False
        if self.auth.cached(header):
            return True
        client = self.client_address[0] if self.client_address else "?"
        if self.auth.throttled(client):
            self.discard_body()
            body = json.dumps({"ok": False,
                               "error": "Too many failed sign-ins from this address; "
                                        "wait a minute"}).encode()
            self.send_response(HTTPStatus.TOO_MANY_REQUESTS)
            self.send_header("Content-Type", "application/json; charset=utf-8")
            self.send_header("Retry-After", str(int(FAIL_WINDOW_SECONDS)))
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            if self.command != "HEAD":
                self.wfile.write(body)
            return False
        if self.auth.verify(header):
            self.auth.clear_failures(client)
            return True
        self.auth.note_failure(client)
        sys.stderr.write(f"{client} - authentication failed for {self.command} {self.path}\n")
        self.send_auth_challenge("Wrong user name or password")
        return False

    def read_body(self, limit: int = 1 << 20):
        try:
            length = int(self.headers.get("Content-Length") or 0)
        except ValueError:
            return None
        if length <= 0 or length > limit:
            return None
        try:
            return json.loads(self.rfile.read(length).decode("utf-8"))
        except (ValueError, OSError):
            return None

    # ---- routes

    def do_GET(self) -> None:
        if not self.authorize():
            return
        parsed = urlparse(self.path)
        route = unquote(parsed.path)
        query = parse_qs(parsed.query)
        if route == "/api/health":
            self.send_json(self.collector.snapshot())
        elif route == "/api/logs":
            self.api_logs(query)
        elif route == "/api/presets":
            self.send_json({"ok": True, "store": "pi", "presets": self.presets.list()})
        elif route.startswith("/api/presets/"):
            name = route[len("/api/presets/"):]
            document = self.presets.read(name)
            if document is None:
                self.send_error_json(HTTPStatus.NOT_FOUND, "No such preset")
            else:
                self.send_json({"ok": True, "preset": document})
        elif route.startswith("/api/"):
            self.send_error_json(HTTPStatus.NOT_FOUND, "No such endpoint")
        else:
            self.serve_static(route)

    do_HEAD = do_GET

    def do_PUT(self) -> None:
        if not self.authorize():
            return
        route = unquote(urlparse(self.path).path)
        if not route.startswith("/api/presets/"):
            self.unsupported(route)
            return
        name = route[len("/api/presets/"):]
        document = self.read_body()
        if not isinstance(document, dict):
            # read_body returns None without consuming an oversized or unparsable
            # body, so the connection cannot be trusted for a further request.
            self.close_connection = True
            self.send_error_json(HTTPStatus.BAD_REQUEST, "Send the preset as a JSON object")
            return
        try:
            self.presets.write(name, document)
        except (ValueError, OSError) as error:
            self.send_error_json(HTTPStatus.BAD_REQUEST, str(error))
            return
        self.send_json({"ok": True, "name": name, "store": "pi"})

    def do_DELETE(self) -> None:
        if not self.authorize():
            return
        route = unquote(urlparse(self.path).path)
        if not route.startswith("/api/presets/"):
            self.unsupported(route)
            return
        name = route[len("/api/presets/"):]
        if not self.presets.delete(name):
            self.send_error_json(HTTPStatus.NOT_FOUND, "No such preset")
            return
        self.send_json({"ok": True, "name": name})

    def do_POST(self) -> None:
        if not self.authorize():
            return
        self.unsupported(unquote(urlparse(self.path).path))

    def unsupported(self, route: str) -> None:
        self.discard_body()
        """Every device-changing route answers the same way, on purpose.

        Restarting a service, switching a profile or applying DSP means owning
        a PCM device and interrupting audio. That belongs to a narrow
        privileged supervisor, not to this unprivileged read-only process.
        """
        if route.startswith("/api/service") or route.startswith("/api/apply") \
                or route.startswith("/api/dsp"):
            self.send_error_json(
                HTTPStatus.NOT_IMPLEMENTED,
                "This service is read-only. Device control (service restart, "
                "profile switch, DSP apply) is not implemented; run the "
                "commands on the Pi instead.",
            )
        else:
            self.send_error_json(HTTPStatus.METHOD_NOT_ALLOWED, "Method not allowed")

    def api_logs(self, query: dict) -> None:
        service = (query.get("service") or ["all"])[0]
        if service not in LOG_UNITS:
            self.send_error_json(HTTPStatus.BAD_REQUEST, "Choose a known log service")
            return
        try:
            lines = int((query.get("lines") or ["200"])[0])
        except ValueError:
            lines = 200
        lines = max(1, min(lines, 2000))
        argv = ["journalctl", "--no-pager", "-o", "short-iso", "-n", str(lines)]
        for unit in LOG_UNITS[service]:
            argv += ["-u", unit]
        output = run(argv, timeout=15.0)
        if output is None:
            self.send_error_json(HTTPStatus.SERVICE_UNAVAILABLE,
                                 "journalctl is not answering on this host")
            return
        self.send_json({"ok": True, "service": service, "lines": lines, "text": output})

    def serve_static(self, route: str) -> None:
        root = self.collector.static_dir
        relative = route.lstrip("/") or "index.html"
        target = (root / relative).resolve()
        try:
            target.relative_to(root.resolve())
        except ValueError:
            self.send_error_json(HTTPStatus.FORBIDDEN, "Outside the served directory")
            return
        if target.is_dir():
            target = target / "index.html"
        if not target.is_file():
            self.send_error_json(HTTPStatus.NOT_FOUND, "Not found")
            return
        try:
            body = target.read_bytes()
        except OSError:
            self.send_error_json(HTTPStatus.INTERNAL_SERVER_ERROR, "Could not read file")
            return
        self.send_response(HTTPStatus.OK)
        self.send_header("Content-Type", MIME.get(target.suffix, "application/octet-stream"))
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-cache")
        self.end_headers()
        if self.command != "HEAD":
            self.wfile.write(body)


# --------------------------------------------------------------------- main

def main() -> int:
    here = Path(__file__).resolve().parent
    parser = argparse.ArgumentParser(description="Read-only web control service for USB 16x16")
    parser.add_argument("--static", default=str(here.parent / "web-ui"),
                        help="directory holding the web UI files")
    parser.add_argument("--presets", default=os.path.expanduser("~/usb-16x16-work/web-presets"),
                        help="directory holding saved presets")
    parser.add_argument("--bind", default="",
                        help="address to bind (default: the management interface address)")
    parser.add_argument("--management-interface", default=os.environ.get("USB16X16_MGMT_IF", "wlan0"),
                        help="interface whose address is used when --bind is empty")
    parser.add_argument("--port", type=int, default=8088)
    parser.add_argument("--auth-file", default=os.path.expanduser("~/usb-16x16-work/web-auth"),
                        help="file holding user names and password hashes")
    parser.add_argument("--no-auth", action="store_true",
                        help="serve without authentication (do not use on a shared network)")
    parser.add_argument("--add-user", metavar="NAME",
                        help="prompt for a password, add or replace this user, then exit")
    parser.add_argument("--remove-user", metavar="NAME",
                        help="remove this user, then exit")
    arguments = parser.parse_args()

    password_file = PasswordFile(Path(arguments.auth_file))

    # Credential management runs and exits without starting a server, so a
    # password never reaches argv, the shell history or the journal.
    if arguments.add_user:
        try:
            password = getpass.getpass(f"Password for {arguments.add_user}: ")
            if password != getpass.getpass("Repeat password: "):
                print("passwords did not match", file=sys.stderr)
                return 2
            password_file.set_user(arguments.add_user, password)
        except (ValueError, OSError) as error:
            print(error, file=sys.stderr)
            return 2
        except (KeyboardInterrupt, EOFError):
            print("cancelled", file=sys.stderr)
            return 2
        print(f"user {arguments.add_user} written to {password_file.path}")
        print("restart the service to pick it up: sudo systemctl restart usb16x16-web.service")
        return 0

    if arguments.remove_user:
        try:
            if not password_file.remove_user(arguments.remove_user):
                print(f"no such user: {arguments.remove_user}", file=sys.stderr)
                return 2
        except (ValueError, OSError) as error:
            print(error, file=sys.stderr)
            return 2
        print(f"user {arguments.remove_user} removed from {password_file.path}")
        return 0

    static_dir = Path(arguments.static).resolve()
    if not (static_dir / "index.html").is_file():
        print(f"no index.html under {static_dir}", file=sys.stderr)
        return 2

    # Fail closed. Serving this open has to be a decision someone typed, not
    # what happens when a credentials file is missing or unreadable.
    authenticator = None
    if arguments.no_auth:
        print("WARNING: --no-auth, serving without authentication", file=sys.stderr, flush=True)
    else:
        users = password_file.load()
        if not users:
            print(f"no users in {password_file.path}\n"
                  f"add one:  {sys.argv[0]} --auth-file {password_file.path} --add-user NAME\n"
                  f"or serve open with --no-auth", file=sys.stderr)
            return 2
        authenticator = Authenticator(password_file)

    bind = arguments.bind or interface_address(arguments.management_interface) or "127.0.0.1"

    collector = Collector(static_dir, Path(arguments.presets))
    Handler.collector = collector
    Handler.presets = PresetStore(Path(arguments.presets))
    Handler.auth = authenticator

    thread = threading.Thread(target=collector.loop, name="collector", daemon=True)
    thread.start()

    server = ThreadingHTTPServer((bind, arguments.port), Handler)
    server.daemon_threads = True
    guard = f"{len(password_file.load())} user(s)" if authenticator else "NO AUTHENTICATION"
    print(f"usb16x16-web {VERSION} serving {static_dir} on http://{bind}:{arguments.port} ({guard})",
          file=sys.stderr, flush=True)
    try:
        server.serve_forever(poll_interval=0.5)
    except KeyboardInterrupt:
        pass
    finally:
        collector.stop()
        server.server_close()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
