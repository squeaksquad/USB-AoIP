# ------------------------------------------------------------------ helpers

def sha256_of(path: Path) -> str | None:
    try:
        return hashlib.sha256(path.read_bytes()).hexdigest()
    except OSError:
        return None


def read_text(path: Path, limit: int = 1 << 20) -> str | None:
    try:
        with open(path, "r", encoding="utf-8", errors="replace") as handle:
            return handle.read(limit)
    except OSError:
        return None


def write_atomic(path: Path, payload: dict) -> None:
    text = json.dumps(payload, indent=2, sort_keys=True)
    temporary = path.with_name(path.name + ".tmp")
    with open(temporary, "w", encoding="utf-8") as handle:
        handle.write(text)
        handle.flush()
        os.fsync(handle.fileno())
    os.chmod(temporary, 0o644)
    os.replace(temporary, path)


def utc(stamp: float | None = None) -> str:
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(stamp))


class Runner:
    """Commands and the clock, so the tests can stand in for both."""

    def run(self, argv: list[str], timeout: float = 60.0, env: dict | None = None) -> tuple[int, str]:
        try:
            completed = subprocess.run(argv, capture_output=True, text=True, timeout=timeout, check=False,
                                       env={**os.environ, **env} if env else None)
        except (OSError, subprocess.SubprocessError) as error:
            return 1, str(error)
        return completed.returncode, (completed.stdout + completed.stderr).strip()

    def sleep(self, seconds: float) -> None:
        time.sleep(seconds)

    def now(self) -> float:
        return time.time()


# ------------------------------------------------------------------ conf

def parse_conf(text: str) -> dict[str, str]:
    """The subset of the supervisor's parser this program needs: KEY=value
    lines, double quotes stripped, everything else ignored."""
    values: dict[str, str] = {}
    for raw in text.splitlines():
        line = raw.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, _, value = line.partition("=")
        key = key.strip()
        value = value.strip()
        if len(value) >= 2 and value[0] == value[-1] == '"':
            value = value[1:-1]
        values[key] = value
    return values


def profile_key(name: str) -> str:
    return name.upper().replace("-", "_")


def profiles(conf: dict[str, str]) -> dict[str, dict]:
    """Every profile block, by name, with the fields Apply cares about."""
    found: dict[str, dict] = {}
    for key in conf:
        match = re.match(r"^PROFILE_([A-Z0-9_]+)_TARGET$", key)
        if not match:
            continue
        upper = match.group(1)
        name = upper.lower().replace("_", "-")
        field = lambda suffix, u=upper: conf.get(f"PROFILE_{u}_{suffix}", "")
        found[name] = {
            "name": name,
            "status": field("STATUS"),
            "description": field("DESCRIPTION"),
            "measured": field("MEASURED"),
            "cover": field("COVER"),
            "dspPreset": field("DSP_PRESET") or None,
            "dspSha256": field("DSP_SHA256") or None,
            "dspLive": field("DSP_LIVE") == "1",
            "accepted": field("STATUS") == "accepted",
        }
    return found


class Refused(Exception):
    pass


class Failed(Exception):
    """A live push the bridge did not take: nothing to roll back, but not a refusal."""


# ------------------------------------------------------------------ artifact

class ArtifactReader:
    """The bridge's ArtifactReader in Python: whitespace tokens, bounded counts."""

    def __init__(self, text: str) -> None:
        self.lines = text.split("\n")
        self.line = 0
        self.tokens: list[str] = []

    def _fill(self) -> None:
        while not self.tokens:
            if self.line >= len(self.lines):
                raise Refused("artifact ends early")
            self.tokens = self.lines[self.line].split()
            self.line += 1

    def word(self, what: str) -> str:
        self._fill()
        return self.tokens.pop(0)

    def expect(self, word: str) -> None:
        got = self.word(word)
        if got != word:
            raise Refused(f"artifact: expected '{word}', found '{got[:32]}'")

    def count(self, what: str, limit: int) -> int:
        token = self.word(what)
        if not re.match(r"^[0-9]{1,9}$", token):
            raise Refused(f"artifact: {what} is not a count: '{token[:32]}'")
        value = int(token)
        if value > limit:
            raise Refused(f"artifact: {what} {value} is over the bridge's limit {limit}")
        return value

    def real(self, what: str) -> float:
        token = self.word(what)
        try:
            value = float(token)
        except ValueError:
            raise Refused(f"artifact: {what} is not a number: '{token[:32]}'")
        if value != value or value in (float("inf"), float("-inf")):
            raise Refused(f"artifact: {what} is not finite")
        return value

    def rest_of_line(self) -> str:
        rest = " ".join(self.tokens)
        self.tokens = []
        return rest


def parse_artifact(text: str, rate: int = NOMINAL_RATE) -> dict:
    """Walk the artifact exactly as DspStage::load does at `rate`, with its bounds, and
    additionally require every biquad section to be stable (poles inside the
    unit circle: |a2| < 1 and |a1| < 1 + a2) and every gain to be sane. Returns
    the counts the block and the receipt record."""
    if len(text.encode("utf-8")) > MAX_ARTIFACT_BYTES:
        raise Refused(f"artifact is larger than {MAX_ARTIFACT_BYTES} bytes")
    reader = ArtifactReader(text)
    reader.expect("usb16x16-dsp")
    if reader.count("version", 1) != 1:
        raise Refused("artifact: unsupported version")
    reader.expect("preset")
    preset = reader.rest_of_line()
    reader.expect("rate")
    declared_rate = reader.count("rate", 768000)
    if declared_rate != rate:
        raise Refused(f"artifact: compiled for rate {declared_rate}, expected {rate}")
    reader.expect("channels")
    if reader.count("channels", ARTIFACT_CHANNELS) != ARTIFACT_CHANNELS:
        raise Refused("artifact: channel count is not 16")
    reader.expect("internal")
    internal = reader.count("internal", ARTIFACT_MAX_INTERNAL)
    if internal == 0:
        raise Refused("artifact: no internal channels")
    reader.expect("maxdelay")
    declared_delay = reader.count("maxdelay", rate // 100)
    sections = 0
    max_gain = 0.0

    def read_mix(what: str, destinations: int, sources: int) -> int:
        nonlocal max_gain
        reader.expect(what)
        rows = reader.count(what, destinations * sources + 1)
        for _ in range(rows):
            reader.count("mix destination", destinations - 1)
            reader.count("mix source", sources - 1)
            max_gain = max(max_gain, abs(reader.real("mix gain")))
        return rows

    def read_sections(count: int) -> None:
        nonlocal sections
        for _ in range(count):
            b0 = reader.real("b0"); b1 = reader.real("b1"); b2 = reader.real("b2")
            a1 = reader.real("a1"); a2 = reader.real("a2")
            if not (abs(a2) < 1.0 and abs(a1) < 1.0 + a2):
                raise Refused(f"artifact: biquad section {sections + 1} is unstable (a1={a1}, a2={a2})")
            if max(abs(b0), abs(b1), abs(b2)) > 1e3:
                raise Refused(f"artifact: biquad section {sections + 1} has an absurd numerator")
            sections += 1

    read_mix("expand", internal, ARTIFACT_CHANNELS)
    reader.expect("branch")
    for _ in range(reader.count("branch", ARTIFACT_MAX_INTERNAL)):
        reader.count("branch channel", internal - 1)
        read_sections(reader.count("branch sections", ARTIFACT_MAX_SECTIONS))
    read_mix("assign", ARTIFACT_CHANNELS, internal)
    reader.expect("output")
    max_delay = 0
    for _ in range(reader.count("output", ARTIFACT_CHANNELS)):
        reader.count("output index", ARTIFACT_CHANNELS - 1)
        max_delay = max(max_delay, reader.count("output delay", declared_delay))
        max_gain = max(max_gain, abs(reader.real("output gain")))
        read_sections(reader.count("output sections", ARTIFACT_MAX_SECTIONS))
    reader.expect("end")
    if max_gain > 100.0:
        raise Refused(f"artifact: a gain of {max_gain:g} (over +40 dB) is refused")
    if sections > MAX_BIQUADS:
        raise Refused(f"artifact: {sections} biquads, over the {MAX_BIQUADS} the loaded soak passed")
    return {"preset": preset, "internal": internal, "biquads": sections, "maxDelay": max_delay, "rate": rate}


def artifact_shape(text: str) -> str:
    """The canonical shape text: every count and index, with gains, delays
    and coefficients blanked; all 16 outputs in index order. Line for line
    what `artifactShape` (bridge-artifact.mjs) and `DspStage::shape()`
    (bridge_core.cpp) produce; the three are pinned to one vector."""
    lines = [line.strip() for line in text.split("\n") if line.strip()]
    at = 0

    def next_line() -> str:
        nonlocal at
        if at >= len(lines):
            raise Refused("artifact shape: unexpected end")
        at += 1
        return lines[at - 1]

    def header(keyword: str, arity: int = 1) -> list[str]:
        parts = next_line().split()
        if parts[0] != keyword or len(parts) != arity + 1:
            raise Refused(f"artifact shape: expected '{keyword}', found '{' '.join(parts)}'")
        return parts[1:]

    def counted(keyword: str) -> int:
        value = header(keyword)[0]
        if not value.isdigit():
            raise Refused(f"artifact shape: {keyword} count '{value}'")
        return int(value)

    out = []
    if header("usb16x16-dsp")[0] != "1":
        raise Refused("artifact shape: unsupported version")
    out.append("usb16x16-dsp-shape 1")
    if not next_line().startswith("preset"):
        raise Refused("artifact shape: expected 'preset'")
    for keyword in ("rate", "channels", "internal", "maxdelay"):
        out.append(f"{keyword} {header(keyword)[0]}")

    def mix(keyword: str) -> None:
        rows = counted(keyword)
        out.append(f"{keyword} {rows}")
        for row in range(rows):
            parts = next_line().split()
            if len(parts) != 3:
                raise Refused(f"artifact shape: {keyword} row {row + 1}")
            out.append(f"{parts[0]} {parts[1]}")

    def skip(count: int) -> None:
        for _ in range(count):
            next_line()

    mix("expand")
    branches = counted("branch")
    out.append(f"branch {branches}")
    for row in range(branches):
        parts = next_line().split()
        if len(parts) != 2 or not parts[1].isdigit():
            raise Refused(f"artifact shape: branch row {row + 1}")
        out.append(f"{parts[0]} {parts[1]}")
        skip(int(parts[1]))
    mix("assign")
    outputs = counted("output")
    per_output = [0] * ARTIFACT_CHANNELS
    for row in range(outputs):
        parts = next_line().split()
        if len(parts) != 4 or not parts[0].isdigit() or not parts[3].isdigit() or int(parts[0]) >= ARTIFACT_CHANNELS:
            raise Refused(f"artifact shape: output row {row + 1}")
        per_output[int(parts[0])] = int(parts[3])
        skip(int(parts[3]))
    out.append("output 16")
    out.extend(f"{index} {sections}" for index, sections in enumerate(per_output))
    if next_line() != "end" or at != len(lines):
        raise Refused("artifact shape: expected 'end'")
    out.append("end")
    return "\n".join(out) + "\n"


def shape_key(text: str) -> str:
    return hashlib.sha256(artifact_shape(text).encode("utf-8")).hexdigest()


def parse_live_status(text: str | None) -> dict | None:
    """One DSPLIVE line from the bridge: gen=, sha256=, state=, reason="..", t_us=."""
    if not text or not text.startswith("DSPLIVE "):
        return None
    fields: dict = {}
    for match in re.finditer(r'(\w+)=("([^"]*)"|\S+)', text[len("DSPLIVE "):]):
        fields[match.group(1)] = match.group(3) if match.group(3) is not None else match.group(2)
    if "state" not in fields:
        return None
    return fields


# ------------------------------------------------------------------ user blocks

def user_profiles(conf: dict[str, str]) -> dict[str, dict]:
    return {name: row for name, row in profiles(conf).items() if name.startswith("user-")}


def slug_conflicts(slug: str, existing: list[str]) -> str | None:
    """A user slug may not be another's dash-prefix (or the reverse): the
    supervisor addresses a field as PROFILE_<KEY>_<FIELD>, so user-a's
    TX_PLAYBACK_PRIME would be user-a-tx's PLAYBACK_PRIME."""
    for other in existing:
        if other == slug:
            continue
        if other.startswith(slug + "-") or slug.startswith(other + "-"):
            return other
    return None


def block_comment(slug: str) -> str:
    return f"# user preset [user-{slug}]"


def strip_user_block(text: str, slug: str) -> str:
    key = f"PROFILE_USER_{profile_key(slug)}_"
    marker = block_comment(slug)
    kept = [line for line in text.split("\n")
            if not line.startswith(key) and not line.startswith(marker)]
    while len(kept) >= 2 and kept[-1] == "" and kept[-2] == "":
        kept.pop()
    return "\n".join(kept)


def render_user_block(conf_text: str, slug: str, name: str, digest: str, stats: dict) -> str:
    """dsp-direct's transport lines, re-keyed, plus this preset's labels."""
    lines = []
    for raw in conf_text.split("\n"):
        if raw.startswith("PROFILE_DSP_DIRECT_"):
            field = raw[len("PROFILE_DSP_DIRECT_"):].partition("=")[0]
            if field in LABEL_FIELDS:
                continue
            lines.append(f"PROFILE_USER_{profile_key(slug)}_" + raw[len("PROFILE_DSP_DIRECT_"):])
    if not any(line.split("=")[0].endswith("_TARGET") for line in lines):
        raise Refused("the live configuration has no dsp-direct block to copy the transport from")
    key = f"PROFILE_USER_{profile_key(slug)}_"
    safe_name = re.sub(r"[^A-Za-z0-9 ._·-]", "", name)[:64]
    lines = [
        f"{block_comment(slug)} \"{safe_name}\" written by usb16x16-apply {utc()}; transport fields copied from dsp-direct.",
        f'{key}DESCRIPTION="user preset: {safe_name} ({stats["biquads"]} biquads, max delay {stats["maxDelay"]} samples)"',
        f"{key}STATUS=experimental",
        f'{key}COVER="guards, not a soak: loaded by the bridge loader, {stats["biquads"]} stable sections, transport = dsp-direct"',
        f'{key}MEASURED="not measured"',
    ] + lines + [
        f"{key}DSP_PRESET={DSP_DIR}/user-{slug}.dsp",
        f"{key}DSP_SHA256={digest}",
        # The bridge's live file: user presets are the only profiles that
        # take live coefficient updates (LIVE_COEFFICIENTS_DESIGN.md).
        f"{key}DSP_LIVE=1",
    ]
    return "\n".join(lines) + "\n"


def with_user_sha256(conf_text: str, slug: str, digest: str) -> str:
    """The block's pin moved to the committed file; nothing else in it changes."""
    key = f"PROFILE_USER_{profile_key(slug)}_DSP_SHA256="
    lines = conf_text.split("\n")
    hits = [index for index, line in enumerate(lines) if line.startswith(key)]
    if len(hits) != 1:
        raise Refused(f"user-{slug} has {len(hits)} DSP_SHA256 lines; expected one")
    lines[hits[0]] = key + digest
    return "\n".join(lines)


def with_user_block(conf_text: str, slug: str, block: str | None) -> str:
    base = strip_user_block(conf_text, slug).rstrip("\n") + "\n"
    if block is None:
        return base
    return base + "\n" + block


# ------------------------------------------------------------------ applier


class Applier:
    ENGINE = "bridge"   # what follows the live file, for messages

    def __init__(self, spool: Path = SPOOL_DIR, conf_path: Path = CONF_PATH, run_dir: Path = RUN_DIR,
                 runner: Runner | None = None, supervisor: str = SUPERVISOR,
                 bridge_binary: Path = BRIDGE_BINARY, start_timeout: float = START_TIMEOUT_S,
                 settle: float = SETTLE_S, poll: float = POLL_S) -> None:
        self.spool = spool
        self.conf_path = conf_path
        self.run_dir = run_dir
        self.runner = runner or Runner()
        self.supervisor = supervisor
        self.bridge_binary = bridge_binary
        self.start_timeout = start_timeout
        self.settle = settle
        self.poll = poll
        self.state: dict = {}

    # ---- state and receipts

    @property
    def request_path(self) -> Path:
        return self.spool / REQUEST_NAME

    @property
    def state_path(self) -> Path:
        return self.spool / STATE_NAME

    @property
    def receipt_dir(self) -> Path:
        return self.spool / RECEIPT_DIR

    def step(self, name: str, detail: str = "", ok: bool = True) -> None:
        self.state["state"] = name
        self.state["updatedAt"] = utc(self.runner.now())
        self.state.setdefault("steps", []).append(
            {"name": name, "at": self.state["updatedAt"], "ok": ok, "detail": detail})
        write_atomic(self.state_path, self.state)

    def finish(self, state: str, error: str | None = None) -> dict:
        self.state["state"] = state
        self.state["error"] = error
        self.state["finishedAt"] = utc(self.runner.now())
        self.state["updatedAt"] = self.state["finishedAt"]
        self.state["live"] = self.live_profile()
        self.state["identity"] = self.identity()
        write_atomic(self.state_path, self.state)
        self.receipt_dir.mkdir(mode=0o755, exist_ok=True)
        write_atomic(self.receipt_dir / f"{self.state['id']}.json", self.state)
        return self.state

    # ---- reads

    def conf(self) -> dict[str, str]:
        text = read_text(self.conf_path)
        if text is None:
            raise Refused(f"cannot read {self.conf_path}")
        return parse_conf(text)

    def live_profile(self) -> str | None:
        try:
            return self.conf().get("PROFILE") or None
        except Refused:
            return None

    def identity(self) -> dict:
        return {
            "bridgeSha256": sha256_of(self.bridge_binary),
            "supervisorSha256": sha256_of(Path(self.supervisor)),
            "confSha256": sha256_of(self.conf_path),
        }

    def unit_state(self) -> str:
        code, out = self.runner.run(["systemctl", "show", "-p", "ActiveState", "--value", UNIT], timeout=10)
        return out.strip() if code == 0 else "unknown"

    def stage(self) -> tuple[str, float | None]:
        text = read_text(self.run_dir / "stage", 4096)
        if not text:
            return "", None
        stamp, _, rest = text.strip().partition(" ")
        try:
            return rest.strip(), float(stamp)
        except ValueError:
            return text.strip(), None

    def bridge_line(self) -> dict:
        path = self.run_dir / "last-bridge"
        line = read_text(path, 8192) or ""
        if not line.startswith("BRIDGE"):
            return {}
        fields: dict = {}
        for token in line.split()[1:]:
            key, sep, value = token.partition("=")
            if sep:
                fields[key] = value
        try:
            fields["_age"] = self.runner.now() - path.stat().st_mtime
        except OSError:
            fields["_age"] = None
        return fields

    def recovers(self) -> int:
        text = read_text(self.run_dir / "recovers", 1 << 20)
        return len([v for v in (text or "").splitlines() if v.strip()])

    def bridge_log_head(self, lines: int = 400) -> list[str]:
        text = read_text(self.run_dir / "bridge.log", 1 << 18) or ""
        return text.splitlines()[:lines]

    # ---- request validation

    def load_request(self) -> dict:
        text = read_text(self.request_path, 65536)
        if text is None:
            raise Refused("no request file")
        try:
            request = json.loads(text)
        except ValueError:
            raise Refused("request is not JSON")
        if not isinstance(request, dict):
            raise Refused("request is not an object")
        return request

    def validate_envelope(self, request: dict) -> None:
        """The checks every request shares: an id, unseen, and fresh."""
        ident = request.get("id")
        if not isinstance(ident, str) or not REQUEST_ID.match(ident):
            raise Refused("request id must be 8-32 hex characters")
        if (self.receipt_dir / f"{ident}.json").exists() and self.state.get("state") == "validating" and not self.state.get("steps"):
            raise Refused(f"request {ident} was already processed")
        requested_at = request.get("requestedAt")
        if not isinstance(requested_at, (int, float)):
            raise Refused("requestedAt must be a unix time")
        age = self.runner.now() - float(requested_at)
        if age < -REQUEST_MAX_AGE_S or age > REQUEST_MAX_AGE_S:
            raise Refused(f"request is {age:.0f} s old; the limit is {REQUEST_MAX_AGE_S:.0f} s")

    def validate(self, request: dict, conf: dict[str, str]) -> dict:
        """Everything that can be checked before touching the service."""
        self.validate_envelope(request)
        name = request.get("profile")
        if not isinstance(name, str) or not PROFILE_NAME.match(name):
            raise Refused("profile name must be lower-case letters, digits and dashes")
        table = profiles(conf)
        if name not in table:
            raise Refused(f"profile {name} has no block in {self.conf_path}")
        if not table[name]["accepted"] and not self.user_profile_ok(table[name]):
            raise Refused(f"profile {name} is {table[name]['status'] or 'unmarked'}, not accepted; "
                          "Apply only switches between accepted profiles and its own user presets")
        live = conf.get("PROFILE") or ""
        expected = request.get("expectedProfile")
        if expected is not None and expected != live:
            raise Refused(f"the page expected {expected} to be live but {live} is; reload and retry")
        if name == live:
            raise Refused(f"{name} is already the live profile")
        unit = self.unit_state()
        if unit not in ("active", "inactive", "failed"):
            raise Refused(f"{UNIT} is {unit}; retry when it has settled")
        return table[name]

    def user_profile_ok(self, row: dict) -> bool:
        """A user block this program wrote: a user-<slug> name (the identity),
        STATUS=experimental (the supervisor's word for a profile it will
        switch to without an acceptance: it refuses anything else), and the
        installed file still hashing to the block's pin."""
        if row.get("status") != "experimental" or not row["name"].startswith("user-"):
            return False
        preset = row.get("dspPreset") or ""
        return preset.startswith(str(DSP_DIR) + "/user-") and sha256_of(Path(preset)) == row.get("dspSha256")

    # ---- the configuration file

    def validate_conf_text(self, text: str, must_list: str) -> None:
        """The supervisor's own parser on a temporary copy; nothing else is
        allowed to decide whether a configuration is loadable."""
        temporary = self.conf_path.with_name(f".{self.conf_path.name}.apply-{os.getpid()}")
        temporary.write_text(text, encoding="utf-8")
        try:
            code, out = self.runner.run([self.supervisor, "profiles"], timeout=30,
                                        env={"USB16X16_AES67_CONF": str(temporary)})
        finally:
            temporary.unlink(missing_ok=True)
        if code != 0:
            raise Refused(f"the supervisor rejects the configuration: {out[:300]}")
        if must_list and f"{must_list}:" not in out:
            raise Refused(f"the supervisor does not list {must_list} after the edit")

    def replace_conf(self, text: str) -> None:
        stat = self.conf_path.stat()
        temporary = self.conf_path.with_name(f".{self.conf_path.name}.new-{os.getpid()}")
        with open(temporary, "w", encoding="utf-8") as handle:
            handle.write(text)
            handle.flush()
            os.fsync(handle.fileno())
        os.chmod(temporary, stat.st_mode & 0o7777)
        try:
            os.chown(temporary, stat.st_uid, stat.st_gid)
        except PermissionError:
            pass
        os.replace(temporary, self.conf_path)

    # ---- presets

    def validate_preset(self, request: dict, conf: dict[str, str]) -> dict:
        name = request.get("name")
        if not isinstance(name, str) or not PRESET_NAME.match(name):
            raise Refused("preset name must be 1-64 letters, digits, spaces, dots or dashes")
        slug = request.get("slug")
        if not isinstance(slug, str) or not USER_SLUG.match(slug) or "--" in slug or slug.endswith("-"):
            raise Refused("preset slug must be 1-24 lower-case letters, digits and single dashes")
        digest = request.get("artifactSha256")
        if not isinstance(digest, str) or not re.match(r"^[0-9a-f]{64}$", digest):
            raise Refused("artifactSha256 must be 64 hex characters")
        file_name = request.get("artifactFile")
        if not isinstance(file_name, str) or not re.match(r"^[a-f0-9]{8,32}\.dsp$", file_name):
            raise Refused("artifactFile must be <request id>.dsp in the spool's presets directory")
        source = self.spool / "presets" / file_name
        try:
            data = source.read_bytes()
        except OSError:
            raise Refused(f"artifact {file_name} is missing from the spool")
        if hashlib.sha256(data).hexdigest() != digest:
            raise Refused("artifact hash does not match artifactSha256")
        stats = parse_artifact(data.decode("utf-8", errors="replace"))
        existing = user_profiles(conf)
        clash = slug_conflicts(slug, list(n[len("user-"):] for n in existing))
        if clash:
            raise Refused(f"slug {slug} would collide with the existing preset user-{clash}")
        replacing = f"user-{slug}" in existing
        if not replacing and len(existing) >= USER_PROFILE_CAP:
            raise Refused(f"{USER_PROFILE_CAP} user presets are installed; remove one first")
        live = conf.get("PROFILE") or ""
        expected = request.get("expectedProfile")
        if expected is not None and expected != live:
            raise Refused(f"the page expected {expected} to be live but {live} is; reload and retry")
        unit = self.unit_state()
        if unit not in ("active", "inactive", "failed"):
            raise Refused(f"{UNIT} is {unit}; retry when it has settled")
        if not Path(OFFLINE_RUNNER).is_file():
            raise Refused(f"{OFFLINE_RUNNER} is not installed; user presets cannot be load-checked")
        return {"name": name, "slug": slug, "digest": digest, "data": data, "stats": stats, "replacing": replacing}

    def install_preset(self, spec: dict, conf_text: str) -> str:
        """Load-check, install the file, write the block, validate, replace."""
        slug = spec["slug"]
        self.step("checking", f"{OFFLINE_RUNNER} --bench 1 on the artifact ({spec['stats']['biquads']} biquads)")
        staged = self.spool / "presets" / f"check-{self.state['id']}.dsp"
        staged.write_bytes(spec["data"])
        try:
            code, out = self.runner.run([OFFLINE_RUNNER, str(staged), "--bench", "1"], timeout=60)
        finally:
            staged.unlink(missing_ok=True)
        if code != 0:
            raise Refused(f"the bridge's loader refused the artifact: {out[:300]}")
        self.state["loaderLine"] = out.splitlines()[0][:200] if out else ""
        target = DSP_DIR / f"user-{slug}.dsp"
        self.step("installing", f"{target} and the user-{slug} block")
        DSP_DIR.mkdir(mode=0o755, exist_ok=True)
        temporary = DSP_DIR / f".user-{slug}.dsp.tmp"
        with open(temporary, "wb") as handle:
            handle.write(spec["data"])
            handle.flush()
            os.fsync(handle.fileno())
        os.chmod(temporary, 0o644)
        try:
            os.chown(temporary, 0, 0)
        except PermissionError:
            pass
        os.replace(temporary, target)
        block = render_user_block(conf_text, slug, spec["name"], spec["digest"], spec["stats"])
        new_text = with_user_block(conf_text, slug, block)
        self.validate_conf_text(new_text, f"user-{slug}")
        self.replace_conf(new_text)
        return f"user-{slug}"

    def remove_preset(self, request: dict, conf: dict[str, str], conf_text: str) -> str:
        slug = request.get("slug")
        if not isinstance(slug, str) or not USER_SLUG.match(slug):
            raise Refused("slug must name a user preset")
        name = f"user-{slug}"
        if name not in user_profiles(conf):
            raise Refused(f"{name} is not installed")
        if (conf.get("PROFILE") or "") == name:
            raise Refused(f"{name} is the live profile; switch away before removing it")
        self.step("removing", f"{name} block and {DSP_DIR}/{name}.dsp")
        new_text = with_user_block(conf_text, slug, None)
        self.validate_conf_text(new_text, "")
        self.replace_conf(new_text)
        (DSP_DIR / f"{name}.dsp").unlink(missing_ok=True)
        return name

    # ---- live coefficient updates (no restart)

    @property
    def live_file(self) -> Path:
        return self.run_dir / LIVE_FILE

    @property
    def live_status_path(self) -> Path:
        return self.run_dir / LIVE_STATUS

    def live_status(self) -> dict | None:
        return parse_live_status(read_text(self.live_status_path, 4096))

    def live_target(self, request: dict, conf: dict[str, str]) -> dict:
        """The live profile must be a user preset with DSP_LIVE=1 whose
        installed file still hashes to its pin; the page must agree on it."""
        live = conf.get("PROFILE") or ""
        expected = request.get("expectedProfile")
        if expected is not None and expected != live:
            raise Refused(f"the page expected {expected} to be live but {live} is; reload and retry")
        table = profiles(conf)
        row = table.get(live)
        if row is None or not self.user_profile_ok(row):
            raise Refused(f"{live or 'no profile'} is not a user preset; live updates never touch an accepted profile")
        if not row.get("dspLive"):
            raise Refused(f"{live} has no DSP_LIVE=1: the bridge started without a live file; re-apply the preset")
        if self.unit_state() != "active":
            raise Refused(f"{UNIT} is {self.unit_state()}; nothing is running to update")
        expected_sha = request.get("expectedLiveSha256")
        if expected_sha is not None:
            status = self.live_status()
            current = (status or {}).get("sha256", "none")
            if not isinstance(expected_sha, str) or expected_sha != current:
                raise Refused(f"the page expected live coefficients {expected_sha} but the bridge reports {current}; reload and retry")
        return row

    def validate_live(self, request: dict, conf: dict[str, str]) -> dict:
        row = self.live_target(request, conf)
        if request.get("revert") is True:
            # Discard the preview: the installed file goes back to the bridge.
            installed = Path(row["dspPreset"]).read_bytes()
            if hashlib.sha256(installed).hexdigest() != row.get("dspSha256"):
                raise Refused(f"{row['dspPreset']} does not hash to its block's pin")
            text = installed.decode("utf-8", errors="replace")
            return {"profile": row["name"], "digest": row["dspSha256"], "data": installed,
                    "stats": parse_artifact(text), "shape": shape_key(text), "revert": True}
        digest = request.get("artifactSha256")
        if not isinstance(digest, str) or not re.match(r"^[0-9a-f]{64}$", digest):
            raise Refused("artifactSha256 must be 64 hex characters")
        file_name = request.get("artifactFile")
        if not isinstance(file_name, str) or not re.match(r"^[a-f0-9]{8,32}\.dsp$", file_name):
            raise Refused("artifactFile must be <request id>.dsp in the spool's presets directory")
        source = self.spool / "presets" / file_name
        try:
            data = source.read_bytes()
        except OSError:
            raise Refused(f"artifact {file_name} is missing from the spool")
        if hashlib.sha256(data).hexdigest() != digest:
            raise Refused("artifact hash does not match artifactSha256")
        text = data.decode("utf-8", errors="replace")
        stats = parse_artifact(text)
        installed = read_text(Path(row["dspPreset"]), MAX_ARTIFACT_BYTES + 1)
        if installed is None:
            raise Refused(f"{row['dspPreset']} cannot be read")
        want = shape_key(installed)
        have = shape_key(text)
        if have != want:
            raise Refused(f"shape differs from the installed preset ({have[:12]} vs {want[:12]}): "
                          "this edit changes the pipeline's shape and needs Compile & apply")
        if not Path(OFFLINE_RUNNER).is_file():
            raise Refused(f"{OFFLINE_RUNNER} is not installed; live updates cannot be load-checked")
        return {"profile": row["name"], "digest": digest, "data": data, "stats": stats, "shape": have}

    def push_live(self, spec: dict) -> None:
        """Load-check, write the live file by rename, wait for the bridge."""
        self.step("checking", f"{OFFLINE_RUNNER} --bench 1 on the artifact ({spec['stats']['biquads']} biquads)")
        staged = self.spool / "presets" / f"check-{self.state['id']}.dsp"
        staged.write_bytes(spec["data"])
        try:
            code, out = self.runner.run([OFFLINE_RUNNER, str(staged), "--bench", "1"], timeout=60)
        finally:
            staged.unlink(missing_ok=True)
        if code != 0:
            raise Refused(f"the bridge's loader refused the artifact: {out[:300]}")
        self.state["loaderLine"] = out.splitlines()[0][:200] if out else ""
        self.step("pushing", f"{self.live_file} ({spec['digest'][:12]})")
        # The bridge answers by rewriting its status line, so a line that has
        # not changed since before the push is an old answer, whatever hash it
        # names (t_us makes every answer distinct).
        before = read_text(self.live_status_path, 4096)
        temporary = self.live_file.with_name(f".{LIVE_FILE}.{self.state['id']}")
        with open(temporary, "wb") as handle:
            handle.write(spec["data"])
            handle.flush()
        os.chmod(temporary, 0o644)
        os.replace(temporary, self.live_file)
        self.step("verifying", f"waiting up to {LIVE_TIMEOUT_S:.0f} s for the {self.ENGINE} to report {spec['digest'][:12]}")
        deadline = self.runner.now() + LIVE_TIMEOUT_S
        while True:
            text = read_text(self.live_status_path, 4096)
            status = parse_live_status(text) if text != before else None
            if status and status.get("sha256") == spec["digest"]:
                if status.get("state") == "applied":
                    self.state["liveUpdate"] = {"gen": status.get("gen"), "sha256": spec["digest"], "line": status}
                    return
                raise Failed(f"the {self.ENGINE} {status.get('state')} the artifact: {status.get('reason') or 'no reason'}")
            if self.runner.now() >= deadline:
                raise Failed(f"the {self.ENGINE} did not report {spec['digest'][:12]} within {LIVE_TIMEOUT_S:.0f} s "
                             f"(status: {status.get('state') if status else 'none'}); the file is left for it")
            self.runner.sleep(LIVE_POLL_S)

    def commit_live(self, request: dict, conf: dict[str, str], conf_text: str) -> dict:
        """The applied live file becomes the installed preset; no restart."""
        row = self.live_target(request, conf)
        status = self.live_status()
        if not status or status.get("state") != "applied":
            raise Refused(f"nothing applied to commit (bridge status: {status.get('state') if status else 'none'})")
        digest = status.get("sha256") or ""
        data = None
        try:
            data = self.live_file.read_bytes()
        except OSError:
            pass
        if data is None or hashlib.sha256(data).hexdigest() != digest:
            raise Refused("the live file no longer matches what the bridge applied; push it again")
        text = data.decode("utf-8", errors="replace")
        stats = parse_artifact(text)
        installed_path = Path(row["dspPreset"])
        installed = read_text(installed_path, MAX_ARTIFACT_BYTES + 1) or ""
        if shape_key(installed) != shape_key(text):
            raise Refused("the live file's shape differs from the installed preset; it cannot be committed")
        if digest == row.get("dspSha256"):
            self.step("committing", "the live coefficients already equal the installed file")
            return {"profile": row["name"], "digest": digest, "stats": stats, "changed": False}
        slug = row["name"][len("user-"):]
        self.step("committing", f"{installed_path} <- live {digest[:12]}, block pin rewritten, no restart")
        temporary = installed_path.with_name(f".{installed_path.name}.commit")
        with open(temporary, "wb") as handle:
            handle.write(data)
            handle.flush()
            os.fsync(handle.fileno())
        os.chmod(temporary, 0o644)
        try:
            os.chown(temporary, 0, 0)
        except PermissionError:
            pass
        new_text = with_user_sha256(conf_text, slug, digest)
        self.validate_conf_text(new_text, row["name"])
        os.replace(temporary, installed_path)
        self.replace_conf(new_text)
        return {"profile": row["name"], "digest": digest, "stats": stats, "changed": True}

    # ---- the operation

    def switch(self, name: str, target: dict) -> str | None:
        """Stop, switch, start, verify. Returns None on success or the reason."""
        self.step("stopping", f"systemctl stop {UNIT}")
        code, out = self.runner.run(["systemctl", "stop", UNIT], timeout=60)
        if code != 0:
            return f"stop failed: {out}"
        self.step("switching", f"{self.supervisor} switch-profile {name}")
        code, out = self.runner.run([self.supervisor, "switch-profile", name], timeout=30)
        if code != 0:
            return f"switch-profile refused: {out}"
        if self.live_profile() != name:
            return f"PROFILE= did not become {name}"
        self.step("starting", f"systemctl start {UNIT}")
        code, out = self.runner.run(["systemctl", "start", UNIT], timeout=60)
        if code != 0:
            return f"start failed: {out}"
        self.step("verifying", f"waiting up to {self.start_timeout:.0f} s for STAGE running")
        return self.verify(target)

    def verify(self, target: dict) -> str | None:
        deadline = self.runner.now() + self.start_timeout
        stage_text = ""
        while True:
            stage_text, stamp = self.stage()
            if stage_text.startswith("failed") or stage_text.startswith("backoff"):
                return f"supervisor: {stage_text}"
            if self.unit_state() in ("failed", "inactive"):
                return f"{UNIT} is {self.unit_state()} (stage: {stage_text or 'none'})"
            if stage_text.startswith("running") or stage_text.startswith("stable"):
                break
            if self.runner.now() >= deadline:
                return f"no STAGE running within {self.start_timeout:.0f} s (stage: {stage_text or 'none'})"
            self.runner.sleep(self.poll)
        # The first BRIDGE line follows STAGE running by about a second; give
        # it a bounded grace before reading its absence as a failure.
        grace_end = self.runner.now() + BRIDGE_LINE_GRACE_S
        while True:
            reason = self.check_bridge(target)
            if reason is None or not reason.startswith(("no BRIDGE telemetry line", "BRIDGE line is stale")):
                break
            if self.runner.now() >= grace_end:
                break
            self.runner.sleep(self.poll)
        if reason:
            return reason
        self.step("settling", f"{self.settle:.0f} s with zero RECOVERs and no direction restart")
        settle_end = self.runner.now() + self.settle
        while self.runner.now() < settle_end:
            self.runner.sleep(self.poll)
            reason = self.check_bridge(target)
            if reason:
                return reason
        return None

    def check_bridge(self, target: dict) -> str | None:
        line = self.bridge_line()
        if not line:
            return "no BRIDGE telemetry line"
        if line.get("_age") is None or line["_age"] > 5.0:
            return f"BRIDGE line is stale ({line.get('_age')} s)"
        if line.get("tx_restarts", "0") != "0" or line.get("rx_restarts", "0") != "0":
            return f"direction restarts tx={line.get('tx_restarts')} rx={line.get('rx_restarts')}"
        count = self.recovers()
        if count:
            return f"{count} RECOVER since the start"
        head = self.bridge_log_head()
        loaded = [v for v in head if v.startswith("DSP loaded ")]
        engaged = [v for v in head if v.startswith("DSP engaged ")]
        preset = target.get("dspPreset")
        if preset:
            if not loaded or f"file={preset}" not in loaded[0]:
                return f"bridge log has no 'DSP loaded file={preset}' line"
            if not engaged:
                return "bridge log has no 'DSP engaged' line"
        elif loaded:
            return "a preset was loaded on a profile without one"
        stage_text, _ = self.stage()
        if stage_text.startswith("failed") or stage_text.startswith("backoff"):
            return f"supervisor: {stage_text}"
        return None

    def record_start_lines(self, label: str) -> None:
        keep = ("NEGOTIATED ", "ALIGN ", "PRIMED ", "DSP ", "PITCHSERVO ")
        self.state.setdefault("startLines", {})[label] = [
            v[:400] for v in self.bridge_log_head() if v.startswith(keep)][:12]

    def apply(self, request: dict) -> dict:
        self.spool.mkdir(mode=0o755, exist_ok=True)
        ident = request.get("id") if isinstance(request.get("id"), str) and REQUEST_ID.match(request.get("id", "")) else "invalid"
        kind = request.get("kind") or "profile"
        self.state = {
            "version": VERSION,
            "id": ident,
            "kind": kind,
            "request": {k: request.get(k) for k in ("kind", "profile", "expectedProfile", "requestedAt", "requestedBy",
                                                     "name", "slug", "artifactSha256", "expectedLiveSha256", "revert")},
            "startedAt": utc(self.runner.now()),
            "steps": [],
            "previousProfile": None,
            "profile": None,
            "state": "validating",
            "error": None,
        }
        try:
            conf = self.conf()
            if kind == "preset":
                spec = self.validate_preset(request, conf)
                self.step("validating", f"{spec['stats']['biquads']} biquads, internal {spec['stats']['internal']}, "
                                        f"{'replacing' if spec['replacing'] else 'new'} user-{spec['slug']}")
                conf_text = read_text(self.conf_path) or ""
                name = self.install_preset(spec, conf_text)
                conf = self.conf()
                self.state["stats"] = spec["stats"]
                request = {**request, "profile": name}
                target = self.validate(request, conf)
            elif kind == "remove":
                conf_text = read_text(self.conf_path) or ""
                name = self.remove_preset(request, conf, conf_text)
                self.state["profile"] = name
                return self.finish("done")
            elif kind == "live":
                spec = self.validate_live(request, conf)
                self.state["profile"] = spec["profile"]
                self.state["stats"] = spec["stats"]
                self.state["shape"] = spec["shape"]
                self.step("validating", f"{spec['stats']['biquads']} biquads, shape {spec['shape'][:12]} matches {spec['profile']}")
                try:
                    self.push_live(spec)
                except Failed as error:
                    self.state["steps"].append({"name": "verifying", "at": utc(self.runner.now()), "ok": False, "detail": str(error)})
                    return self.finish("failed", str(error))
                return self.finish("done")
            elif kind == "commit":
                conf_text = read_text(self.conf_path) or ""
                outcome = self.commit_live(request, conf, conf_text)
                self.state["profile"] = outcome["profile"]
                self.state["stats"] = outcome["stats"]
                self.state["committed"] = {"sha256": outcome["digest"], "changed": outcome["changed"]}
                return self.finish("done")
            elif kind == "shutdown":
                self.validate_envelope(request)
                return self.shutdown(conf)
            elif kind == "profile":
                target = self.validate(request, conf)
            else:
                raise Refused(f"unknown request kind {kind!r}")
        except Refused as error:
            self.state["steps"].append({"name": "validating", "at": utc(self.runner.now()), "ok": False, "detail": str(error)})
            return self.finish("refused", str(error))
        previous = conf.get("PROFILE") or ""
        self.state["previousProfile"] = previous
        self.state["profile"] = target["name"]
        self.step("validating", f"{target['name']} is accepted; live profile {previous}")
        reason = self.switch(target["name"], target)
        self.record_start_lines(target["name"])
        if reason is None:
            return self.finish("done")
        self.step("rolling-back", f"{reason}; returning to {previous}", ok=False)
        table = profiles(conf)
        rollback_target = table.get(previous, {"name": previous, "dspPreset": None})
        if not previous or previous not in table:
            return self.finish("failed", f"{reason}; no previous profile to return to")
        rollback_reason = self.switch(previous, rollback_target)
        self.record_start_lines(previous)
        if rollback_reason is None:
            return self.finish("rolled-back", reason)
        return self.finish("failed", f"{reason}; rollback to {previous} also failed: {rollback_reason}")

    def shutdown(self, conf: dict[str, str]) -> dict:
        """Stop the AES67 service in order, leave the receipt, then power off.

        The stop is best effort and recorded either way: a service that will
        not stop cleanly is no reason to leave the box running when the
        operator asked for it off, and systemd stops it again on the way
        down. The receipt goes to disk before poweroff is requested because
        nothing after that is guaranteed to run."""
        self.state["profile"] = conf.get("PROFILE") or None
        self.step("validating", f"shutdown requested; live profile {self.state['profile'] or 'unknown'}")
        self.step("stopping", f"systemctl stop {UNIT}")
        code, out = self.runner.run(["systemctl", "stop", UNIT], timeout=90)
        if code != 0:
            self.state["steps"].append({"name": "stopping", "at": utc(self.runner.now()), "ok": False,
                                        "detail": f"stop exited {code}: {out.strip()[:200]}; powering off regardless"})
        self.step("powering-off", "systemctl poweroff --no-block")
        self.finish("done")
        code, out = self.runner.run(["systemctl", "poweroff", "--no-block"], timeout=30)
        if code != 0:
            self.state["steps"].append({"name": "powering-off", "at": utc(self.runner.now()), "ok": False,
                                        "detail": f"poweroff exited {code}: {out.strip()[:200]}"})
            return self.finish("failed", f"systemctl poweroff exited {code}: {out.strip()[:200]}")
        return self.state

    def consume(self) -> dict | None:
        """One path-unit trigger: take the request file, act, leave receipts."""
        try:
            request = self.load_request()
        except Refused as error:
            if str(error) == "no request file":
                return None
            self.state = {"version": VERSION, "id": "invalid", "request": None, "startedAt": utc(self.runner.now()),
                          "steps": [], "previousProfile": None, "profile": None, "state": "validating", "error": None}
            self.request_path.unlink(missing_ok=True)
            return self.finish("refused", str(error))
        # The request is consumed before acting so a re-trigger finds nothing.
        self.request_path.unlink(missing_ok=True)
        try:
            return self.apply(request)
        finally:
            artifact = request.get("artifactFile") if isinstance(request, dict) else None
            if isinstance(artifact, str) and re.match(r"^[a-f0-9]{8,32}\.dsp$", artifact):
                (self.spool / "presets" / artifact).unlink(missing_ok=True)
            # The other rates' artifacts a Dante preset or commit carries.
            extra = request.get("rateArtifacts") if isinstance(request, dict) else None
            if isinstance(extra, dict):
                for entry in extra.values():
                    name = entry.get("file") if isinstance(entry, dict) else None
                    if isinstance(name, str) and RATE_ARTIFACT_FILE.match(name):
                        (self.spool / "presets" / name).unlink(missing_ok=True)


# ------------------------------------------------------------------ the Dante stack
#
# The same requests against usb16x16-dante.service (2026-10-11). There is no
# supervisor and no table of profiles: the owner's configuration is the few
# lines of /etc/usb16x16/dante/owner.conf that usb16x16-dante-start turns into
# a command line, and a "profile" is one of
#
#   direct          no preset: the owner copies integers
#   dante-<slug>    the artifact /etc/usb16x16/dsp/dante-<slug>.dsp, installed
#                   by a "preset" request; started with live following on
#
# A switch rewrites owner.conf (the wrapper's own parser checks the new text
# on a copy first), restarts the unit and verifies it: the unit stays active
# on one start, the owner's log carries the DSP loaded line the profile calls
# for (or none) and both Inferno streams running, and nothing fatal follows in
# the settle window. On failure the previous owner.conf goes back by the same
# steps. "live" and "commit" are the bridge's, against /run/usb16x16-dante/.
# The artifact guards and the load check (usb16x16-dsp-offline, the same
# loader the owner links) are shared. Dante presets carry their own prefix so
# that removing one can never take a file an AES67 profile block pins.

DANTE_UNIT = "usb16x16-dante.service"
DANTE_CONF_PATH = Path(os.environ.get("USB16X16_DANTE_CONF", "/etc/usb16x16/dante/owner.conf"))
DANTE_RUN_DIR = Path(os.environ.get("USB16X16_DANTE_RUN_DIR", "/run/usb16x16-dante"))
DANTE_OWNER = Path(os.environ.get("USB16X16_DANTE_OWNER", "/usr/local/libexec/usb16x16-dante/usb16x16-dante-owner"))
DANTE_START = os.environ.get("USB16X16_DANTE_START", "/usr/local/libexec/usb16x16-dante/usb16x16-dante-start")
DANTE_DIRECT = "direct"
DANTE_PREFIX = "dante-"
DANTE_CONF_KEYS = ("METERS", "DSP_PRESET", "DSP_SHA256", "DSP_LIVE", "RATE")
# The unit waits up to 40 s for the clock before it starts the owner.
DANTE_START_TIMEOUT_S = 75.0
DANTE_SETTLE_S = 15.0
# The arbiter (SAMPLE_RATE_DESIGN.md, step 4): the Inferno config whose
# SAMPLE_RATE moves with owner.conf's RATE, the request file the owner and
# Inferno write, and how long a request waits for the other end to agree.
DANTE_INFERNO_CONF = Path(os.environ.get("USB16X16_DANTE_INFERNO_CONF", "/etc/usb16x16/dante/asound-inferno-owner.conf"))
DANTE_RATE_REQUEST = Path(os.environ.get("USB16X16_DANTE_RATE_REQUEST", "/run/usb16x16-dante/rate-request"))
GADGET_CARD = "UAC2Gadget"
# The gadget's writable rate control (uac2-rate-request patch): writing a rate
# moves the gadget's clock and sends the Mac the clock's SAM_FREQ interrupt, and
# the Mac re-reads the clock and follows (RATE_REPORT_PLAN.md, Mac-follow).
GADGET_RATE_REQUEST = "Device Rate Request"
RATE_HOST_WAIT_S = 5.0
RATE_REVERSAL_S = 30.0
RATE_SOURCES = ("dante", "usb", "page")


def parse_owner_conf(text: str) -> dict[str, str]:
    """owner.conf as usb16x16-dante-start reads it: KEY=value, nothing else."""
    values: dict[str, str] = {}
    for raw in text.splitlines():
        if not raw or raw.startswith("#"):
            continue
        match = re.match(r"^([A-Z0-9_]+)=(.*)$", raw)
        if not match or match.group(1) not in DANTE_CONF_KEYS:
            raise Refused(f"owner.conf: unexpected line: {raw[:60]}")
        values[match.group(1)] = match.group(2)
    return values


def render_owner_conf(meters: str, preset: Path | None, digest: str | None, rate: str | None = None) -> str:
    """`rate` is carried as it was found: absent stays absent (the owner's 48000),
    so a 48 kHz configuration is written exactly as before rates existed."""
    lines = ["# /etc/usb16x16/dante/owner.conf: how usb16x16-dante.service starts the owner.",
             f"# Written by usb16x16-apply {utc()}; read by usb16x16-dante-start.",
             f"METERS={meters}"]
    if rate:
        lines.append(f"RATE={rate}")
    if preset is not None:
        lines += [f"DSP_PRESET={preset}", f"DSP_SHA256={digest}", "DSP_LIVE=1"]
    return "\n".join(lines) + "\n"


def running_rate(conf: dict[str, str]) -> int:
    value = conf.get("RATE") or str(NOMINAL_RATE)
    if not value.isdigit() or int(value) not in DANTE_RATES:
        raise Refused(f"owner.conf: RATE={value} is not a Dante rate")
    return int(value)


def rate_file(name: str, rate: int) -> Path:
    """A Dante preset's artifact for one rate. 48 kHz keeps the name it has had
    since before rates (dante-<slug>.dsp), so nothing installed needs moving;
    any other rate sits beside it as dante-<slug>@<rate>.dsp."""
    return DSP_DIR / (f"{name}.dsp" if rate == NOMINAL_RATE else f"{name}@{rate}.dsp")


def inferno_rates(text: str) -> tuple[int, list[int]]:
    """SAMPLE_RATE and SUPPORTED_SAMPLE_RATES (patches/0004) from the Inferno
    config. With no supported list the only rate offered is the current one."""
    current = re.findall(r'(?m)^\s*SAMPLE_RATE\s+"(\d+)"\s*$', text)
    if len(current) != 1:
        raise Refused(f"{DANTE_INFERNO_CONF}: expected one SAMPLE_RATE line, found {len(current)}")
    rate = int(current[0])
    listed = re.findall(r'(?m)^\s*SUPPORTED_SAMPLE_RATES\s+"([\d, ]+)"\s*$', text)
    supported = [int(r) for r in listed[0].split(",") if r.strip()] if listed else [rate]
    return rate, supported


def with_inferno_rate(text: str, rate: int) -> str:
    """The same config with SAMPLE_RATE changed and nothing else."""
    new, count = re.subn(r'(?m)^(\s*SAMPLE_RATE\s+")\d+("\s*)$', lambda m: f"{m.group(1)}{rate}{m.group(2)}", text)
    if count != 1:
        raise Refused(f"{DANTE_INFERNO_CONF}: expected one SAMPLE_RATE line, found {count}")
    return new


def parse_rate_request(text: str) -> dict:
    """The line the owner or Inferno writes: rate=N source=dante|usb [from=...] [at=unix]."""
    fields = dict(part.split("=", 1) for part in text.split() if "=" in part)
    rate = fields.get("rate", "")
    if not rate.isdigit() or int(rate) not in DANTE_RATES:
        raise Refused(f"rate request: {rate[:12]!r} is not a Dante rate")
    source = fields.get("source", "")
    if source not in RATE_SOURCES:
        raise Refused(f"rate request: source must be one of {', '.join(RATE_SOURCES)}")
    at = fields.get("at", "")
    return {"rate": int(rate), "source": source, "from": fields.get("from", "")[:64],
            "at": float(at) if at.isdigit() else None}


def dante_profile_of(conf: dict[str, str]) -> str:
    preset = conf.get("DSP_PRESET") or ""
    if not preset:
        return DANTE_DIRECT
    return re.sub(r"@\d+$", "", Path(preset).name.removesuffix(".dsp"))


class DanteApplier(Applier):
    ENGINE = "owner"

    def __init__(self, spool: Path = SPOOL_DIR, conf_path: Path = DANTE_CONF_PATH, run_dir: Path = DANTE_RUN_DIR,
                 runner: Runner | None = None, start_timeout: float = DANTE_START_TIMEOUT_S,
                 settle: float = DANTE_SETTLE_S, poll: float = POLL_S) -> None:
        super().__init__(spool=spool, conf_path=conf_path, run_dir=run_dir, runner=runner,
                         start_timeout=start_timeout, settle=settle, poll=poll)

    # ---- reads

    def conf(self) -> dict[str, str]:
        text = read_text(self.conf_path)
        if text is None:
            raise Refused(f"cannot read {self.conf_path}; the Dante service with DSP is not installed")
        return parse_owner_conf(text)

    def live_profile(self) -> str | None:
        try:
            return dante_profile_of(self.conf())
        except Refused:
            return None

    def identity(self) -> dict:
        return {
            "ownerSha256": sha256_of(DANTE_OWNER),
            "startSha256": sha256_of(Path(DANTE_START)),
            "confSha256": sha256_of(self.conf_path),
        }

    def unit_state(self) -> str:
        code, out = self.runner.run(["systemctl", "show", "-p", "ActiveState", "--value", DANTE_UNIT], timeout=10)
        return out.strip() if code == 0 else "unknown"

    def invocation(self) -> str:
        code, out = self.runner.run(["systemctl", "show", "-p", "InvocationID", "--value", DANTE_UNIT], timeout=10)
        return out.strip() if code == 0 else ""

    def owner_log(self, invocation: str) -> list[str]:
        """This start of the owner, from the journal."""
        if not invocation:
            return []
        code, out = self.runner.run(["journalctl", "-u", DANTE_UNIT, "--no-pager", "-o", "cat",
                                     f"_SYSTEMD_INVOCATION_ID={invocation}"], timeout=20)
        return out.splitlines() if code == 0 else []

    def table(self) -> dict[str, dict]:
        """direct, and every installed dante-<slug>.dsp."""
        found = {DANTE_DIRECT: {"name": DANTE_DIRECT, "dspPreset": None, "dspSha256": None, "dspLive": False}}
        try:
            files = sorted(DSP_DIR.glob(f"{DANTE_PREFIX}*.dsp"))
        except OSError:
            files = []
        for path in files:
            slug = path.name[len(DANTE_PREFIX):-len(".dsp")]
            if USER_SLUG.match(slug):
                found[DANTE_PREFIX + slug] = {"name": DANTE_PREFIX + slug, "dspPreset": str(path),
                                             "dspSha256": sha256_of(path), "dspLive": True,
                                             "rates": self.rates_of(DANTE_PREFIX + slug)}
        return found

    # ---- rates (SAMPLE_RATE_DESIGN.md, step 4d)
    #
    # The page compiles a preset at every Dante rate (the Pi has no compiler)
    # and sends them together: the 48 kHz artifact as before, the others as
    # `rateArtifacts` {rate: {file, sha256}}. Each is held to the same guards at
    # its own rate. The endpoint runs the file for owner.conf's RATE; a preset
    # with no file for that rate is refused, never run on another rate's
    # coefficients.

    @staticmethod
    def rates_of(name: str) -> list[int]:
        return [rate for rate in DANTE_RATES if rate_file(name, rate).is_file()]

    @staticmethod
    def at_rate(row: dict, rate: int) -> dict:
        """The row with the artifact for `rate` in place of the 48 kHz one."""
        if not row["dspPreset"] or rate == NOMINAL_RATE:
            return row
        path = rate_file(row["name"], rate)
        if not path.is_file():
            raise Refused(f"{row['name']} has no artifact for {rate} Hz; save the preset again from the page")
        return {**row, "dspPreset": str(path), "dspSha256": sha256_of(path)}

    def read_rate_artifacts(self, request: dict, exclude: int) -> dict[int, dict]:
        extra = request.get("rateArtifacts")
        if extra is None:
            return {}
        if not isinstance(extra, dict) or len(extra) >= len(DANTE_RATES):
            raise Refused("rateArtifacts must map at most five rates to artifacts")
        found: dict[int, dict] = {}
        for key, entry in extra.items():
            if not isinstance(key, str) or not key.isdigit() or int(key) not in DANTE_RATES or int(key) == exclude:
                raise Refused(f"rateArtifacts: {str(key)[:12]} is not a rate this request can carry")
            rate = int(key)
            file_name = entry.get("file") if isinstance(entry, dict) else None
            digest = entry.get("sha256") if isinstance(entry, dict) else None
            if not isinstance(file_name, str) or not RATE_ARTIFACT_FILE.match(file_name) or not file_name.endswith(f"-{rate}.dsp"):
                raise Refused(f"rateArtifacts {rate}: file must be <request id>-{rate}.dsp in the spool's presets directory")
            if not isinstance(digest, str) or not re.match(r"^[0-9a-f]{64}$", digest):
                raise Refused(f"rateArtifacts {rate}: sha256 must be 64 hex characters")
            try:
                data = (self.spool / "presets" / file_name).read_bytes()
            except OSError:
                raise Refused(f"rateArtifacts {rate}: {file_name} is missing from the spool")
            if hashlib.sha256(data).hexdigest() != digest:
                raise Refused(f"rateArtifacts {rate}: the artifact does not hash to its sha256")
            stats = parse_artifact(data.decode("utf-8", errors="replace"), rate)
            found[rate] = {"data": data, "digest": digest, "stats": stats}
        return found

    def check_expected(self, request: dict, live: str) -> None:
        expected = request.get("expectedProfile")
        if expected is not None and expected != live:
            raise Refused(f"the page expected {expected} to be live but {live} is; reload and retry")

    # ---- validation

    def validate(self, request: dict, conf: dict[str, str], reapply: bool = False) -> dict:
        self.validate_envelope(request)
        name = request.get("profile")
        if not isinstance(name, str) or not PROFILE_NAME.match(name):
            raise Refused("profile name must be lower-case letters, digits and dashes")
        table = self.table()
        if name not in table:
            raise Refused(f"{name} is not installed; the Dante service has {', '.join(sorted(table))}")
        rate = running_rate(conf)
        row = self.at_rate(table[name], rate)
        if row["dspPreset"]:
            text = read_text(Path(row["dspPreset"]), MAX_ARTIFACT_BYTES + 1)
            if text is None:
                raise Refused(f"{row['dspPreset']} cannot be read")
            parse_artifact(text, rate)   # an installed file is still held to the guards
        live = dante_profile_of(conf)
        self.check_expected(request, live)
        if name == live and not reapply:
            raise Refused(f"{name} is already the live profile")
        unit = self.unit_state()
        if unit not in ("active", "inactive", "failed"):
            raise Refused(f"{DANTE_UNIT} is {unit}; retry when it has settled")
        return row

    def validate_preset(self, request: dict, conf: dict[str, str]) -> dict:
        name = request.get("name")
        if not isinstance(name, str) or not PRESET_NAME.match(name):
            raise Refused("preset name must be 1-64 letters, digits, spaces, dots or dashes")
        slug = request.get("slug")
        if not isinstance(slug, str) or not USER_SLUG.match(slug) or "--" in slug or slug.endswith("-"):
            raise Refused("preset slug must be 1-24 lower-case letters, digits and single dashes")
        digest = request.get("artifactSha256")
        if not isinstance(digest, str) or not re.match(r"^[0-9a-f]{64}$", digest):
            raise Refused("artifactSha256 must be 64 hex characters")
        file_name = request.get("artifactFile")
        if not isinstance(file_name, str) or not re.match(r"^[a-f0-9]{8,32}\.dsp$", file_name):
            raise Refused("artifactFile must be <request id>.dsp in the spool's presets directory")
        try:
            data = (self.spool / "presets" / file_name).read_bytes()
        except OSError:
            raise Refused(f"artifact {file_name} is missing from the spool")
        if hashlib.sha256(data).hexdigest() != digest:
            raise Refused("artifact hash does not match artifactSha256")
        stats = parse_artifact(data.decode("utf-8", errors="replace"))
        rates = self.read_rate_artifacts(request, NOMINAL_RATE)
        running = running_rate(conf)
        if running != NOMINAL_RATE and running not in rates:
            raise Refused(f"the endpoint runs at {running} Hz and the request carries no artifact for it")
        installed = [n for n in self.table() if n != DANTE_DIRECT]
        replacing = DANTE_PREFIX + slug in installed
        if not replacing and len(installed) >= USER_PROFILE_CAP:
            raise Refused(f"{USER_PROFILE_CAP} presets are installed; remove one first")
        self.check_expected(request, dante_profile_of(conf))
        unit = self.unit_state()
        if unit not in ("active", "inactive", "failed"):
            raise Refused(f"{DANTE_UNIT} is {unit}; retry when it has settled")
        if not Path(OFFLINE_RUNNER).is_file():
            raise Refused(f"{OFFLINE_RUNNER} is not installed; presets cannot be load-checked")
        return {"name": name, "slug": slug, "digest": digest, "data": data, "stats": stats, "replacing": replacing,
                "rates": rates}

    def load_check(self, data: bytes, biquads: int, rate: int = NOMINAL_RATE) -> None:
        # --rate only off 48 kHz: the installed runner may predate the option.
        at = [] if rate == NOMINAL_RATE else ["--rate", str(rate)]
        self.step("checking", f"{OFFLINE_RUNNER} --bench 1 {' '.join(at) + ' ' if at else ''}on the artifact ({biquads} biquads)")
        staged = self.spool / "presets" / f"check-{self.state['id']}.dsp"
        staged.write_bytes(data)
        try:
            code, out = self.runner.run([OFFLINE_RUNNER, str(staged), *at, "--bench", "1"], timeout=60)
        finally:
            staged.unlink(missing_ok=True)
        if code != 0:
            raise Refused(f"the loader refused the artifact: {out[:300]}")
        self.state["loaderLine"] = out.splitlines()[0][:200] if out else ""

    @staticmethod
    def write_root_file(target: Path, data: bytes, suffix: str) -> None:
        temporary = target.with_name(f".{target.name}.{suffix}")
        with open(temporary, "wb") as handle:
            handle.write(data)
            handle.flush()
            os.fsync(handle.fileno())
        os.chmod(temporary, 0o644)
        try:
            os.chown(temporary, 0, 0)
        except PermissionError:
            pass
        os.replace(temporary, target)

    def install_preset(self, spec: dict, conf_text: str = "") -> str:
        rates = spec.get("rates") or {}
        self.load_check(spec["data"], spec["stats"]["biquads"])
        for rate, extra in sorted(rates.items()):
            self.load_check(extra["data"], extra["stats"]["biquads"], rate)
        name = DANTE_PREFIX + spec["slug"]
        target = rate_file(name, NOMINAL_RATE)
        self.step("installing", str(target) + (f" and {', '.join(str(r) for r in sorted(rates))} Hz beside it" if rates else ""))
        DSP_DIR.mkdir(mode=0o755, exist_ok=True)
        # The other rates first and the 48 kHz file, the one the table lists, last.
        # A rate this version does not carry is removed: an older version's file
        # for it would be other coefficients.
        for rate in DANTE_RATES:
            if rate == NOMINAL_RATE:
                continue
            if rate in rates:
                self.write_root_file(rate_file(name, rate), rates[rate]["data"], "tmp")
            else:
                rate_file(name, rate).unlink(missing_ok=True)
        self.write_root_file(target, spec["data"], "tmp")
        return name

    def remove_preset(self, request: dict, conf: dict[str, str], conf_text: str = "") -> str:
        slug = request.get("slug")
        if not isinstance(slug, str) or not USER_SLUG.match(slug):
            raise Refused("slug must name a preset")
        name = DANTE_PREFIX + slug
        if name not in self.table():
            raise Refused(f"{name} is not installed")
        if dante_profile_of(conf) == name:
            raise Refused(f"{name} is the live profile; switch away before removing it")
        self.step("removing", f"{DSP_DIR}/{name}.dsp" + (" and its other rates" if len(self.rates_of(name)) > 1 else ""))
        for rate in DANTE_RATES:
            if rate != NOMINAL_RATE:
                rate_file(name, rate).unlink(missing_ok=True)
        rate_file(name, NOMINAL_RATE).unlink(missing_ok=True)
        return name

    # ---- live coefficient updates (no restart); validate_live and push_live are the bridge's

    def live_target(self, request: dict, conf: dict[str, str]) -> dict:
        live = dante_profile_of(conf)
        self.check_expected(request, live)
        row = self.table().get(live)
        if row is None or not live.startswith(DANTE_PREFIX):
            raise Refused(f"{live} is not an installed preset; there is nothing to update live")
        row = self.at_rate(row, running_rate(conf))
        if conf.get("DSP_LIVE") != "1":
            raise Refused(f"{live} runs without DSP_LIVE=1: the owner is not following a live file; re-apply the preset")
        if row["dspSha256"] != conf.get("DSP_SHA256"):
            raise Refused(f"{row['dspPreset']} does not hash to the pin in {self.conf_path}")
        if self.unit_state() != "active":
            raise Refused(f"{DANTE_UNIT} is {self.unit_state()}; nothing is running to update")
        expected_sha = request.get("expectedLiveSha256")
        if expected_sha is not None:
            current = (self.live_status() or {}).get("sha256", "none")
            if not isinstance(expected_sha, str) or expected_sha != current:
                raise Refused(f"the page expected live coefficients {expected_sha} but the owner reports {current}; reload and retry")
        return row

    def commit_live(self, request: dict, conf: dict[str, str], conf_text: str) -> dict:
        row = self.live_target(request, conf)
        status = self.live_status()
        if not status or status.get("state") != "applied":
            raise Refused(f"nothing applied to commit (owner status: {status.get('state') if status else 'none'})")
        digest = status.get("sha256") or ""
        try:
            data = self.live_file.read_bytes()
        except OSError:
            data = None
        if data is None or hashlib.sha256(data).hexdigest() != digest:
            raise Refused("the live file no longer matches what the owner applied; push it again")
        text = data.decode("utf-8", errors="replace")
        running = running_rate(conf)
        stats = parse_artifact(text, running)
        installed_path = Path(row["dspPreset"])
        if shape_key(read_text(installed_path, MAX_ARTIFACT_BYTES + 1) or "") != shape_key(text):
            raise Refused("the live file's shape differs from the installed preset; it cannot be committed")
        # The live file is at the running rate; the page sends the same draft
        # compiled at the others. A rate it does not send is removed, because
        # its file holds the coefficients from before the edit.
        others = self.read_rate_artifacts(request, running)
        if running != NOMINAL_RATE and NOMINAL_RATE not in others:
            raise Refused(f"a commit at {running} Hz must carry the 48 kHz artifact, the file the preset is listed by")
        for rate, extra in sorted(others.items()):
            self.load_check(extra["data"], extra["stats"]["biquads"], rate)
        stale = [rate for rate in self.rates_of(row["name"]) if rate != running and rate not in others]
        changed = digest != row["dspSha256"]
        if not changed and not others:
            self.step("committing", "the live coefficients already equal the installed file")
            return {"profile": row["name"], "digest": digest, "stats": stats, "changed": False, "rates": [running]}
        for rate, extra in sorted(others.items()):
            self.write_root_file(rate_file(row["name"], rate), extra["data"], "commit")
        if changed:
            for rate in stale:
                rate_file(row["name"], rate).unlink(missing_ok=True)
        self.step("committing", f"{installed_path} <- live {digest[:12]}, pin rewritten, no restart"
                  + (f"; {', '.join(str(r) for r in sorted(others))} Hz written" if others else "")
                  + (f"; {', '.join(str(r) for r in stale)} Hz removed as stale" if changed and stale else ""))
        if changed:
            # File first, then its pin: between the two the wrapper would refuse a
            # start (the file no longer hashes to the old pin), which is the safe
            # side of a crash here. The running owner is not touched by either.
            self.write_root_file(installed_path, data, "commit")
            self.replace_conf(render_owner_conf(conf.get("METERS", "0"), installed_path, digest, conf.get("RATE")))
        return {"profile": row["name"], "digest": digest, "stats": stats, "changed": changed,
                "rates": sorted([running, *others])}

    # ---- the arbiter (SAMPLE_RATE_DESIGN.md, step 4)
    #
    # A rate request comes from Inferno (a set from Dante Controller or Dante
    # Switcher, patches/0005), from the owner (the Mac's USB 16x16 at another
    # rate), or from the page. The Mac decides: a rate the Mac is not at is
    # refused, and a request for the rate already running restarts nothing, so
    # the two signals one change on the Mac sends become one restart. A change
    # is a transaction: owner.conf's RATE, the Inferno config's SAMPLE_RATE and
    # the preset file for the new rate are written together, the endpoint is
    # restarted and must come up at that rate, and anything else puts all of
    # it back.

    def host_rates(self) -> tuple[int, int] | None:
        """The gadget's Capture Rate and Playback Rate (0 while the host has the
        interface down); None when they cannot be read."""
        found = []
        for name in ("Capture Rate", "Playback Rate"):
            code, out = self.runner.run(["amixer", "-c", GADGET_CARD, "cget", f"iface=PCM,name={name}"], timeout=10)
            match = re.search(r": values=(\d+)", out) if code == 0 else None
            if not match:
                return None
            found.append(int(match.group(1)))
        return found[0], found[1]

    def ask_host_to_follow(self, rate: int) -> tuple[bool, str]:
        """Write the gadget's Device Rate Request, so the Mac follows a move made
        on the Dante side. Only after the endpoint runs at `rate`, so the USB half
        never opens at a rate Dante is not running. Without the control (the
        module rolled back) the move stands and the Mac is left to follow by hand;
        the overrode guard covers that case."""
        code, out = self.runner.run(["amixer", "-c", GADGET_CARD, "cset", f"iface=PCM,name={GADGET_RATE_REQUEST}",
                                     str(rate)], timeout=10)
        if code != 0:
            return False, f"could not ask the Mac to follow ({out.strip().splitlines()[-1] if out.strip() else code})"
        return True, f"asked the Mac to follow to {rate} Hz (gadget clock interrupt)"

    def rate_history(self) -> dict:
        try:
            return json.loads((self.spool / "rate-history.json").read_text())
        except (OSError, ValueError):
            return {}

    def mac_followed(self) -> bool:
        """Whether the owner has joined the Mac at the running rate since this
        start: its USBOPEN line with host_rate=match. Every rate change restarts
        the unit, so this start is the one after the last move or a later one."""
        invocation = self.invocation() if self.unit_state() == "active" else ""
        return any(line.startswith("USBOPEN ") and " host_rate=match " in f"{line} " for line in self.owner_log(invocation))

    def validate_rate(self, request: dict, conf: dict[str, str]) -> dict | None:
        """The change to make, or None when the rate asked for is running."""
        rate = request.get("rate")
        if not isinstance(rate, int) or rate not in DANTE_RATES:
            raise Refused(f"rate must be a Dante rate ({', '.join(str(r) for r in DANTE_RATES)})")
        source = request.get("source")
        if source not in RATE_SOURCES:
            raise Refused(f"source must be one of {', '.join(RATE_SOURCES)}")
        running = running_rate(conf)
        inferno_text = read_text(DANTE_INFERNO_CONF)
        if inferno_text is None:
            raise Refused(f"cannot read {DANTE_INFERNO_CONF}")
        inferno_rate, offered = inferno_rates(inferno_text)
        if inferno_rate != running:
            raise Refused(f"owner.conf runs at {running} Hz but {DANTE_INFERNO_CONF} says {inferno_rate}; "
                          "fix the configuration before changing the rate")
        if rate == running:
            return None
        if rate not in offered:
            raise Refused(f"{rate} Hz is not an offered rate (offered: {', '.join(str(r) for r in offered)}); "
                          "a rate is offered only after its battery")
        history = self.rate_history()
        if source == "usb" and history.get("overrode") == rate and not self.mac_followed():
            raise Refused(f"the endpoint moved to {running} Hz on the Dante side over the Mac's {rate} Hz and the Mac "
                          f"has not followed yet; its {rate} Hz is the old rate, not a new choice, so nothing changes")
        if history.get("from") == rate and self.runner.now() - float(history.get("at", 0)) < RATE_REVERSAL_S:
            raise Refused(f"the rate moved {history['from']} -> {history['to']} "
                          f"{self.runner.now() - float(history['at']):.0f} s ago; going straight back looks like a "
                          "tug-of-war between the two ends, so nothing changes")
        # Wait a little for the Mac's USB 16x16 to agree (the other half of one
        # change made on the Mac, or Dante Switcher setting the Mac beside the
        # Dante devices). A change asked from the Mac is refused if the Mac is
        # then at another rate. A change made on the Dante side is taken anyway
        # and the Mac is expected to follow (operator, 2026-10-28); the Mac's
        # rate it overrode is recorded, so the owner asking for it again before
        # the Mac follows is not taken for a new choice (mac_followed).
        overrode = None
        deadline = self.runner.now() + RATE_HOST_WAIT_S
        while True:
            host = self.host_rates()
            if host is None or all(value in (0, rate) for value in host):
                break
            if self.runner.now() >= deadline:
                if source == "usb":
                    raise Refused(f"the Mac's USB 16x16 is at {max(host)} Hz, not the {rate} Hz asked for; "
                                  "the Mac changed again, nothing changes")
                overrode = max(host)
                break
            self.runner.sleep(self.poll)
        live = dante_profile_of(conf)
        row = self.table().get(live)
        if row is None:
            raise Refused(f"{live} is not installed")
        target = {**self.at_rate(row, rate), "rate": rate}
        if target["dspPreset"]:
            parse_artifact(read_text(Path(target["dspPreset"]), MAX_ARTIFACT_BYTES + 1) or "", rate)
        unit = self.unit_state()
        if unit not in ("active", "inactive", "failed"):
            raise Refused(f"{DANTE_UNIT} is {unit}; retry when it has settled")
        return {"rate": rate, "running": running, "source": source, "host": host, "overrode": overrode, "target": target,
                "inferno": with_inferno_rate(inferno_text, rate), "previousInferno": inferno_text}

    def change_rate(self, spec: dict, conf: dict[str, str], previous_text: str) -> dict:
        target = spec["target"]
        rate = spec["rate"]
        self.state["previousProfile"] = target["name"]
        self.state["profile"] = target["name"]
        self.state["rate"] = {"from": spec["running"], "to": rate, "source": spec["source"]}
        self.step("validating", f"{spec['running']} -> {rate} Hz asked by {spec['source']}; "
                                f"{target['name']}{' at ' + Path(target['dspPreset']).name if target['dspPreset'] else ''}; "
                                f"USB host {'unread' if spec['host'] is None else '/'.join(str(v) for v in spec['host'])}")
        new_text = render_owner_conf(conf.get("METERS", "0"),
                                     Path(target["dspPreset"]) if target["dspPreset"] else None, target["dspSha256"],
                                     None if rate == NOMINAL_RATE else str(rate))
        reason = self.switch_to(new_text, target, inferno_text=spec["inferno"])
        if reason is None:
            history = {"from": spec["running"], "to": rate, "at": self.runner.now(), "source": spec["source"]}
            if spec["overrode"] is not None:
                history["overrode"] = spec["overrode"]
            write_atomic(self.spool / "rate-history.json", history)
            host = spec["host"]
            if spec["source"] != "usb" and (host is None or any(value != rate for value in host)):
                asked, detail = self.ask_host_to_follow(rate)
                self.step("host-follow", detail, ok=asked)
            return self.finish("done")
        self.step("rolling-back", f"{reason}; returning to {spec['running']} Hz", ok=False)
        rollback_target = {"name": target["name"], "dspPreset": conf.get("DSP_PRESET") or None, "rate": spec["running"]}
        rollback_reason = self.switch_to(previous_text, rollback_target, inferno_text=spec["previousInferno"])
        if rollback_reason is None:
            return self.finish("rolled-back", reason)
        return self.finish("failed", f"{reason}; rollback to {spec['running']} Hz also failed: {rollback_reason}")

    def consume_rate_request(self) -> dict | None:
        """One trigger of the rate-request path unit: take the line, act on it."""
        try:
            text = DANTE_RATE_REQUEST.read_text()
        except OSError:
            return None
        DANTE_RATE_REQUEST.unlink(missing_ok=True)
        ident = hashlib.sha256(f"{text}{self.runner.now()}".encode()).hexdigest()[:16]
        try:
            fields = parse_rate_request(text)
        except Refused as error:
            self.state = {"version": VERSION, "stack": "dante", "id": ident, "kind": "rate", "request": None,
                          "startedAt": utc(self.runner.now()), "steps": [], "previousProfile": None,
                          "profile": None, "state": "validating", "error": None}
            return self.finish("refused", str(error))
        at = fields["at"] if fields["at"] is not None else self.runner.now()
        return self.apply({"id": ident, "kind": "rate", "rate": fields["rate"], "source": fields["source"],
                           "from": fields["from"], "requestedAt": at, "requestedBy": f"{fields['source']} {fields['from']}".strip()})

    # ---- the configuration file

    def check_conf_text(self, text: str) -> None:
        """usb16x16-dante-start's own parser on a temporary copy, as the
        supervisor's is for the AES67 configuration."""
        temporary = self.conf_path.with_name(f".{self.conf_path.name}.apply-{os.getpid()}")
        temporary.write_text(text, encoding="utf-8")
        try:
            code, out = self.runner.run([DANTE_START, "--print"], timeout=30,
                                        env={"USB16X16_DANTE_CONF": str(temporary)})
        finally:
            temporary.unlink(missing_ok=True)
        if code != 0:
            raise Refused(f"usb16x16-dante-start rejects the configuration: {out[:300]}")

    # ---- the operation

    def switch_to(self, text: str, target: dict, inferno_text: str | None = None) -> str | None:
        """Stop, write owner.conf (and the Inferno config, for a rate change),
        start, verify. Returns None or the reason."""
        self.step("stopping", f"systemctl stop {DANTE_UNIT}")
        code, out = self.runner.run(["systemctl", "stop", DANTE_UNIT], timeout=60)
        if code != 0:
            return f"stop failed: {out}"
        self.step("switching", f"{self.conf_path} -> {target['name']}"
                  + (f" at {target['rate']} Hz, {DANTE_INFERNO_CONF.name} with it" if inferno_text is not None else ""))
        try:
            self.check_conf_text(text)
            if inferno_text is not None:
                inferno_rates(inferno_text)
        except Refused as error:
            return str(error)
        if inferno_text is not None:
            self.write_root_file(DANTE_INFERNO_CONF, inferno_text.encode("utf-8"), "rate")
        self.replace_conf(text)
        self.step("starting", f"systemctl start {DANTE_UNIT}")
        self.runner.run(["systemctl", "reset-failed", DANTE_UNIT], timeout=10)
        code, out = self.runner.run(["systemctl", "start", DANTE_UNIT], timeout=90)
        if code != 0:
            return f"start failed: {out}"
        self.step("verifying", f"waiting up to {self.start_timeout:.0f} s for the owner to start both streams")
        return self.verify(target)

    def check_owner(self, target: dict, invocation: str) -> str | None:
        """None when this start is what the profile calls for; else the reason.
        'not yet' reasons begin with 'waiting'."""
        unit = self.unit_state()
        if unit in ("failed", "inactive"):
            return f"{DANTE_UNIT} is {unit}"
        if self.invocation() != invocation:
            return f"{DANTE_UNIT} restarted by itself"
        log = self.owner_log(invocation)
        fatal = [v for v in log if v.startswith(("FATAL", "NETERROR", "usb16x16-dante-start: REFUSED"))]
        if fatal:
            return fatal[0][:200]
        loaded = [v for v in log if v.startswith("DSP loaded ")]
        preset = target.get("dspPreset")
        if preset and loaded and f"file={preset} " not in loaded[0]:
            return f"the owner loaded another preset: {loaded[0][:120]}"
        if not preset and loaded:
            return "a preset was loaded on a profile without one"
        rate = target.get("rate")
        start = next((v for v in log if v.startswith("START usb16x16-dante-owner ")), "")
        said = re.search(r" rate=(\d+) ", start)
        if rate and start and (int(said.group(1)) if said else NOMINAL_RATE) != rate:
            return f"the owner started at {said.group(1) if said else 'its default 48000'} Hz, not {rate}"
        if not any(v.startswith("NETSTART capture=RUNNING playback=RUNNING") for v in log):
            return "waiting for the owner to start both streams"
        if preset and not loaded:
            return f"the owner's log has no 'DSP loaded file={preset}' line"
        if preset and not any(v.startswith("DSPLIVE following ") for v in log):
            return "the owner is not following a live file"
        return None

    def verify(self, target: dict) -> str | None:
        deadline = self.runner.now() + self.start_timeout
        invocation = ""
        while True:
            invocation = invocation or (self.invocation() if self.unit_state() == "active" else "")
            reason = self.check_owner(target, invocation) if invocation else (
                f"{DANTE_UNIT} is {self.unit_state()}" if self.unit_state() in ("failed", "inactive") else "waiting for the unit")
            if reason is None:
                break
            if not reason.startswith("waiting"):
                return reason
            if self.runner.now() >= deadline:
                return f"not up within {self.start_timeout:.0f} s ({reason})"
            self.runner.sleep(self.poll)
        self.step("settling", f"{self.settle:.0f} s on one start with nothing fatal")
        settle_end = self.runner.now() + self.settle
        while self.runner.now() < settle_end:
            self.runner.sleep(self.poll)
            reason = self.check_owner(target, invocation)
            if reason:
                return reason
        self.state.setdefault("startLines", {})[target["name"]] = [
            v[:400] for v in self.owner_log(invocation) if v.startswith(("START ", "DSP loaded ", "DSPLIVE following ", "METERS publishing ", "NETSTART ", "USBLINK "))][:12]
        return None

    def apply(self, request: dict) -> dict:
        self.spool.mkdir(mode=0o755, exist_ok=True)
        ident = request.get("id") if isinstance(request.get("id"), str) and REQUEST_ID.match(request.get("id", "")) else "invalid"
        kind = request.get("kind") or "profile"
        self.state = {
            "version": VERSION,
            "stack": "dante",
            "id": ident,
            "kind": kind,
            "request": {k: request.get(k) for k in ("kind", "profile", "expectedProfile", "requestedAt", "requestedBy",
                                                     "name", "slug", "artifactSha256", "expectedLiveSha256", "revert", "rate", "source", "from")},
            "startedAt": utc(self.runner.now()),
            "steps": [],
            "previousProfile": None,
            "profile": None,
            "state": "validating",
            "error": None,
        }
        if isinstance(request.get("rateArtifacts"), dict):
            self.state["request"]["rates"] = sorted(str(key)[:6] for key in request["rateArtifacts"])
        try:
            conf = self.conf()
            previous_text = read_text(self.conf_path) or ""
            if kind == "preset":
                self.validate_envelope(request)
                spec = self.validate_preset(request, conf)
                self.step("validating", f"{spec['stats']['biquads']} biquads, internal {spec['stats']['internal']}, "
                                        f"{'replacing' if spec['replacing'] else 'new'} {DANTE_PREFIX}{spec['slug']}")
                name = self.install_preset(spec)
                self.state["stats"] = spec["stats"]
                # Re-applying the live preset's slug is a restart onto the new file.
                target = self.validate({**request, "profile": name}, conf, reapply=True)
            elif kind == "remove":
                self.validate_envelope(request)
                self.state["profile"] = self.remove_preset(request, conf)
                return self.finish("done")
            elif kind == "live":
                self.validate_envelope(request)
                spec = self.validate_live(request, conf)
                self.state["profile"] = spec["profile"]
                self.state["stats"] = spec["stats"]
                self.state["shape"] = spec["shape"]
                self.step("validating", f"{spec['stats']['biquads']} biquads, shape {spec['shape'][:12]} matches {spec['profile']}")
                try:
                    self.push_live(spec)
                except Failed as error:
                    self.state["steps"].append({"name": "verifying", "at": utc(self.runner.now()), "ok": False, "detail": str(error)})
                    return self.finish("failed", str(error))
                return self.finish("done")
            elif kind == "commit":
                self.validate_envelope(request)
                outcome = self.commit_live(request, conf, previous_text)
                self.state["profile"] = outcome["profile"]
                self.state["stats"] = outcome["stats"]
                self.state["committed"] = {"sha256": outcome["digest"], "changed": outcome["changed"]}
                self.state["rates"] = outcome["rates"]
                return self.finish("done")
            elif kind == "shutdown":
                self.validate_envelope(request)
                return self.shutdown(conf)
            elif kind == "rate":
                self.validate_envelope(request)
                spec = self.validate_rate(request, conf)
                if spec is None:
                    self.state["profile"] = dante_profile_of(conf)
                    self.step("validating", f"already at {running_rate(conf)} Hz (asked by {request.get('source')}); nothing restarted")
                    return self.finish("done")
                return self.change_rate(spec, conf, previous_text)
            elif kind == "profile":
                target = self.validate(request, conf)
            else:
                raise Refused(f"unknown request kind {kind!r}")
        except Refused as error:
            self.state["steps"].append({"name": "validating", "at": utc(self.runner.now()), "ok": False, "detail": str(error)})
            return self.finish("refused", str(error))
        previous = dante_profile_of(conf)
        self.state["previousProfile"] = previous
        self.state["profile"] = target["name"]
        self.step("validating", f"{target['name']} is installed; live profile {previous}")
        new_text = render_owner_conf(conf.get("METERS", "0"),
                                     Path(target["dspPreset"]) if target["dspPreset"] else None, target["dspSha256"],
                                     conf.get("RATE"))
        reason = self.switch_to(new_text, target)
        if reason is None:
            return self.finish("done")
        self.step("rolling-back", f"{reason}; returning to {previous}", ok=False)
        rollback_target = {"name": previous, "dspPreset": conf.get("DSP_PRESET") or None}
        rollback_reason = self.switch_to(previous_text, rollback_target)
        if rollback_reason is None:
            return self.finish("rolled-back", reason)
        return self.finish("failed", f"{reason}; rollback to {previous} also failed: {rollback_reason}")

    def shutdown(self, conf: dict[str, str]) -> dict:
        """As the AES67 one: stop the endpoint in order, leave the receipt, power off."""
        self.state["profile"] = dante_profile_of(conf)
        self.step("validating", f"shutdown requested; live profile {self.state['profile']}")
        self.step("stopping", f"systemctl stop {DANTE_UNIT}")
        code, out = self.runner.run(["systemctl", "stop", DANTE_UNIT], timeout=90)
        if code != 0:
            self.state["steps"].append({"name": "stopping", "at": utc(self.runner.now()), "ok": False,
                                        "detail": f"stop exited {code}: {out.strip()[:200]}; powering off regardless"})
        self.step("powering-off", "systemctl poweroff --no-block")
        self.finish("done")
        code, out = self.runner.run(["systemctl", "poweroff", "--no-block"], timeout=30)
        if code != 0:
            self.state["steps"].append({"name": "powering-off", "at": utc(self.runner.now()), "ok": False,
                                        "detail": f"poweroff exited {code}: {out.strip()[:200]}"})
            return self.finish("failed", f"systemctl poweroff exited {code}: {out.strip()[:200]}")
        return self.state


def detect_stack(runner: Runner | None = None) -> str:
    """Which service the requests are for: USB16X16_STACK, else the Dante
    stack when its unit is the one enabled at boot, else AES67."""
    forced = os.environ.get("USB16X16_STACK", "")
    if forced in ("dante", "aes67"):
        return forced
    code, out = (runner or Runner()).run(["systemctl", "is-enabled", DANTE_UNIT], timeout=10)
    return "dante" if code == 0 and out.strip() == "enabled" else "aes67"


# ------------------------------------------------------------------ main

def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description="Apply a profile or preset on request from the web UI, "
                                                 "to whichever of the AES67 and Dante services is the installed one")
    parser.add_argument("--check", action="store_true",
                        help="validate the pending request against the live configuration and exit; no changes")
    parser.add_argument("--spool", default=str(SPOOL_DIR))
    parser.add_argument("--rate-request", action="store_true",
                        help=f"act on {DANTE_RATE_REQUEST} (the owner's or Inferno's rate request) instead of the spool")
    arguments = parser.parse_args(argv)
    stack = detect_stack()
    applier = (DanteApplier if stack == "dante" else Applier)(spool=Path(arguments.spool))
    if arguments.check:
        try:
            request = applier.load_request()
            target = applier.validate(request, applier.conf())
        except Refused as error:
            print(f"refused: {error}")
            return 1
        print(f"ok ({stack}): would switch {applier.live_profile()} -> {target['name']} "
              f"(preset {target['dspPreset'] or 'none'})")
        return 0
    if os.geteuid() != 0:
        print("run as root (the path unit does)", file=sys.stderr)
        return 2
    # One operation at a time, whichever unit started this: the page's spool and
    # the rate request both restart the endpoint, and must not do it at once.
    import fcntl
    Path(arguments.spool).mkdir(mode=0o755, exist_ok=True)
    lock = open(Path(arguments.spool) / "apply.lock", "w")
    fcntl.flock(lock, fcntl.LOCK_EX)
    if arguments.rate_request:
        if stack != "dante":
            print("rate requests are the Dante stack's", file=sys.stderr)
            return 2
        result = applier.consume_rate_request()
        print("no rate request pending" if result is None else
              f"{result['id']}: {result['state']}{' — ' + result['error'] if result.get('error') else ''}")
        return 0
    # Drain: live updates arrive about one a second, and a fresh process per
    # request is what tripped systemd's start burst limit on 2026-09-13. One
    # invocation takes every request that lands while it runs, bounded.
    handled = 0
    while handled < 100:
        result = applier.consume()
        if result is None:
            break
        handled += 1
        print(f"{result['id']}: {result['state']}"
              f"{' — ' + result['error'] if result.get('error') else ''}")
        if result["kind"] not in ("live", "commit"):
            break   # a restart operation is one per invocation, as before
    if handled == 0:
        print("no request pending")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
