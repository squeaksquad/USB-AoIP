+/*
+ * Store the rate the host set (SET_CUR on the clock) and remember that it set
+ * one on this connection, so the Rate control reports it while the stream is
+ * idle too. u_audio_forget_srate() ends that at a disconnect or bus reset.
+ */
+static void set_srate(struct uac_rtd_params *prm, int srate)
+{
+	unsigned long flags;
+	bool changed;
+
+	spin_lock_irqsave(&prm->lock, flags);
+	changed = !prm->srate_set || prm->srate != srate;
+	prm->srate = srate;
+	prm->srate_set = true;
+	if (changed && !prm->active)
+		snd_ctl_notify(prm->uac->card, SNDRV_CTL_EVENT_MASK_VALUE,
+				&prm->snd_kctl_rate_id);
+	spin_unlock_irqrestore(&prm->lock, flags);
+}
