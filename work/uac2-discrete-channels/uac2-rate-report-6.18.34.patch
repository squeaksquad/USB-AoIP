+static void forget_srate(struct uac_rtd_params *prm)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&prm->lock, flags);
+	if (prm->srate_set) {
+		prm->srate_set = false;
+		if (!prm->active)
+			snd_ctl_notify(prm->uac->card, SNDRV_CTL_EVENT_MASK_VALUE,
+					&prm->snd_kctl_rate_id);
+	}
+	spin_unlock_irqrestore(&prm->lock, flags);
+}
+
+/* The host is gone (disconnect, bus reset, new configuration): its rate is no longer known. */
+void u_audio_forget_srate(struct g_audio *audio_dev)
+{
+	struct uac_params *params = &audio_dev->params;
+	struct snd_uac_chip *uac = audio_dev->uac;
+
+	if (params->c_chmask)
+		forget_srate(&uac->c_prm);
+	if (params->p_chmask)
+		forget_srate(&uac->p_prm);
+}
+EXPORT_SYMBOL_GPL(u_audio_forget_srate);
