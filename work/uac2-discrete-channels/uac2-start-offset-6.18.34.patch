+/*
+ * Playback Start Offset, five integers: generation (changes at each playback
+ * trigger and each alt 1 on either streaming interface), IN offset at start and
+ * now (IN frames the host received before a ring packet, minus that packet's
+ * first ring frame; INT_MIN until a ring packet has reached the host), OUT
+ * packets missed before the first good one, IN packets failed while carrying
+ * ring data.
+ */
+static int u_audio_start_offset_info(struct snd_kcontrol *kcontrol,
+				     struct snd_ctl_elem_info *uinfo)
+{
+	uinfo->type = SNDRV_CTL_ELEM_TYPE_INTEGER;
+	uinfo->count = 5;
+	uinfo->value.integer.min = INT_MIN;
+	uinfo->value.integer.max = INT_MAX;
+	return 0;
 }
 
+static int u_audio_start_offset_get(struct snd_kcontrol *kcontrol,
+				    struct snd_ctl_elem_value *ucontrol)
+{
+	struct snd_uac_chip *uac = snd_kcontrol_chip(kcontrol);
+	long *v = ucontrol->value.integer.value;
+	unsigned long flags;
+
+	spin_lock_irqsave(&uac->so_lock, flags);
+	v[0] = uac->so_generation & INT_MAX;
+	v[1] = uac->so_in_start;
+	v[2] = uac->so_in_now;
+	v[3] = uac->so_out_missed;
+	v[4] = uac->so_in_failed;
+	spin_unlock_irqrestore(&uac->so_lock, flags);
+	return 0;
+}
