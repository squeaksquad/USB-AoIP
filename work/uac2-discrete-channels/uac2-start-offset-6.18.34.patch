+/*
+ * Playback Start Offset bookkeeping. A request's index is its buffer's slot in
+ * rbuf (u_audio_start_playback places them ep->maxpacket apart).
+ */
+static int so_req_index(struct snd_uac_chip *uac, struct usb_ep *ep,
+			struct usb_request *req)
+{
+	unsigned int i;
+
+	if (!uac->so_req_ring || !ep->maxpacket)
+		return -1;
+	i = ((u8 *)req->buf - (u8 *)uac->p_prm.rbuf) / ep->maxpacket;
+	return i < uac->audio_dev->params.req_number ? i : -1;
+}
+
+/* under so_lock: a new playback ring (trigger) or a new host stream (alt 1) */
+static void so_in_reset(struct snd_uac_chip *uac, bool host_start)
+{
+	int i;
+
+	if (uac->so_req_ring)
+		for (i = 0; i < uac->audio_dev->params.req_number; i++)
+			uac->so_req_ring[i] = -1;
+	if (host_start)
+		uac->so_in_sent = 0;
+	uac->so_ring = 0;
+	uac->so_in_start = START_OFFSET_NONE;
+	uac->so_in_now = START_OFFSET_NONE;
+	uac->so_in_failed = 0;
+	uac->so_generation++;
+}
+
+/* an IN request completed: what it carried reached the host, or not */
+static void so_in_done(struct snd_uac_chip *uac, struct usb_ep *ep,
+		       struct usb_request *req, int status)
+{
+	int i = so_req_index(uac, ep, req);
+	unsigned long flags;
+	long long ring, offset;
+
+	if (i < 0 || !uac->p_framesize)
+		return;
+	spin_lock_irqsave(&uac->so_lock, flags);
+	ring = uac->so_req_ring[i];
+	if (status) {
+		if (ring >= 0)
+			uac->so_in_failed++;
+	} else {
+		if (ring >= 0) {
+			offset = clamp_t(long long, uac->so_in_sent - ring,
+					 INT_MIN + 1, INT_MAX);
+			uac->so_in_now = offset;
+			if (uac->so_in_start == START_OFFSET_NONE)
+				uac->so_in_start = offset;
+		}
+		uac->so_in_sent += req->actual / uac->p_framesize;
+	}
+	uac->so_req_ring[i] = -1;
+	spin_unlock_irqrestore(&uac->so_lock, flags);
+}
+
+/* an IN request is queued again: with `frames` ring frames, or none (0) */
+static void so_in_fill(struct snd_uac_chip *uac, struct usb_ep *ep,
+		       struct usb_request *req, unsigned int frames)
+{
+	int i = so_req_index(uac, ep, req);
+	unsigned long flags;
+
+	if (i < 0)
+		return;
+	spin_lock_irqsave(&uac->so_lock, flags);
+	if (frames) {
+		uac->so_req_ring[i] = uac->so_ring;
+		uac->so_ring += frames;
+	} else {
+		uac->so_req_ring[i] = -1;
+	}
+	spin_unlock_irqrestore(&uac->so_lock, flags);
+}
+
+static void so_out_done(struct snd_uac_chip *uac, int status)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&uac->so_lock, flags);
+	if (!uac->so_out_good) {
+		if (status)
+			uac->so_out_missed++;
+		else
+			uac->so_out_good = true;
+	}
+	spin_unlock_irqrestore(&uac->so_lock, flags);
 }
 
