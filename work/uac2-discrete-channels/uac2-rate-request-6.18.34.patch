+
+/*
+ * Device Rate Request: the device's clock moves to a listed rate, as an
+ * interface following external clock does (the Mac follows: RATE_REPORT_PLAN.md,
+ * "Mac-follow experiment"). srate takes the new rate in each direction, so the host's next
+ * GET_CUR on the clock reads it, and the clock source's SAM_FREQ interrupt goes
+ * to the host. Writing the same rate again resends the interrupt.
+ */
+static bool rate_listed(const int *srates, int srate)
+{
+	int i;
+
+	for (i = 0; i < UAC_MAX_RATES && srates[i]; i++)
+		if (srates[i] == srate)
+			return true;
+	return false;
+}
+
+static int u_audio_rate_req_info(struct snd_kcontrol *kcontrol,
+				struct snd_ctl_elem_info *uinfo)
+{
+	struct snd_uac_chip *uac = snd_kcontrol_chip(kcontrol);
+	struct uac_params *params = &uac->audio_dev->params;
+	const int *srates = params->p_chmask ? params->p_srates : params->c_srates;
+
+	uinfo->type = SNDRV_CTL_ELEM_TYPE_INTEGER;
+	uinfo->count = 1;
+	uinfo->value.integer.min = 0;
+	uinfo->value.integer.max = get_max_srate(srates);
 	return 0;
+}
+
+static int u_audio_rate_req_get(struct snd_kcontrol *kcontrol,
+				struct snd_ctl_elem_value *ucontrol)
+{
+	struct snd_uac_chip *uac = snd_kcontrol_chip(kcontrol);
+
+	ucontrol->value.integer.value[0] = READ_ONCE(uac->rate_request);
+	return 0;
+}
+
+static void request_srate(struct uac_rtd_params *prm, int srate)
+{
+	unsigned long flags;
+	bool reported;
+	int old;
+
+	spin_lock_irqsave(&prm->lock, flags);
+	old = prm->srate;
+	prm->srate = srate;
+	reported = prm->active || prm->srate_set;
+	if (reported && old != srate)
+		snd_ctl_notify(prm->uac->card, SNDRV_CTL_EVENT_MASK_VALUE,
+				&prm->snd_kctl_rate_id);
+	spin_unlock_irqrestore(&prm->lock, flags);
 }
 
+static int u_audio_rate_req_put(struct snd_kcontrol *kcontrol,
+				struct snd_ctl_elem_value *ucontrol)
+{
+	struct snd_uac_chip *uac = snd_kcontrol_chip(kcontrol);
+	struct g_audio *audio_dev = uac->audio_dev;
+	struct uac_params *params = &audio_dev->params;
+	int srate = ucontrol->value.integer.value[0];
+	int ret;
+
+	if ((params->p_chmask && !rate_listed(params->p_srates, srate)) ||
+	    (params->c_chmask && !rate_listed(params->c_srates, srate)))
+		return -EINVAL;
+
+	WRITE_ONCE(uac->rate_request, srate);
+	if (params->p_chmask)
+		request_srate(&uac->p_prm, srate);
+	if (params->c_chmask)
+		request_srate(&uac->c_prm, srate);
+
+	ret = audio_dev->notify(audio_dev, params->clk_id,
+				UAC2_CS_CONTROL_SAM_FREQ);
+	dev_dbg(&audio_dev->gadget->dev, "%s: srate %d, clock %d interrupt: %d\n",
+		__func__, srate, params->clk_id, ret);
+	return 1;
+}
